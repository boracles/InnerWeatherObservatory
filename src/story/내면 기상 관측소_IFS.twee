<<link "두렵다">><<set $roomAttitudes[$currentRoom] = "두렵다">><<run setup.afterAttitude()>><</link>>
<<link "답답하거나 짜증이 난다">><<set $roomAttitudes[$currentRoom] = "답답하거나 짜증이 난다">><<run setup.afterAttitude()>><</link>>

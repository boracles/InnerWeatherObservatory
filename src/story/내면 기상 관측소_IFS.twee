[[내가 쓸모없어진 것처럼 느껴질 것 같다->마음의 시야][$movementPressureReason = "내가 쓸모없어진 것처럼 느껴질 것 같다"]]
[[이유는 모르지만 멈추기가 어렵다->마음의 시야][$movementPressureReason = "이유는 모르지만 멈추기가 어렵다"]]

:: 파도 진입 {"position":"1880,520","size":"170,120"}
<<run setup.enterRoom("wave")>>
<<set $roomPresence.wave = "느껴짐">>
<<set $waveDepth = 0>>
<<set $roomProtections.wave = "멈추기 어렵게 만드는 힘이 무엇으로부터 나를 지켜왔는지 살펴보는 중">>
<div class="wave-surface-return">[[수면으로 오르기->관측소 허브]]</div>
<div class="wave-descent">
<div class="wave-empty-water">
<p class="wave-depth-cue">한 방향으로 이어지는 물살을 천천히 느껴봅니다.</p>
</div>
<div class="wave-question-zone room-input-stage">
<h1>멈추지 못하는 물살</h1>
<p>물살은 한 방향으로 계속 나를 밀어갑니다.<br>
내가 가고 싶어서 움직이는 것인지,<br>
멈추면 안 될 것 같아서 움직이는 것인지 아직 분명하지 않습니다.</p>
<h2>지금 나를 움직이게 하는 것은 내가 원하는 마음에 더 가까운가요,<br>
아니면 멈추면 안 될 것 같은 압박에 더 가까운가요?</h2>
<div class="choices">
<<link "내가 정말 원하는 방향으로 가고 있다">><<set $waveDrive = "desire">><<set $waveAction = "내가 정말 원하는 방향으로 가고 있다">><<set $roomBehaviors.wave = $waveAction>><<run setup.afterWaveDrive()>><</link>>
<<link "원해서 시작했지만 지금은 멈추기 어렵다">><<set $waveDrive = "mixed">><<set $waveAction = "원해서 시작했지만 지금은 멈추기 어렵다">><<set $roomBehaviors.wave = $waveAction>><<run setup.afterWaveDrive()>><</link>>
<<link "원하는 것보다 해야만 한다는 느낌이 크다">><<set $waveDrive = "pressure">><<set $waveAction = "원하는 것보다 해야만 한다는 느낌이 크다">><<set $roomBehaviors.wave = $waveAction>><<run setup.afterWaveDrive()>><</link>>
<<link "멈추면 뒤처지거나 무너질 것 같아 불안하다">><<set $waveDrive = "pressure">><<set $waveAction = "멈추면 뒤처지거나 무너질 것 같아 불안하다">><<set $roomBehaviors.wave = $waveAction>><<run setup.afterWaveDrive()>><</link>>
<<link "무언가에 쫓기듯 계속 움직여야 할 것 같다">><<set $waveDrive = "chased">><<set $waveAction = "무언가에 쫓기듯 계속 움직여야 할 것 같다">><<set $roomBehaviors.wave = $waveAction>><<run setup.afterWaveDrive()>><</link>>
<<link "내가 무엇을 원하는지 잘 모르겠다">><<set $waveDrive = "unclear">><<set $waveAction = "내가 무엇을 원하는지 잘 모르겠다">><<set $roomBehaviors.wave = "아직 알 수 없음">><<run setup.afterWaveDrive()>><</link>>
</div>
<div class="room-input-aux">
<<button "내 말로 직접 적기">><<set $waveDrive = "unclear">><<run setup.openRoomInput("wave","driveWords","지금 나를 움직이게 하는 힘을 내 말로 적어주세요.",{stateVariable:"waveAction",groupVariable:"roomBehaviors",appendOwnWords:true,nextPassage:"파도 구별하기"})>><</button>>
</div>
</div>
</div>
<div class="custom-input-host"></div>
<<run setTimeout(function(){ setup.syncWaveAbyssState(); },900)>>


:: 파도 원하는 힘 {"position":"2110,360","size":"190,120"}
<div class="wave-surface-return">[[수면으로 오르기->관측소 허브]]</div>
<div class="wave-descent wave-descent--continuation">
<div class="wave-empty-water"></div>
<div class="wave-question-zone room-input-stage">
<h1>원하는 마음과 밀어붙이는 힘</h1>
<h2>내가 원하는 마음과 나를 몰아붙이는 힘은 어떻게 다르게 느껴지나요?</h2>
<div class="choices">
[[원하는 마음에는 기쁨이나 기대가 있다->파도 보호 의도][$waveConcern = "원하는 마음에는 기쁨이나 기대가 있다"; $waveStopFear = "unknown"; $roomWorries.wave = $waveConcern]]
[[원하는 일이지만 너무 빠르게 가고 있다->파도 보호 의도][$waveConcern = "원하는 일이지만 너무 빠르게 가고 있다"; $waveStopFear = "stillness"; $roomWorries.wave = $waveConcern]]
[[결과를 내야 한다는 압박이 함께 있다->파도 보호 의도][$waveConcern = "결과를 내야 한다는 압박이 함께 있다"; $waveStopFear = "failure"; $roomWorries.wave = $waveConcern]]
[[아직 둘을 구별하기 어렵다->파도 보호 의도][$waveConcern = "아직 둘을 구별하기 어렵다"; $waveStopFear = "unknown"; $roomWorries.wave = "아직 알 수 없음"]]
</div>
<div class="room-input-aux">
<<button "내 말로 직접 적기">><<set $waveStopFear = "unknown">><<run setup.openRoomInput("wave","desireDifferenceWords","원하는 마음과 나를 몰아붙이는 힘이 어떻게 다르게 느껴지는지 적어주세요.",{stateVariable:"waveConcern",groupVariable:"roomWorries",appendOwnWords:true,nextPassage:"파도 보호 의도"})>><</button>>
</div>
</div>
</div>
<div class="custom-input-host"></div>


:: 파도 멈춤의 불안 {"position":"2110,520","size":"190,120"}
<div class="wave-surface-return">[[수면으로 오르기->관측소 허브]]</div>
<div class="wave-descent wave-descent--continuation">
<div class="wave-empty-water"></div>
<div class="wave-question-zone room-input-stage">
<h1>멈춘다고 생각해보기</h1>
<h2>이 움직임을 잠시 멈춘다면 어떤 일이 생길 것 같나요?</h2>
<div class="choices">
[[다른 사람보다 뒤처질 것 같다->파도 보호 의도][$waveConcern = "다른 사람보다 뒤처질 것 같다"; $waveStopFear = "fallingBehind"; $roomWorries.wave = $waveConcern]]
[[중요한 기회나 일을 놓칠 것 같다->파도 보호 의도][$waveConcern = "중요한 기회나 일을 놓칠 것 같다"; $waveStopFear = "missingOut"; $roomWorries.wave = $waveConcern]]
[[제대로 해내지 못한 사람이 될 것 같다->파도 보호 의도][$waveConcern = "제대로 해내지 못한 사람이 될 것 같다"; $waveStopFear = "failure"; $roomWorries.wave = $waveConcern]]
[[누군가를 실망시키거나 비난받을 것 같다->파도 보호 의도][$waveConcern = "누군가를 실망시키거나 비난받을 것 같다"; $waveStopFear = "disappointingOthers"; $roomWorries.wave = $waveConcern]]
[[가만히 있을 때 올라오는 감정을 감당하기 어려울 것 같다->파도 보호 의도][$waveConcern = "가만히 있을 때 올라오는 감정을 감당하기 어려울 것 같다"; $waveStopFear = "overwhelm"; $roomWorries.wave = $waveConcern]]
[[이유는 모르지만 멈추는 것 자체가 불안하다->파도 보호 의도][$waveConcern = "이유는 모르지만 멈추는 것 자체가 불안하다"; $waveStopFear = "stillness"; $roomWorries.wave = $waveConcern]]
</div>
<div class="room-input-aux">
<<button "내 말로 직접 적기">><<set $waveStopFear = "unknown">><<run setup.openRoomInput("wave","stopFearWords","잠시 멈춘다면 어떤 일이 생길 것 같은지 적어주세요.",{stateVariable:"waveConcern",groupVariable:"roomWorries",appendOwnWords:true,nextPassage:"파도 보호 의도"})>><</button>>
</div>
</div>
</div>
<div class="custom-input-host"></div>


:: 파도 구별하기 {"position":"2110,680","size":"190,120"}
<div class="wave-surface-return">[[수면으로 오르기->관측소 허브]]</div>
<div class="wave-descent wave-descent--continuation">
<div class="wave-empty-water"></div>
<div class="wave-question-zone room-input-stage">
<h1>아직 구별되지 않는 방향</h1>
<h2>지금은 답을 찾는 것보다 무엇부터 구별해보고 싶나요?</h2>
<div class="choices">
[[내가 하고 싶은 것->파도 보호 의도][$waveConcern = "내가 하고 싶은 것"; $waveStopFear = "unknown"; $roomWorries.wave = $waveConcern]]
[[내가 해야 한다고 느끼는 것->파도 보호 의도][$waveConcern = "내가 해야 한다고 느끼는 것"; $waveStopFear = "failure"; $roomWorries.wave = $waveConcern]]
[[다른 사람이 기대하는 것->파도 보호 의도][$waveConcern = "다른 사람이 기대하는 것"; $waveStopFear = "disappointingOthers"; $roomWorries.wave = $waveConcern]]
[[멈추었을 때 생기는 불안->파도 보호 의도][$waveConcern = "멈추었을 때 생기는 불안"; $waveStopFear = "stillness"; $roomWorries.wave = $waveConcern]]
[[지금은 구별하지 않고 조금 더 머물고 싶다->파도 보호 의도][$waveConcern = "지금은 구별하지 않고 조금 더 머물고 싶다"; $waveStopFear = "unknown"; $roomWorries.wave = "아직 알 수 없음"]]
</div>
<div class="room-input-aux">
<<button "내 말로 직접 적기">><<set $waveStopFear = "unknown">><<run setup.openRoomInput("wave","distinguishWords","지금 무엇부터 구별해보고 싶은지 적어주세요.",{stateVariable:"waveConcern",groupVariable:"roomWorries",appendOwnWords:true,nextPassage:"파도 보호 의도"})>><</button>>
</div>
</div>
</div>
<div class="custom-input-host"></div>


:: 파도 보호 의도 {"position":"2380,520","size":"190,120"}
<div class="wave-surface-return">[[수면으로 오르기->관측소 허브]]</div>
<div class="wave-descent wave-descent--continuation">
<div class="wave-empty-water"></div>
<div class="wave-question-zone room-input-stage">
<h1>계속 움직이게 하는 힘</h1>
<p>이 힘을 문제나 게으름의 반대로 판단하지 않고,<br>
어떤 상황에서 나를 지키는 역할을 해왔는지 살펴봅니다.</p>
<h2>계속 움직이게 하는 이 힘은 나에게 어떤 일이 생기지 않도록 막고 있을까요?</h2>
<div class="choices">
[[실패했다고 느끼는 것->파도 머무는 위치][$waveProtection = "실패했다고 느끼지 않도록 막는 것"; $roomProtections.wave = $waveProtection]]
[[뒤처지거나 쓸모없다고 느끼는 것->파도 머무는 위치][$waveProtection = "뒤처지거나 쓸모없다고 느끼지 않도록 막는 것"; $roomProtections.wave = $waveProtection]]
[[누군가에게 실망을 주는 것->파도 머무는 위치][$waveProtection = "누군가에게 실망을 주지 않도록 막는 것"; $roomProtections.wave = $waveProtection]]
[[감정이 한꺼번에 밀려오는 것->파도 머무는 위치][$waveProtection = "감정이 한꺼번에 밀려오지 않도록 막는 것"; $roomProtections.wave = $waveProtection]]
[[아무것도 하지 않는 나를 마주하는 것->파도 머무는 위치][$waveProtection = "아무것도 하지 않는 나를 마주하지 않도록 막는 것"; $roomProtections.wave = $waveProtection]]
[[아직 무엇을 막는지 모르겠다->파도 머무는 위치][$waveProtection = "아직 무엇을 막는지 알 수 없음"; $roomProtections.wave = $waveProtection]]
</div>
<div class="room-input-aux">
<<button "내 말로 직접 적기">><<run setup.openRoomInput("wave","protectionWords","계속 움직이게 하는 힘이 무엇을 막으려는 것 같은지 적어주세요.",{stateVariable:"waveProtection",groupVariable:"roomProtections",appendOwnWords:true,rememberIntent:true,nextPassage:"파도 머무는 위치"})>><</button>>
</div>
</div>
</div>
<div class="custom-input-host"></div>
<<run setTimeout(function(){ setup.syncWaveAbyssState(); },0)>>



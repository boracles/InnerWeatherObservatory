:: StoryTitle
내면 기상 관측소


:: StoryData
{
	"ifid": "9340BE1D-61C1-497C-941B-7134137D947A",
	"format": "SugarCube",
	"format-version": "2.30.0",
	"start": "첫 진입",
	"zoom": 1
}


:: Story Stylesheet [stylesheet]
:root {
	--ui-surface: rgba(22, 17, 13, .92);
	--ui-surface-hover: rgba(43, 32, 23, .94);
	--ui-text: #f2eadc;
	--ui-muted: #b8ab98;
	--ui-accent: #c69248;
	--ui-border: rgba(198, 146, 72, .48);
	--night: #120d09;
	--panel: var(--ui-surface);
	--panel2: rgba(34, 25, 18, .9);
	--grid: rgba(198, 146, 72, .16);
	--line: var(--ui-border);
	--text: var(--ui-text);
	--muted: var(--ui-muted);
	--signal: var(--ui-accent);
	--signal-soft: #e2c79e;
	--signal-wash: rgba(94, 63, 35, .68);
	--amber: #e6bb72;
	--alert: #e58d84;
}
*,
*::before,
*::after {
	box-sizing: border-box;
}
html, body {
	width: 100%;
	max-width: 100%;
	background-color: var(--night);
	color: var(--text);
	font-family: "Pretendard", "Apple SD Gothic Neo", sans-serif;
	margin: 0;
	overflow-x: hidden;
}
.story-ui,
.room-ui,
.hub-ui {
	width: 100%;
	max-width: 100%;
	overflow-x: hidden;
}
.story-ui,
.room-ui,
.hub-ui,
.room-label,
.story-question,
.story-description,
.story-choice,
.discovery-entry #passages,
.observation-ui #passages,
.station-hub #passages,
button {
	-webkit-user-select: none;
	user-select: none;
	-webkit-touch-callout: none;
}
.story-ui *,
.room-ui *,
.hub-ui *,
.discovery-entry #passages *,
.observation-ui #passages *,
.station-hub #passages * {
	-webkit-user-select: none;
	user-select: none;
}
button,
.room-label,
canvas,
img {
	-webkit-user-drag: none;
	user-drag: none;
}
input,
textarea,
[contenteditable="true"] {
	-webkit-user-select: text !important;
	user-select: text !important;
	pointer-events: auto;
}
body::before { content: none; }
#station-backdrop {
	position: fixed; inset: 0; z-index: 0; overflow: hidden;
	background: radial-gradient(circle at 35% 42%, #32251c 0, #120e0b 48%, #050505 100%);
}
#station-backdrop canvas { display: block; width: 100%; height: 100%; }
#station-backdrop iframe {
	display: block; width: 100%; height: 100%; border: 0;
	background: #1b1815;
}
#station-backdrop::after { content: none; }
#passages {
	position: fixed; z-index: 3; left: 0; right: 0; bottom: 0;
	width: 100%; max-width: none; max-height: 58vh; margin: 0; padding: 110px 5vw 36px;
	box-sizing: border-box;
	overflow-y: auto; pointer-events: none;
	background: linear-gradient(to bottom,
		rgba(12,9,7,0) 0%,
		rgba(12,9,7,.5) 38%,
		rgba(12,9,7,.94) 100%);
	border: 0; border-radius: 0; box-shadow: none;
	line-height: 1.65; animation: signal-in .35s ease both; backdrop-filter: none;
}
#passages .passage {
	width: min(92vw, 1400px); margin: 0 auto;
	text-align: center; pointer-events: auto;
}
.station-hub #passages .passage { pointer-events: none; }
.station-hub #passages a,
.station-hub #passages button { pointer-events: auto; }
.observation-ui #passages h1 {
	margin: .25rem 0 .6rem; color: #f0e8d9;
	font-size: clamp(1.25rem, 2.1vw, 1.8rem);
}
.observation-ui #passages h2 {
	margin: .85rem 0 .25rem; color: #f0e8d9;
	font-size: clamp(1rem, 1.7vw, 1.3rem);
}
.observation-ui #passages p { margin: .35rem auto; max-width: 920px; }
.observation-ui #passages .code { display: block; margin-bottom: .25rem; }
.observation-ui #passages .transmission,
.observation-ui #passages .forecast,
.observation-ui #passages .permission-guide,
.observation-ui #passages .permission-result {
	width: min(920px, 100%); margin: .65rem auto; padding: .75rem 1rem;
}
.observation-ui #passages .report {
	width: min(920px, 100%); margin: .7rem auto; padding: .8rem 1rem;
}
.fog-room-screen #passages {
	top: auto;
	bottom: 0;
	height: auto;
	max-height: 58vh;
	max-height: 58dvh;
	padding: 68px clamp(20px, 4vw, 56px) max(24px, env(safe-area-inset-bottom));
	overflow-y: auto;
	transition: opacity .32s ease;
	background: linear-gradient(
		to bottom,
		rgba(17,13,10,0) 0%,
		rgba(17,13,10,.34) 24%,
		rgba(17,13,10,.88) 100%
	);
}
.fog-room-screen #passages .passage {
	width: min(980px, 100%);
	margin: 0 auto;
}
.fog-room-screen #passages > .passage > br,
.fog-room-screen #passages .room-input-stage > br,
.fog-room-screen #passages .room-ui > br {
	display: none;
}
.fog-room-screen #passages h1 {
	margin: 0 0 10px;
	font-size: clamp(1.12rem, 2vw, 1.55rem);
}
.fog-room-screen #passages h2 {
	margin: 18px 0 18px;
	font-size: clamp(1rem, 1.7vw, 1.3rem);
}
.fog-room-screen #passages p {
	margin: 0 auto 14px;
	color: var(--ui-muted);
	line-height: 1.75;
}
.fog-room-screen #passages .choices,
.fog-room-screen #passages .choice-list,
.fog-name-suggestions {
	display: grid !important;
	grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
	gap: 11px !important;
	width: min(860px, 100%) !important;
	margin: 0 auto !important;
	overflow: visible !important;
	transform: none !important;
}
.fog-room-screen #passages .choices > br,
.fog-room-screen #passages .choice-list > br {
	display: none !important;
}
.fog-room-screen #passages .choices > a,
.fog-room-screen #passages .choices > button,
.fog-room-screen #passages .choice-list > a,
.fog-room-screen #passages .choice-list > button,
.fog-name-suggestion {
	width: 100% !important;
	min-width: 0 !important;
	max-width: none !important;
	min-height: 58px;
	padding: 13px 16px !important;
	box-sizing: border-box;
	white-space: normal !important;
	word-break: keep-all;
	overflow-wrap: break-word;
}
.fog-room-screen #passages .choices > a,
.fog-room-screen #passages .choices > button,
.fog-room-screen #passages .choice-list > a,
.fog-room-screen #passages .choice-list > button {
	color: var(--ui-text) !important;
	background: var(--ui-surface) !important;
	border-color: var(--ui-border) !important;
	box-shadow: 0 10px 28px rgba(0,0,0,.24) !important;
}
.fog-room-screen #passages .choices > a:hover,
.fog-room-screen #passages .choices > a:focus-visible,
.fog-room-screen #passages .choices > button:hover,
.fog-room-screen #passages .choices > button:focus-visible,
.fog-room-screen #passages .choice-list > a:hover,
.fog-room-screen #passages .choice-list > a:focus-visible,
.fog-room-screen #passages .choice-list > button:hover,
.fog-room-screen #passages .choice-list > button:focus-visible {
	background: var(--ui-surface-hover) !important;
	border-color: var(--ui-accent) !important;
}
.fog-room-screen .room-input-aux {
	margin-top: 12px;
}
.fog-room-screen.fog-motion-active #passages {
	opacity: 0;
	pointer-events: none;
}
.fog-name-guide {
	width: min(720px, 100%);
	margin: 0 auto 18px !important;
}
.fog-name-suggestion {
	display: grid;
	grid-template-columns: 1fr auto;
	align-items: center;
	gap: 10px;
	color: var(--ui-text);
	background: rgba(22,17,13,.78);
	border: 1px solid var(--ui-border);
	border-radius: 10px;
	font: inherit;
	cursor: pointer;
}
.fog-name-suggestion__choose,
.fog-name-suggestion__edit {
	border: 0;
	background: transparent;
	color: inherit;
	font: inherit;
	cursor: pointer;
}
.fog-name-suggestion__choose {
	padding: 8px 6px;
	text-align: left;
}
.fog-name-suggestion__edit {
	padding: 7px 9px;
	color: var(--ui-muted);
	border: 1px solid rgba(198,146,72,.28);
	border-radius: 999px;
	font-size: .78rem;
}
.fog-name-suggestion:hover,
.fog-name-suggestion:focus-within {
	background: var(--ui-surface-hover);
	border-color: var(--ui-accent);
}
.fog-name-secondary-actions {
	display: flex;
	flex-wrap: wrap;
	justify-content: center;
	gap: 10px;
	margin-top: 14px;
}
.fog-name-secondary-actions button {
	padding: 9px 14px;
	color: var(--ui-muted);
	background: rgba(22,17,13,.62);
	border: 1px solid rgba(198,146,72,.3);
	border-radius: 999px;
	font: inherit;
	font-size: .82rem;
	cursor: pointer;
}
.fog-room-screen .custom-input-host:not(:empty) {
	position: fixed;
	inset: 0;
	z-index: 80;
	display: grid;
	place-items: center;
	padding: 24px;
	box-sizing: border-box;
	background: rgba(7,5,4,.46);
	backdrop-filter: blur(3px);
}
@media (max-width: 700px) {
	.fog-room-screen #passages {
		max-height: 68vh;
		max-height: 68dvh;
		padding-left: 16px;
		padding-right: 16px;
	}
	.fog-room-screen #passages .choices,
	.fog-room-screen #passages .choice-list,
	.fog-name-suggestions {
		grid-template-columns: 1fr !important;
	}
}
.naming-input-row {
	display: grid; grid-template-columns: minmax(260px, 1fr) auto;
	gap: 12px; width: min(760px, 100%); margin: 20px auto 0;
}
.naming-input-row input {
	width: 100%; min-width: 0; padding: 15px 18px;
	color: var(--text); background: var(--ui-surface);
	border: 1px solid var(--ui-border); border-radius: 10px;
}
.naming-input-row a {
	display: grid; place-items: center; padding: 15px 20px;
	color: var(--text); text-decoration: none;
	background: var(--ui-surface); border: 1px solid var(--ui-border);
	border-radius: 10px;
}
.naming-back { margin-top: 12px; font-size: .82rem; }
.naming-back a { color: var(--muted); text-decoration: none; }
.room-input-aux {
	display: flex;
	justify-content: center;
	margin: 12px auto 0;
}
.room-input-aux button {
	padding: 9px 14px;
	color: var(--ui-muted);
	background: rgba(22,17,13,.54);
	border: 1px solid rgba(198,146,72,.3);
	border-radius: 999px;
	font: inherit;
	font-size: .82rem;
	cursor: pointer;
}
.room-input-aux button:hover,
.room-input-aux button:focus-visible {
	color: var(--ui-text);
	background: var(--ui-surface-hover);
	border-color: var(--ui-accent);
	outline: none;
}
.custom-choice-link {
	display: flex;
	justify-content: center;
	margin: 14px auto 0;
}
.custom-choice-link a {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: auto;
	min-width: 0;
	min-height: 0;
	padding: 9px 14px;
	color: var(--ui-muted);
	background: rgba(22,17,13,.54);
	border: 1px solid rgba(198,146,72,.3);
	border-radius: 999px;
	font-size: .82rem;
	text-decoration: none;
}
.custom-choice-link a:hover,
.custom-choice-link a:focus-visible {
	color: var(--ui-text);
	background: var(--ui-surface-hover);
	border-color: var(--ui-accent);
	outline: none;
}
#input-error {
	min-height: 1.5em;
	margin-top: 8px;
	color: #d9ad78;
	font-size: .84rem;
	text-align: left;
}
#input-error p { margin: 0; }
.custom-input-host:empty { display: none; }
.custom-input-panel {
	width: min(720px, calc(100vw - 48px));
	max-height: min(440px, calc(100dvh - 80px));
	margin: 0 auto;
	padding: 24px;
	box-sizing: border-box;
	color: var(--ui-text);
	background: rgba(22,17,13,.94);
	border: 1px solid var(--ui-border);
	border-radius: 14px;
	box-shadow: 0 18px 54px rgba(0,0,0,.42);
	overflow-y: auto;
}
.custom-input-panel label {
	display: block;
	margin: 0 0 12px;
	color: var(--ui-text);
	font-size: 1rem;
	font-weight: 700;
	text-align: left;
}
.custom-input-panel textarea,
.custom-input-panel input {
	display: block;
	width: 100%;
	padding: 14px 16px;
	box-sizing: border-box;
	color: var(--ui-text);
	background: rgba(10,8,6,.76);
	border: 1px solid rgba(198,146,72,.4);
	border-radius: 10px;
	font: inherit;
	line-height: 1.6;
}
.custom-input-panel textarea {
	min-height: 110px;
	resize: vertical;
}
.custom-input-panel input {
	min-height: 52px;
}
.custom-input-panel textarea:focus,
.custom-input-panel input:focus {
	border-color: var(--ui-accent);
	outline: 2px solid rgba(198,146,72,.16);
}
.custom-input-help {
	margin: 0 0 14px;
	color: var(--ui-muted);
	font-size: .88rem;
	line-height: 1.6;
	text-align: left;
}
.custom-input-actions {
	display: flex;
	justify-content: flex-end;
	gap: 12px;
	margin-top: 16px;
}
.custom-input-actions button {
	width: auto;
	min-width: 0;
	padding: 12px 17px;
	color: var(--ui-text);
	background: var(--ui-surface);
	border: 1px solid var(--ui-border);
	border-radius: 9px;
	font: inherit;
	cursor: pointer;
}
.custom-input-actions button.primary {
	color: #fff3df;
	border-color: rgba(198,146,72,.72);
}
.custom-input-actions button:hover,
.custom-input-actions button:focus-visible {
	background: var(--ui-surface-hover);
	border-color: var(--ui-accent);
	outline: none;
}
.custom-input-response {
	margin: 14px 0 0;
	color: var(--ui-muted);
	line-height: 1.65;
	text-align: left;
}
.custom-input-quote {
	margin: 12px 0 0;
	padding: 12px 14px;
	color: var(--ui-text);
	background: rgba(198,146,72,.08);
	border-left: 2px solid var(--ui-accent);
	border-radius: 0 8px 8px 0;
	white-space: pre-wrap;
	overflow-wrap: anywhere;
	text-align: left;
}
.room-name-screen #passages {
	height: 100vh;
	max-height: 100vh;
}
@media (max-width: 600px) {
	.custom-input-panel {
		width: calc(100vw - 28px);
		padding: 18px;
	}
	.custom-input-actions {
		flex-direction: column-reverse;
	}
	.custom-input-actions button { width: 100%; }
}
.discovery-entry #passages {
	position: fixed; left: 0; right: 0; bottom: 7vh; top: auto;
	width: 100%; max-width: none; margin: 0; padding: 0 24px;
	transform: none; text-align: center;
	animation: none;
	background: transparent; border: 0; box-shadow: none; backdrop-filter: none;
	text-shadow: 0 2px 18px rgba(0,0,0,.9);
}
.discovery-entry:not(.first-entry-screen) #passages::before {
	content: ""; position: absolute; inset: -4rem -6rem -3rem;
	z-index: -1; pointer-events: none;
	background: radial-gradient(ellipse at 50% 70%, rgba(0,0,0,.62), transparent 72%);
}
.station-hub #passages {
	position: fixed; left: 0; right: 0; bottom: 0; top: auto;
	width: 100%; max-width: none; max-height: none; margin: 0; padding: 0;
	transform: none; overflow: visible; text-align: center; pointer-events: none;
	background: transparent; border: 0; box-shadow: none; backdrop-filter: none;
	animation: none;
	text-shadow: 0 2px 18px rgba(0,0,0,.95);
}
.station-hub #passages .passage {
	width: 100%; max-width: none; margin: 0; pointer-events: none;
}
.hub-ui {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: 10;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: flex-end;
	min-height: 150px;
	padding: 70px 32px max(26px, env(safe-area-inset-bottom));
	box-sizing: border-box;
	text-align: center;
	background: linear-gradient(
		to bottom,
		rgba(12,9,7,0) 0%,
		rgba(12,9,7,.58) 52%,
		rgba(12,9,7,.9) 100%
	);
	pointer-events: none;
}
.hub-ui__message {
	max-width: 720px;
	margin: 0;
	color: #f2eadc;
	font-size: clamp(16px, 1.5vw, 21px);
	line-height: 1.5;
}
.hub-ui button,
.hub-ui a { pointer-events: auto; }
.weather-record-button,
.record-button a {
	display: block;
	width: min(520px, calc(100vw - 48px));
	margin: 24px auto 0;
	padding: 20px 28px;
	box-sizing: border-box;
	color: var(--ui-text);
	background: var(--ui-surface);
	border: 1px solid var(--ui-border);
	border-radius: 12px;
	font: inherit;
	text-decoration: none;
	cursor: pointer;
	pointer-events: auto;
	box-shadow:
		0 12px 36px rgba(0,0,0,.32),
		inset 0 1px rgba(255,255,255,.035);
}
.weather-record-button:hover,
.weather-record-button:focus-visible,
.record-button a:hover,
.record-button a:focus-visible {
	color: var(--ui-text);
	background: var(--ui-surface-hover);
	border-color: var(--ui-accent);
	box-shadow:
		0 0 22px rgba(198,146,72,.2),
		0 12px 36px rgba(0,0,0,.38);
	outline: none;
}
.reading-page #station-backdrop::after {
	content: ""; position: absolute; inset: 0;
	background: rgba(12,8,5,.66); backdrop-filter: blur(4px);
}
.reading-page #passages {
	position: relative; left: auto; right: auto; bottom: auto;
	width: min(860px, calc(100vw - 3rem)); max-height: none;
	margin: 4vh auto; padding: clamp(1.6rem, 4vw, 3.4rem);
	overflow: visible; pointer-events: auto;
	background: rgba(22,17,13,.96); border: 1px solid rgba(198,151,87,.42);
	border-radius: 14px; box-shadow: 0 24px 80px rgba(0,0,0,.28);
}
.reading-page #passages .passage {
	max-width: 720px; margin: 0 auto; text-align: left;
}
.about-page #station-backdrop::after {
	content: ""; position: absolute; inset: 0;
	background: rgba(12, 8, 5, .68); backdrop-filter: blur(5px);
}
.about-page #passages {
	position: relative; left: auto; right: auto; bottom: auto;
	width: min(860px, calc(100vw - 3rem)); max-height: none; margin: 4vh auto;
	padding: clamp(1.6rem, 4vw, 3.4rem);
	overflow: visible; pointer-events: auto;
	background: rgba(22, 17, 13, .95);
	border-color: rgba(198,151,87,.42);
}
.about-page .passage { max-width: 720px; margin: 0 auto; }
.about-page h1 { margin-bottom: .65rem; color: #f0e8d9; }
.about-page h2 {
	margin: 2.7rem 0 .7rem; color: var(--signal-soft);
	font-size: 1.15rem; letter-spacing: 0;
}
.about-lead {
	margin: 0 0 2rem; color: #f0e8d9;
	font-size: 1.08rem; line-height: 1.75;
}
.about-page ul, .about-page ol { padding-left: 1.35rem; }
.about-page li { margin: .55rem 0; }
.about-note {
	margin: 2rem 0; padding: 1.15rem 1.25rem;
	border-left: 3px solid var(--signal); background: rgba(94,63,35,.24);
}
.after-experience {
	margin-top: 3rem; padding: 1.1rem 1.2rem;
	border: 1px solid rgba(198,151,87,.4); border-radius: 10px;
	background: rgba(27,22,17,.65);
}
.after-experience > summary {
	cursor: pointer; color: var(--signal-soft); font-weight: 700;
}
.about-table { width: 100%; margin: 1.3rem 0; border-collapse: collapse; }
.about-table th, .about-table td {
	padding: .72rem .75rem; border-bottom: 1px solid rgba(198,151,87,.2);
	text-align: left; vertical-align: top;
}
.about-table th { color: var(--signal-soft); font-size: .84rem; }
.about-closing {
	margin: 2rem 0 0; color: #f0e8d9; font-size: 1.02rem;
	text-align: center;
}
.guide-dialog {
	width: min(800px, calc(100vw - 48px)); max-height: 80vh;
	margin: auto; padding: 0; color: #f1e9dc;
	background: rgba(25,20,16,.95);
	border: 1px solid rgba(198,146,72,.45); border-radius: 20px;
	box-shadow: 0 28px 90px rgba(0,0,0,.65), inset 0 1px rgba(255,255,255,.04);
	overflow: hidden;
}
.guide-dialog::backdrop {
	background: rgba(8,6,4,.48); backdrop-filter: blur(2px) brightness(.72);
}
.discovery-entry .single-choice {
	justify-content: center;
}
.discovery-entry .single-choice a { flex: 0 1 360px; }
.guide-close {
	position: absolute; z-index: 2; top: 14px; right: 18px;
	width: 42px; height: 42px; padding: 0; color: #c9bfb1;
	background: transparent; border: 0; font-size: 28px; cursor: pointer;
}
.guide-tabs {
	display: grid; grid-template-columns: repeat(5, minmax(0,1fr));
	gap: 0; padding: 18px 64px 0; border-bottom: 1px solid rgba(198,146,72,.18);
}
.guide-tab {
	padding: 14px 8px; color: rgba(225,214,199,.68); background: transparent;
	border: 0; border-bottom: 2px solid transparent; font: inherit; cursor: pointer;
}
.guide-tab.is-active { color: #e0b879; border-bottom-color: #c69248; }
.guide-content { max-height: calc(80vh - 74px); padding: 44px 64px 58px; overflow-y: auto; }
.guide-panel { display: none; }
.guide-panel.is-active { display: block; animation: signal-in .25s ease both; }
.guide-panel h1 { margin: 0 0 28px; color: #f1e9dc; font-size: clamp(28px,4vw,46px); }
.guide-panel h2 { margin: 36px 0 14px; color: #d3a15e; font-size: 20px; }
.guide-panel p, .guide-panel li { color: #d8d0c5; font-size: 16px; line-height: 1.85; }
.guide-panel ul, .guide-panel ol { padding-left: 1.3rem; }
.guide-note { padding: 1rem 1.1rem; border-left: 3px solid #c69248; background: rgba(75,52,31,.28); }
.guide-actions { margin-top: 28px; display: flex; gap: 10px; flex-wrap: wrap; }
.guide-actions button {
	padding: 11px 14px; color: #ded3c3; background: rgba(54,39,27,.72);
	border: 1px solid rgba(198,146,72,.35); border-radius: 8px; cursor: pointer;
}
.room-arriving #passages { opacity: 0; pointer-events: none; }
.room-arriving #global-about,
.room-arriving #global-sound,
.room-arriving #global-exit { opacity: 0; pointer-events: none; }
.intro-ui {
	width: 100%; display: flex; flex-direction: column;
	align-items: center; text-align: center;
}
.intro-ui h1 {
	margin: 0 0 12px; color: #f0e8d9;
	font-size: clamp(1.15rem, 2.1vw, 1.65rem); line-height: 1.55;
}
.intro-ui .description {
	margin: 0 0 6px; color: rgba(242,234,220,.84); font-size: .95rem;
}
.intro-ui .signal {
	margin: 0 0 24px; color: rgba(242,234,220,.72); font-size: .9rem;
}
.discovery-line {
	margin: 0 0 12px; color: #f0e8d9;
	font-size: clamp(1.15rem, 2.1vw, 1.65rem); line-height: 1.55;
}
.discovery-sub {
	margin: 0 0 24px; color: rgba(242,234,220,.84); font-size: .95rem;
}
#global-exit {
	position: fixed; z-index: 30; top: 1.2rem; right: 1.4rem;
	color: var(--text); font-size: .76rem; opacity: .58; text-decoration: none;
}
#global-about {
	position: fixed; z-index: 30; top: 1.2rem; left: 1.4rem;
	color: var(--text); font: 700 .7rem ui-monospace, monospace;
	letter-spacing: .12em; opacity: .58; text-decoration: none;
}
#global-sound {
	position: fixed; z-index: 30; top: 1.02rem; left: 10.2rem;
	margin: 0; padding: .2rem .35rem;
	color: var(--text); background: rgba(22,17,13,.34);
	border: 1px solid rgba(198,146,72,.18); border-radius: 5px;
	font: 600 .7rem/1.45 ui-monospace, monospace;
	letter-spacing: .05em; opacity: .58; cursor: pointer;
}
#global-about:hover,
#global-about:focus-visible { opacity: 1; color: var(--signal-soft); }
#global-sound:hover,
#global-sound:focus-visible {
	opacity: 1; color: var(--signal-soft);
	border-color: rgba(198,146,72,.52); outline: none;
}
#global-exit:hover,
#global-exit:focus-visible { opacity: 1; color: var(--signal-soft); }
@media (max-width: 640px) {
	#global-sound { top: 3rem; left: 1.05rem; }
}
.quiet-exit { display: none; }
@keyframes signal-in {
	from { opacity: 0; transform: translateY(5px); }
	to { opacity: 1; transform: translateY(0); }
}
h1, h2 { line-height: 1.35; letter-spacing: -.02em; }
.code {
	color: var(--signal); font: 700 .75rem ui-monospace, monospace;
	letter-spacing: .13em; text-transform: uppercase;
}
.transmission, .instrument, .forecast {
	margin: 1.4rem 0; padding: 1.1rem 1.2rem;
	border: 1px solid var(--line); border-radius: 9px; background: var(--panel2);
}
.transmission { border-left: 3px solid var(--signal); }
.instrument { border-left: 3px solid var(--amber); }
.forecast { border-left: 3px solid var(--ui-accent); }
.prompt { color: var(--muted); font-size: .9rem; }
.permission-guide {
	margin: 1.2rem 0 1.5rem; padding: 1rem 1.1rem;
	border: 1px solid rgba(198,151,87,.24); border-radius: 9px;
	background: rgba(34,25,18,.58); color: rgba(242,234,220,.78);
	font-size: .9rem; line-height: 1.75;
}
.permission-listening {
	display: flex; align-items: center; justify-content: center; gap: .75rem;
	min-height: 4.2rem; color: var(--signal); font-weight: 700; letter-spacing: .02em;
}
.permission-listening::before {
	content: ""; width: .72rem; height: .72rem; flex: 0 0 auto;
	border: 1px solid var(--signal); border-radius: 50%;
	box-shadow: 0 0 0 0 rgba(198,151,87,.48);
	animation: listening-pulse 1.35s ease-out infinite;
}
.permission-result {
	margin-top: 1.35rem; padding: 1.15rem 1.2rem;
	border-left: 3px solid var(--signal); border-radius: 9px;
	background: rgba(43,32,23,.8); animation: signal-in .45s ease both;
}
.permission-result p { margin: 0; }
.permission-result p + p { margin-top: .35rem; color: rgba(242,234,220,.78); }
@keyframes listening-pulse {
	0% { box-shadow: 0 0 0 0 rgba(198,151,87,.5); opacity: 1; }
	75%, 100% { box-shadow: 0 0 0 .65rem rgba(198,151,87,0); opacity: .72; }
}
.choices { display: grid; gap: .7rem; margin-top: 2rem; }
.choices a, .station-actions a {
	display: block; padding: .82rem 1rem; color: var(--text);
	border: 1px solid var(--line); border-radius: 8px; text-decoration: none;
	background: var(--ui-surface); transition: .18s ease;
	box-sizing: border-box;
}
.choices a:hover, .station-actions a:hover,
.choices a:focus-visible, .station-actions a:focus-visible {
	color: #f7ead7;
	border-color: var(--signal);
	background: var(--signal-wash);
	box-shadow: inset 0 0 0 1px rgba(226,199,158,.08), 0 5px 18px rgba(0,0,0,.16);
	outline: none;
}
.choices a:active, .station-actions a:active,
.discovery-entry .choices a:active {
	color: #fff3df;
	border-color: var(--signal-soft);
	background: rgba(112,75,39,.82);
	box-shadow: inset 0 2px 7px rgba(0,0,0,.28);
	transform: translateY(1px);
}
.stop a { color: #f0b1a9; }
.room-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; margin-top: 1.8rem; }
.room-grid a { min-height: 100px; display: grid; place-items: center; text-align: center; }
.report {
	display: grid; gap: .7rem; margin: 1.4rem 0; padding: 1.3rem;
	color: var(--ui-text);
	border: 1px solid var(--ui-border); border-radius: 12px;
	background: var(--ui-surface);
	box-shadow: 0 16px 42px rgba(0,0,0,.28), inset 0 1px rgba(255,255,255,.035);
}
.report-row { display: grid; grid-template-columns: 120px 1fr; gap: 1rem; }
.report-row span { color: var(--muted); }
.report-row b { color: var(--ui-text); font-weight: 600; }
.room-report-grid {
	width: min(1320px, calc(100vw - 48px));
	margin: 32px auto;
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 20px;
	align-items: stretch;
}
.room-report-card {
	width: auto;
	min-width: 0;
	min-height: 0;
	padding: 28px;
	color: var(--ui-text);
	background: var(--ui-surface);
	border: 1px solid var(--ui-border); border-radius: 12px;
	box-shadow: 0 12px 32px rgba(0,0,0,.22), inset 0 1px rgba(255,255,255,.03);
}
.room-report-card h3 {
	margin: 0 0 .75rem;
	color: var(--ui-text);
	font-size: clamp(1.08rem, 1.5vw, 1.3rem);
}
.room-report-card p {
	margin: 0 0 1rem;
	color: var(--ui-muted);
	line-height: 1.75;
}
.room-report-card strong { color: var(--ui-text); font-weight: 600; }
.room-report-eyebrow {
	margin-bottom: .5rem !important;
	color: var(--ui-accent) !important;
	font: 700 .72rem ui-monospace, monospace;
	letter-spacing: .12em;
}
.room-report-name {
	padding-bottom: 1rem;
	color: var(--ui-text) !important;
	border-bottom: 1px solid rgba(198,146,72,.22);
}
.record-actions.choices a {
	color: var(--ui-text);
	background: var(--ui-surface);
	border-color: var(--ui-border);
}
.record-actions.choices a:hover,
.record-actions.choices a:focus-visible {
	color: var(--ui-text);
	background: var(--ui-surface-hover);
	border-color: var(--ui-accent);
}
@media (max-width: 1000px) {
	.room-report-grid { grid-template-columns: 1fr; }
}
.weather-record-page {
	overflow-y: auto;
}
.weather-record-page #passages {
	width: min(1440px, calc(100vw - 32px));
	max-height: none;
	margin: clamp(24px, 4vh, 56px) auto;
	padding: clamp(28px, 4vw, 64px);
	box-sizing: border-box;
}
.weather-record-page #passages .passage {
	max-width: none;
	margin: 0 auto;
}
.observation-record-header {
	width: min(900px, 100%);
	margin: 0 auto clamp(44px, 6vw, 72px);
	text-align: center;
}
.record-eyebrow {
	margin: 0 0 14px;
	color: var(--ui-accent);
	font: 700 .72rem ui-monospace, monospace;
	letter-spacing: .16em;
}
.observation-record-header h1 {
	margin: 0 0 20px;
	color: var(--ui-text);
	font-size: clamp(2rem, 5vw, 4rem);
}
.record-lead {
	margin: 0;
	color: var(--ui-muted);
	font-size: clamp(.98rem, 1.4vw, 1.1rem);
	line-height: 1.9;
}
.observation-report-host {
	width: 100%;
}
.observation-section {
	width: min(1120px, 100%);
	margin: 0 auto;
	padding: clamp(30px, 4vw, 52px) 0;
	border-top: 1px solid rgba(198,146,72,.24);
}
.observation-section > h2 {
	margin: 0 0 24px;
	color: var(--ui-accent);
	font-size: clamp(1.25rem, 2.2vw, 1.75rem);
}
.observation-section > p {
	margin: 0 0 14px;
	color: var(--ui-text);
	font-size: clamp(.96rem, 1.3vw, 1.06rem);
	line-height: 1.85;
}
.observation-summary {
	width: min(900px, 100%);
	padding-top: 0;
	border-top: 0;
}
.initial-state-record {
	width: min(900px, 100%);
	padding-top: 0;
	border-top: 0;
}
.initial-state-record .record-state-quote {
	padding: 18px 20px;
	background: rgba(198,146,72,.07);
	border-left: 2px solid var(--ui-accent);
	border-radius: 0 10px 10px 0;
	font-size: clamp(1.02rem, 1.6vw, 1.22rem);
	white-space: pre-wrap;
}
.observation-summary p {
	margin-bottom: 18px;
}
.report-user-correction {
	width: min(900px, 100%);
	margin-bottom: 34px;
	padding: 24px 28px;
	border: 1px solid rgba(198,146,72,.48);
	border-radius: 12px;
	background: rgba(55,39,27,.54);
}
.report-user-correction h2 {
	margin-bottom: 12px;
	font-size: 1rem;
}
.report-user-correction p {
	margin: 0;
	white-space: pre-wrap;
}
.relationship-flow {
	display: grid;
	gap: 0;
	margin: 24px 0;
	padding: 0;
	list-style: none;
	counter-reset: observation-flow;
}
.relationship-flow li {
	position: relative;
	margin: 0;
	padding: 18px 18px 18px 52px;
	color: var(--ui-text);
	background: rgba(35,26,19,.7);
	border-left: 1px solid rgba(198,146,72,.42);
	line-height: 1.7;
	counter-increment: observation-flow;
}
.relationship-flow li::before {
	content: counter(observation-flow);
	position: absolute;
	left: 17px;
	top: 18px;
	width: 22px;
	height: 22px;
	display: grid;
	place-items: center;
	color: #24180f;
	background: var(--ui-accent);
	border-radius: 50%;
	font: 700 .72rem ui-monospace, monospace;
}
.relationship-flow li + li::after {
	content: "↓";
	position: absolute;
	left: 21px;
	top: -13px;
	color: var(--ui-accent);
}
.section-note {
	color: var(--ui-muted) !important;
	font-size: .9rem !important;
}
.allowed-change-list {
	display: grid;
	gap: 12px;
	margin: 0;
	padding: 0;
	list-style: none;
}
.allowed-change-list li {
	padding: 14px 16px 14px 42px;
	position: relative;
	color: var(--ui-text);
	background: rgba(35,26,19,.55);
	border-radius: 8px;
	line-height: 1.65;
}
.allowed-change-list li::before {
	content: "·";
	position: absolute;
	left: 18px;
	color: var(--ui-accent);
	font-size: 1.4rem;
}
.weather-record-section {
	width: min(900px, 100%);
}
.weather-record-tags {
	display: flex;
	flex-wrap: wrap;
	gap: 10px;
	margin: 24px 0;
}
.weather-record-tags span {
	padding: 10px 14px;
	color: var(--ui-text);
	background: rgba(55,39,27,.7);
	border: 1px solid rgba(198,146,72,.44);
	border-radius: 999px;
}
.weather-comparison-text {
	padding: 18px 20px;
	background: rgba(24,18,14,.62);
	border-left: 3px solid var(--ui-accent);
}
.own-words-section {
	width: min(900px, 100%);
}
.own-words-section blockquote {
	margin: 0 0 18px;
	padding: 20px 22px;
	border: 1px solid rgba(198,146,72,.32);
	border-left: 3px solid var(--ui-accent);
	border-radius: 10px;
	background: rgba(32,24,18,.72);
}
.own-words-section blockquote span {
	color: var(--ui-accent);
	font-size: .78rem;
	font-weight: 700;
}
.own-words-section blockquote p {
	margin: 10px 0 0;
	color: var(--ui-text);
	line-height: 1.8;
	white-space: pre-wrap;
}
.report-reflection,
.next-observation {
	width: min(900px, 100%);
}
.report-resonance-choices,
.record-actions {
	display: flex;
	flex-wrap: wrap;
	justify-content: center;
	gap: 12px;
	margin-top: 22px;
}
.report-resonance-choices button,
.record-actions button,
.report-correction button {
	min-width: 0;
	padding: 14px 18px;
	color: var(--ui-text);
	background: var(--ui-surface);
	border: 1px solid var(--ui-border);
	border-radius: 10px;
	font: inherit;
	cursor: pointer;
}
.report-resonance-choices button {
	flex: 1 1 180px;
}
.report-resonance-choices button:hover,
.report-resonance-choices button:focus-visible,
.report-resonance-choices button.is-selected,
.record-actions button:hover,
.record-actions button:focus-visible,
.report-correction button:hover,
.report-correction button:focus-visible {
	background: var(--ui-surface-hover);
	border-color: var(--ui-accent);
	outline: none;
}
.report-resonance-choices button.is-selected {
	box-shadow: 0 0 20px rgba(198,146,72,.18);
}
.record-actions button {
	flex: 1 1 220px;
}
.record-actions button:disabled {
	opacity: .58;
	cursor: default;
}
.report-correction {
	display: grid;
	gap: 12px;
	margin-top: 24px;
}
.report-correction label {
	color: var(--ui-text);
	font-weight: 700;
}
.report-correction textarea {
	width: 100%;
	min-height: 112px;
	padding: 14px 16px;
	box-sizing: border-box;
	color: var(--ui-text);
	background: rgba(12,9,7,.84);
	border: 1px solid var(--ui-border);
	border-radius: 10px;
	font: inherit;
	line-height: 1.65;
	resize: vertical;
	-webkit-user-select: text;
	user-select: text;
}
.report-correction textarea:focus {
	border-color: var(--ui-accent);
	outline: none;
	box-shadow: 0 0 0 3px rgba(198,146,72,.12);
}
.next-question-text {
	color: var(--ui-text) !important;
	font-size: clamp(1.12rem, 2vw, 1.45rem) !important;
}
@media (max-width: 1000px) {
	.weather-record-page #passages {
		width: min(920px, calc(100vw - 24px));
		padding: clamp(24px, 5vw, 44px);
	}
}
@media (max-width: 620px) {
	.weather-record-page #passages {
		width: calc(100vw - 16px);
		margin: 8px auto;
		padding: 28px 18px 40px;
	}
	.room-report-grid {
		width: 100%;
	}
	.room-report-card {
		padding: 22px 20px;
	}
	.report-resonance-choices,
	.record-actions {
		flex-direction: column;
	}
	.report-resonance-choices button,
	.record-actions button {
		width: 100%;
		flex: 0 0 auto;
	}
}
#ui-bar { display: none !important; }
#story { margin-left: 0; }
#story-title { display: none; }
.station-name { margin-top: 1rem; color: var(--signal); font: 700 .7rem ui-monospace, monospace; letter-spacing: .1em; }
.station-ko { margin: .3rem 0 1.4rem; font-weight: 700; }
.station-status, .station-data div { display: grid; gap: .2rem; margin-bottom: .7rem; }
.station-status span, .station-data span { color: var(--muted); font-size: .72rem; }
.station-data b { font-size: .85rem; }
.station-actions { display: grid; gap: .5rem; margin-top: 1.4rem; font-size: .8rem; }
@media (max-width: 560px) {
	.naming-input-row { grid-template-columns: 1fr; }
}
@media (max-width: 720px) {
	#station-backdrop { height: 100vh; bottom: 0; }
	#passages {
		left: 0; right: 0; bottom: 0; width: 100%; max-height: 64vh;
		margin: 0; padding: 78px 1rem 18px;
	}
	.reading-page #passages,
	.about-page #passages {
		position: relative; left: auto; right: auto; bottom: auto;
		width: calc(100vw - 1.4rem); max-height: none;
		margin: .7rem auto; padding: 1.5rem 1.2rem;
	}
	.discovery-entry #station-backdrop { height: 100vh; bottom: 0; }
	.discovery-entry #passages {
		left: 1rem; right: 1rem; bottom: 8vh; width: auto;
		margin: 0; padding: 0; transform: none;
	}
	.room-grid { grid-template-columns: 1fr; }
	.guide-dialog { width: calc(100vw - 24px); max-height: 86vh; }
	.guide-tabs { grid-template-columns: repeat(2, 1fr); padding: 44px 16px 0; }
	.guide-content { max-height: calc(86vh - 118px); padding: 30px 22px 42px; }
}
.first-entry-screen {
	width: 100%;
	height: 100%;
	margin: 0;
	overflow: hidden;
}
.first-entry-screen #story,
.first-entry-screen #station-backdrop {
	width: 100%;
	height: 100vh;
	height: 100dvh;
	overflow: hidden;
}
.first-entry-screen #passages {
	position: fixed;
	inset: 0;
	width: 100%;
	height: 100vh;
	height: 100dvh;
	max-width: none;
	max-height: none;
	margin: 0;
	padding: 0;
	transform: none;
	overflow: hidden;
	background: transparent;
	text-shadow: 0 2px 18px rgba(0,0,0,.9);
}
.first-entry-screen #passages::before,
.first-entry-screen #passages::after {
	content: none;
}
.first-entry-screen #passages .passage {
	width: 100%;
	height: 100%;
	max-width: none;
	margin: 0;
	pointer-events: none;
}
.intro-overlay {
	position: fixed;
	inset: 0;
	z-index: 10;
	display: flex;
	align-items: flex-end;
	justify-content: center;
	min-height: 100vh;
	min-height: 100dvh;
	padding: 0 24px max(7vh, 48px);
	box-sizing: border-box;
	pointer-events: none;
	background: linear-gradient(
		to bottom,
		transparent 48%,
		rgba(12,9,7,.08) 58%,
		rgba(12,9,7,.48) 78%,
		rgba(12,9,7,.82) 100%
	);
}
.intro-content {
	position: relative;
	z-index: 2;
	width: min(560px, calc(100vw - 40px));
	margin: 0 auto;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 18px;
	text-align: center;
	pointer-events: auto;
}
.intro-content > br { display: none; }
.intro-content h1 {
	margin: 0;
	color: #f0e8d9;
	font-size: clamp(1.45rem, 2.7vw, 2.15rem);
	line-height: 1.35;
}
.intro-content p {
	margin: 0;
	color: rgba(242,234,220,.82);
	font-size: clamp(.92rem, 1.3vw, 1.05rem);
	line-height: 1.6;
}
.intro-content button {
	width: min(360px, 100%);
	margin: 6px 0 0;
	padding: 17px 24px;
	box-sizing: border-box;
	color: var(--ui-text);
	background: rgba(22,17,13,.76);
	border: 1px solid rgba(198,146,72,.48);
	border-radius: 10px;
	box-shadow: 0 12px 32px rgba(0,0,0,.28), inset 0 1px rgba(255,255,255,.035);
	font: inherit;
	font-size: 1rem;
	cursor: pointer;
	pointer-events: auto;
	transition: background .18s ease, border-color .18s ease, box-shadow .18s ease;
}
.intro-content button:hover,
.intro-content button:focus-visible {
	color: var(--ui-text);
	background: var(--ui-surface-hover);
	border-color: var(--ui-accent);
	box-shadow: 0 0 22px rgba(198,146,72,.18), 0 12px 36px rgba(0,0,0,.36);
	outline: none;
}
.first-entry-screen #global-about,
.first-entry-screen #global-exit {
	z-index: 12;
}
@media (max-height: 760px) {
	.intro-overlay { padding-bottom: 28px; }
	.intro-content {
		gap: 12px;
		transform: scale(.92);
		transform-origin: bottom center;
	}
}

/* Direct weather-making controls: the sliders describe, rather than score, a state. */
.weather-builder-stage {
	width: min(1080px, 100%);
	margin: 0 auto;
	text-align: center;
}
.weather-builder-stage h1 {
	margin: 0 0 8px;
	color: var(--ui-text);
	font-size: clamp(1.25rem, 2.2vw, 1.8rem);
}
.weather-builder-stage > p {
	width: min(760px, 100%);
	margin: 0 auto 18px;
	color: var(--ui-muted);
}
.weather-controls {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 10px;
}
.weather-control {
	padding: 12px 14px;
	color: var(--ui-text);
	background: rgba(22,17,13,.72);
	border: 1px solid rgba(198,146,72,.32);
	border-radius: 10px;
	text-align: left;
}
.weather-control__top {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	gap: 12px;
	margin-bottom: 8px;
}
.weather-control__top span { color: var(--ui-muted); font-size: .82rem; }
.weather-control__top output {
	color: var(--ui-accent);
	font: 700 .75rem ui-monospace, monospace;
}
.weather-control input[type="range"] {
	width: 100%;
	margin: 0;
	accent-color: var(--ui-accent);
	cursor: pointer;
}
.weather-builder-actions {
	display: flex;
	justify-content: center;
	gap: 10px;
	margin-top: 14px;
}
.weather-builder-actions button {
	min-width: 220px;
	padding: 13px 18px;
	color: var(--ui-text);
	background: var(--ui-surface);
	border: 1px solid var(--ui-border);
	border-radius: 9px;
	font: inherit;
	cursor: pointer;
}
.weather-builder-actions button:hover,
.weather-builder-actions button:focus-visible {
	background: var(--ui-surface-hover);
	border-color: var(--ui-accent);
	outline: none;
}
.felt-sense-note {
	width: min(760px, 100%);
	margin: 0 auto 18px;
	color: var(--ui-muted);
	text-align: center;
}
.record-comparison {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 12px;
	margin: 1rem 0;
}
@media (max-width: 760px) {
	.weather-controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.record-comparison { grid-template-columns: 1fr; }
}
@media (max-width: 520px) {
	.weather-controls { grid-template-columns: 1fr; }
	.weather-builder-actions { flex-direction: column; }
	.weather-builder-actions button { width: 100%; min-width: 0; }
}

/* Question content and its visual gradient are independent fixed layers. */
.story-gradient {
	position: fixed;
	inset: 42% 0 0;
	z-index: 10;
	pointer-events: none;
	background: linear-gradient(
		to bottom,
		rgba(12,9,7,0) 0%,
		rgba(12,9,7,.48) 52%,
		rgba(12,9,7,.92) 100%
	);
}
.story-panel-screen #passages {
	position: fixed;
	inset: 0;
	z-index: 20;
	width: 100%;
	max-width: none;
	max-height: none;
	margin: 0;
	padding: 0;
	transform: none;
	overflow: hidden;
	background: transparent;
	border: 0;
	box-shadow: none;
	backdrop-filter: none;
	pointer-events: none;
}
.story-panel-screen.discovery-entry:not(.first-entry-screen) #passages::before {
	content: none;
}
#passages .passage.story-panel {
	position: fixed;
	left: 50%;
	bottom: max(24px, env(safe-area-inset-bottom));
	z-index: 20;
	width: 100%;
	max-width: 1440px;
	max-height: calc(100dvh - 48px);
	margin: 0;
	padding: 0 24px;
	box-sizing: border-box;
	transform: translateX(-50%);
	overflow-y: auto;
	text-align: center;
	pointer-events: auto;
}
#passages .story-panel .story-question {
	width: min(900px, 100%);
	margin: 0 auto 24px !important;
	word-break: keep-all;
	text-align: center;
}
#passages .story-panel .intro-ui > br,
#passages .story-panel .story-ui > br {
	display: none;
}
#passages .story-panel .choice-list {
	width: min(1400px, calc(100vw - 64px), 100%) !important;
	max-width: 100%;
	margin: 0 auto !important;
	display: flex !important;
	flex-wrap: wrap !important;
	justify-content: center !important;
	gap: 14px !important;
	overflow: visible !important;
	white-space: normal !important;
	transform: none !important;
}
#passages .story-panel .choice-list > br {
	display: none;
}
#passages .story-panel .choice-list > .choice-button {
	flex: 1 1 280px !important;
	width: auto !important;
	max-width: 340px;
	min-width: 0 !important;
	min-height: 74px;
	height: auto;
	margin: 0 !important;
	padding: 16px 20px;
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	white-space: normal !important;
	word-break: keep-all;
	overflow-wrap: break-word;
	text-align: center;
	line-height: 1.45;
}
#passages .story-panel .room-input-aux {
	width: 100%;
	margin: 14px auto 0;
}
#passages .story-panel .room-input-aux button {
	width: auto;
	min-width: 0;
	min-height: 0;
}
@media (min-width: 1001px) {
	#passages .story-panel .choice-list.choice-count-4 > .choice-button {
		flex: 0 1 calc((100% - 42px) / 4) !important;
	}
	#passages .story-panel .choice-list.choice-count-5 > .choice-button,
	#passages .story-panel .choice-list.choice-count-6 > .choice-button,
	#passages .story-panel .choice-list.choice-count-7 > .choice-button {
		flex: 0 1 calc((100% - 28px) / 3) !important;
	}
}
@media (max-width: 1000px) {
	#passages .story-panel .choice-list > .choice-button {
		flex: 0 1 calc(50% - 7px) !important;
		max-width: 440px;
	}
}
@media (max-width: 620px) {
	#passages .passage.story-panel {
		bottom: max(16px, env(safe-area-inset-bottom));
		padding: 0 16px;
	}
	#passages .story-panel .choice-list {
		width: calc(100vw - 32px) !important;
		gap: 10px !important;
	}
	#passages .story-panel .choice-list > .choice-button {
		flex-basis: 100% !important;
		max-width: none;
		min-height: 64px;
	}
}

/*
 * The wave room is a vertical underwater passage, not a bottom-sheet
 * questionnaire.  The Babylon canvas stays fixed while this transparent
 * story layer supplies the descent distance.
 */
body.wave-room-screen {
	overflow: hidden;
	background: #03101a;
}
.wave-room-screen #global-exit {
	display: none !important;
}
.wave-room-screen .story-gradient {
	display: none !important;
}
.wave-room-screen.story-panel-screen #passages,
.wave-room-screen #passages {
	position: fixed;
	inset: 0;
	z-index: 20;
	width: 100%;
	height: 100vh;
	height: 100dvh;
	max-width: none;
	max-height: none;
	margin: 0;
	padding: 0;
	transform: none;
	overflow-x: hidden;
	overflow-y: auto;
	overscroll-behavior-y: contain;
	scroll-behavior: smooth;
	background: transparent;
	border: 0;
	border-radius: 0;
	box-shadow: none;
	backdrop-filter: none;
	pointer-events: auto;
	scrollbar-color: rgba(184,213,222,.28) transparent;
}
.wave-room-screen #passages::-webkit-scrollbar {
	width: 7px;
}
.wave-room-screen #passages::-webkit-scrollbar-track {
	background: transparent;
}
.wave-room-screen #passages::-webkit-scrollbar-thumb {
	background: rgba(184,213,222,.22);
	border-radius: 999px;
}
.wave-room-screen #passages .passage,
.wave-room-screen #passages .passage.story-panel {
	position: relative;
	inset: auto;
	width: 100%;
	max-width: none;
	max-height: none;
	min-height: 100%;
	margin: 0;
	padding: 0;
	transform: none;
	overflow: visible;
	color: #e6eff1;
	text-align: center;
	pointer-events: auto;
}
.wave-descent {
	position: relative;
	width: 100%;
	min-height: 225vh;
	min-height: 225dvh;
	box-sizing: border-box;
}
.wave-descent--continuation {
	min-height: 175vh;
	min-height: 175dvh;
}
.wave-empty-water {
	min-height: 112vh;
	min-height: 112dvh;
	pointer-events: none;
}
.wave-descent--continuation .wave-empty-water {
	min-height: 66vh;
	min-height: 66dvh;
}
.wave-depth-cue {
	position: absolute;
	top: 72vh;
	top: 72dvh;
	left: 50%;
	width: min(520px, calc(100vw - 48px));
	margin: 0;
	transform: translateX(-50%);
	color: rgba(218,235,238,.58);
	font-size: clamp(.82rem, 1.2vw, 1rem);
	letter-spacing: .04em;
	text-shadow: 0 2px 18px rgba(0,0,0,.85);
	pointer-events: none;
	animation: wave-cue-breathe 3.6s ease-in-out infinite;
}
.wave-question-zone {
	position: relative;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	min-height: 105vh;
	min-height: 105dvh;
	padding: 18vh 24px max(46px, env(safe-area-inset-bottom));
	box-sizing: border-box;
	background: transparent;
}
.wave-descent--continuation .wave-question-zone {
	min-height: 105vh;
	min-height: 105dvh;
}
.wave-question-zone h1 {
	margin: 0 0 20px;
	color: rgba(232,242,244,.92);
	font-size: clamp(1.05rem, 2vw, 1.45rem);
	font-weight: 600;
	letter-spacing: .01em;
	text-shadow: 0 3px 24px rgba(0,0,0,.92);
}
.wave-question-zone p {
	width: min(680px, 100%);
	margin: 0 auto 26px;
	color: rgba(205,225,229,.72);
	font-size: clamp(.9rem, 1.35vw, 1.05rem);
	line-height: 1.8;
	text-shadow: 0 2px 20px rgba(0,0,0,.92);
}
.wave-room-screen #passages .wave-question-zone .choices,
.wave-room-screen #passages .wave-question-zone .choice-list {
	display: grid !important;
	grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
	gap: 12px !important;
	width: min(820px, calc(100vw - 48px)) !important;
	max-width: 820px !important;
	margin: 0 auto !important;
	overflow: visible !important;
	transform: none !important;
}
.wave-room-screen #passages .wave-question-zone .choices > br,
.wave-room-screen #passages .wave-question-zone .choice-list > br {
	display: none !important;
}
.wave-room-screen #passages .wave-question-zone .choices > a,
.wave-room-screen #passages .wave-question-zone .choice-list > .choice-button {
	width: 100% !important;
	max-width: none !important;
	min-width: 0 !important;
	min-height: 68px;
	margin: 0 !important;
	padding: 15px 18px;
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	color: rgba(236,244,245,.9);
	background: rgba(5,20,30,.46);
	border: 1px solid rgba(132,181,194,.32);
	border-radius: 10px;
	box-shadow: inset 0 1px rgba(255,255,255,.025);
	backdrop-filter: blur(5px);
	white-space: normal !important;
	word-break: keep-all;
	overflow-wrap: break-word;
	text-align: center;
	line-height: 1.45;
}
.wave-room-screen #passages .wave-question-zone .choices > a:hover,
.wave-room-screen #passages .wave-question-zone .choices > a:focus-visible,
.wave-room-screen #passages .wave-question-zone .choice-list > .choice-button:hover,
.wave-room-screen #passages .wave-question-zone .choice-list > .choice-button:focus-visible {
	color: #f4f1e7;
	background: rgba(12,35,46,.64);
	border-color: rgba(205,167,101,.62);
	box-shadow: 0 0 22px rgba(93,155,172,.13);
	outline: none;
}
.wave-room-screen .room-input-aux {
	margin: 14px auto 0;
}
.wave-room-screen .room-input-aux button {
	color: rgba(210,228,231,.78);
	background: rgba(5,20,30,.38);
	border-color: rgba(132,181,194,.25);
}
.wave-motion-active #passages {
	opacity: 0 !important;
	pointer-events: none !important;
	transition: opacity .32s ease;
}
.wave-abyss-zone {
	min-height: 100vh;
	min-height: 100dvh;
	padding-top: 24vh;
	padding-top: 24dvh;
}
.wave-depth-status {
	margin: 0 auto 18px;
	color: rgba(168,203,211,.62);
	font-size: .82rem;
	letter-spacing: .08em;
}
.wave-depth-actions {
	margin-top: 18px !important;
}
.wave-surface-return {
	position: sticky;
	top: max(20px, env(safe-area-inset-top));
	z-index: 60;
	width: max-content;
	height: 0;
	margin: 0 24px 0 auto;
	transform: translateY(20px);
}
.wave-surface-return a {
	display: inline-flex;
	align-items: center;
	min-height: 38px;
	padding: 8px 13px;
	color: rgba(241,236,222,.92);
	background: rgba(5,14,20,.72);
	border: 1px solid rgba(198,146,72,.4);
	border-radius: 999px;
	text-decoration: none;
	font-size: .82rem;
	box-shadow: 0 6px 20px rgba(0,0,0,.24);
	backdrop-filter: blur(8px);
}
.wave-surface-return a:hover,
.wave-surface-return a:focus-visible {
	color: #f2eadc;
	border-color: rgba(198,146,72,.55);
	outline: none;
}
@keyframes wave-cue-breathe {
	0%, 100% { opacity: .42; transform: translateX(-50%) translateY(0); }
	50% { opacity: .8; transform: translateX(-50%) translateY(5px); }
}
@media (max-width: 720px) {
	.wave-room-screen #passages .wave-question-zone .choices,
	.wave-room-screen #passages .wave-question-zone .choice-list {
		grid-template-columns: 1fr !important;
		width: calc(100vw - 32px) !important;
	}
	.wave-question-zone {
		padding-left: 16px;
		padding-right: 16px;
	}
	.wave-surface-return {
		margin-right: 14px;
	}
}

/*
 * The lighthouse room keeps the horizon and rotating light unobstructed.
 * Arrival, observation, and the question are staged instead of appearing as
 * one questionnaire panel over the exterior view.
 */
body.lighthouse-room-screen {
	overflow: hidden;
}
.lighthouse-room-screen #global-exit {
	display: none;
}
#lighthouse-room-return {
	position: fixed;
	z-index: 42;
	top: 1.1rem;
	right: 1.3rem;
	padding: 8px 11px;
	color: rgba(242,234,220,.76);
	background: rgba(20,15,11,.58);
	border: 1px solid rgba(198,146,72,.28);
	border-radius: 999px;
	font-size: .76rem;
	text-decoration: none;
	opacity: 0;
	pointer-events: none;
	transition: opacity .45s ease, color .18s ease, border-color .18s ease;
}
.lighthouse-interior-ready #lighthouse-room-return {
	opacity: .82;
	pointer-events: auto;
}
#lighthouse-room-return:hover,
#lighthouse-room-return:focus-visible {
	color: #f5ead8;
	border-color: rgba(222,169,82,.72);
	outline: none;
}
.lighthouse-room-screen #passages {
	position: fixed;
	inset: 0;
	z-index: 20;
	width: 100%;
	max-width: none;
	max-height: none;
	margin: 0;
	padding: 0;
	overflow: hidden;
	background: transparent;
	border: 0;
	box-shadow: none;
	pointer-events: none;
}
.lighthouse-room-screen #passages .passage {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	width: 100%;
	max-width: none;
	max-height: 44dvh;
	margin: 0;
	padding:
		46px
		clamp(18px, 4vw, 64px)
		max(14px, env(safe-area-inset-bottom));
	box-sizing: border-box;
	overflow: hidden;
	text-align: center;
	background: linear-gradient(
		to bottom,
		rgba(12,9,7,0),
		rgba(12,9,7,.54) 48%,
		rgba(12,9,7,.91) 100%
	);
	pointer-events: auto;
}
.lighthouse-room-screen #passages .lighthouse-entry-stage,
.lighthouse-room-screen #passages .lighthouse-lens-stage {
	width: min(1220px, 100%);
	margin: 0 auto;
}
.lighthouse-scene-copy,
.lighthouse-horizon-question {
	opacity: 0;
	transform: translateY(10px);
	pointer-events: none;
	transition: opacity .7s ease, transform .7s ease;
}
.lighthouse-interior-ready:not(.lighthouse-question-ready) .lighthouse-scene-copy {
	opacity: 1;
	transform: translateY(0);
}
.lighthouse-question-ready .lighthouse-scene-copy {
	display: none;
}
.lighthouse-question-ready .lighthouse-horizon-question {
	opacity: 1;
	transform: translateY(0);
	pointer-events: auto;
}
.lighthouse-room-screen #passages h1,
.lighthouse-room-screen #passages h2 {
	margin: 0 auto 18px;
	color: #f2eadc;
	font-size: clamp(1.05rem, 2vw, 1.45rem);
	line-height: 1.45;
	word-break: keep-all;
}
.lighthouse-room-screen #passages p {
	width: min(760px, 100%);
	margin: 0 auto;
	color: rgba(225,214,196,.78);
	font-size: clamp(.84rem, 1.25vw, 1rem);
	line-height: 1.7;
	word-break: keep-all;
}
.lighthouse-room-screen #passages .choices,
.lighthouse-room-screen #passages .choice-list {
	width: min(880px, calc(100vw - 36px)) !important;
	margin: 20px auto 0 !important;
	display: flex !important;
	flex-wrap: wrap !important;
	justify-content: center !important;
	gap: 10px !important;
	overflow: visible !important;
}
.lighthouse-room-screen #passages .choices > br,
.lighthouse-room-screen #passages .choice-list > br {
	display: none;
}
.lighthouse-room-screen #passages .choices > a,
.lighthouse-room-screen #passages .choices > button,
.lighthouse-room-screen #passages .choice-list > .choice-button {
	flex: 0 1 270px !important;
	width: auto !important;
	max-width: 280px;
	min-width: 0 !important;
	min-height: 58px;
	margin: 0 !important;
	padding: 12px 16px;
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	color: var(--ui-text);
	background: rgba(22,17,13,.82);
	border: 1px solid var(--ui-border);
	border-radius: 10px;
	white-space: normal !important;
	word-break: keep-all;
	text-align: center;
	text-decoration: none;
}
.lighthouse-room-screen #passages .choices > a:hover,
.lighthouse-room-screen #passages .choices > a:focus-visible,
.lighthouse-room-screen #passages .choices > button:hover,
.lighthouse-room-screen #passages .choices > button:focus-visible {
	background: var(--ui-surface-hover);
	border-color: var(--ui-accent);
	outline: none;
}
.lighthouse-room-screen .room-input-aux {
	margin-top: 10px;
}
.lighthouse-room-screen .room-input-aux button {
	min-height: 0;
	padding: 8px 12px;
	color: var(--ui-muted);
	background: transparent;
	border-color: rgba(198,146,72,.24);
}
.lighthouse-lens-stage {
	opacity: 0;
	transform: translateY(10px);
	animation: lighthouse-question-in .72s .15s ease forwards;
}
@keyframes lighthouse-question-in {
	to { opacity: 1; transform: translateY(0); }
}
@media (max-height: 760px) {
	.lighthouse-room-screen #passages .passage {
		max-height: 56dvh;
		padding-top: 32px;
		padding-bottom: max(10px, env(safe-area-inset-bottom));
	}
	.lighthouse-room-screen #passages .choices > a,
	.lighthouse-room-screen #passages .choices > button,
	.lighthouse-room-screen #passages .choice-list > .choice-button {
		min-height: 48px;
		padding: 9px 12px;
	}
}
@media (max-width: 720px) {
	.lighthouse-room-screen #passages .passage {
		max-height: 52dvh;
		padding-left: 14px;
		padding-right: 14px;
	}
	.lighthouse-room-screen #passages .choices > a,
	.lighthouse-room-screen #passages .choices > button,
	.lighthouse-room-screen #passages .choice-list > .choice-button {
		flex-basis: calc(50% - 5px) !important;
		max-width: none;
	}
}


:: Story JavaScript [script]
/* BEGIN EMBEDDED BABYLON WEATHER STATION ZIP 8 FINAL */
window.WEATHER_STATION_IFRAME_B64 = "";
/* END EMBEDDED BABYLON WEATHER STATION ZIP 8 FINAL */
setup.weatherStation = null;
setup.waveScrollCleanup = null;
setup.lighthouseExitPending = false;
setup.lighthousePost = function (payload) {
	var frame = setup.weatherStation && setup.weatherStation.frame;
	if (!frame || !frame.contentWindow) return false;
	frame.contentWindow.postMessage(payload, "*");
	return true;
};
setup.startLighthouseInterior = function () {
	document.body.classList.add("lighthouse-arriving");
	document.body.classList.remove("lighthouse-interior-ready", "lighthouse-question-ready");
	var attempts = 0;
	var send = function () {
		attempts += 1;
		var sent = setup.lighthousePost({
			type:"lighthouse-view",
			view:"interior"
		});
		if ((!sent || attempts < 3) && passage() === "등대 진입") {
			setTimeout(send, attempts === 1 ? 650 : 1200);
		}
	};
	setTimeout(send, 80);
};
setup.setLighthouseLensSpeed = function (mode, nextPassage) {
	if (setup.audio) {
		setup.audio.setLighthouseRotation(mode);
		setup.audio.playSfx("lighthouse");
	}
	setup.lighthousePost({
		type:"lighthouse-lens-speed",
		mode:String(mode || "current")
	});
	setTimeout(function () {
		Engine.play(nextPassage || "부분의 몸 감각");
	}, 420);
};
setup.exitLighthouseRoom = function () {
	if (setup.lighthouseExitPending) return;
	setup.lighthouseExitPending = true;
	if (setup.audio) {
		setup.audio.setReadingActive(false);
		setup.audio.setScene("hub");
	}
	document.body.classList.remove("lighthouse-question-ready");
	setup.lighthousePost({
		type:"lighthouse-view",
		view:"exit"
	});
	setTimeout(function () {
		if (!setup.lighthouseExitPending) return;
		setup.lighthouseExitPending = false;
		Engine.play("관측소 허브");
	}, 5200);
};
setup.bindWaveScroll = function (startDepth, endDepth) {
	if (typeof setup.waveScrollCleanup === "function") {
		setup.waveScrollCleanup();
		setup.waveScrollCleanup = null;
	}
	var scroller = document.getElementById("passages");
	if (!scroller) return;
	var frame = setup.weatherStation && setup.weatherStation.frame;
	var start = Math.max(0, Math.min(1, Number(startDepth || 0)));
	var end = Math.max(start, Math.min(1, Number(endDepth == null ? start : endDepth)));
	var sendDepth = function () {
		var limit = Math.max(1, scroller.scrollHeight - scroller.clientHeight);
		var progress = Math.max(0, Math.min(1, scroller.scrollTop / limit));
		var depth = start + (end - start) * progress;
		if (frame && frame.contentWindow) {
			frame.contentWindow.postMessage({
				type: "wave-scroll-depth",
				depth: depth
			}, "*");
		}
	};
	scroller.scrollTop = 0;
	scroller.addEventListener("scroll", sendDepth, { passive:true });
	window.addEventListener("resize", sendDepth);
	setup.waveScrollCleanup = function () {
		scroller.removeEventListener("scroll", sendDepth);
		window.removeEventListener("resize", sendDepth);
	};
	window.requestAnimationFrame(sendDepth);
};
setup.waveMotionSequence = 0;
setup.waveMotionPending = null;
setup.waveDepthRatio = function (depth) {
	var ratios = [0.12, 0.39, 0.66, 0.90];
	return ratios[Math.max(0, Math.min(3, Number(depth || 0)))] || ratios[0];
};
setup.waveAbyssProfile = function () {
	var variables = State.variables;
	var drive = String(variables.waveDrive || "unclear");
	var fear = String(variables.waveStopFear || "unknown");
	var initialId = String(
		(variables.stateBehaviorSelection && variables.stateBehaviorSelection.id) ||
		""
	);
	if (
		initialId === "keep_moving" &&
		(drive === "mixed" || drive === "unclear")
	) {
		drive = "chased";
	}
	var profile = {
		drive:drive,
		fear:fear,
		depth:Math.max(0, Math.min(3, Number(variables.waveDepth || 0))),
		turbulence:0.26,
		visibility:0.62,
		currentSpeed:0.28,
		lightPulse:0.24,
		soundPressure:0.28
	};
	if (drive === "desire") {
		profile.turbulence = 0.16;
		profile.visibility = 0.82;
		profile.currentSpeed = 0.18;
	} else if (drive === "mixed") {
		profile.turbulence = 0.42;
		profile.visibility = 0.62;
		profile.currentSpeed = 0.48;
	} else if (drive === "pressure") {
		profile.turbulence = 0.52;
		profile.visibility = 0.56;
		profile.currentSpeed = 0.62;
		profile.soundPressure = 0.58;
	} else if (drive === "chased") {
		profile.turbulence = 0.68;
		profile.visibility = 0.48;
		profile.currentSpeed = 0.82;
		profile.lightPulse = 0.54;
		profile.soundPressure = 0.70;
	} else {
		profile.turbulence = 0.30;
		profile.visibility = 0.30;
		profile.currentSpeed = 0.26;
	}
	if (fear === "fallingBehind" || fear === "missingOut") {
		profile.lightPulse = Math.max(profile.lightPulse, 0.78);
	} else if (fear === "failure" || fear === "disappointingOthers") {
		profile.lightPulse = Math.max(profile.lightPulse, 0.66);
		profile.soundPressure = Math.max(profile.soundPressure, 0.48);
	} else if (fear === "overwhelm") {
		profile.turbulence = Math.max(profile.turbulence, 0.78);
		profile.visibility = Math.min(profile.visibility, 0.44);
	} else if (fear === "stillness") {
		profile.currentSpeed = Math.min(profile.currentSpeed, 0.16);
		profile.soundPressure = Math.max(profile.soundPressure, 0.82);
	}
	variables.waveAbyssState = profile;
	return profile;
};
setup.syncWaveAbyssState = function () {
	var profile = setup.waveAbyssProfile();
	if (setup.audio) setup.audio.setAbyssState(profile);
	setup.lighthousePost({
		type:"wave-abyss-config",
		state:profile
	});
	return profile;
};
setup.afterWaveDrive = function () {
	setup.syncWaveAbyssState();
	var drive = String(State.variables.waveDrive || "unclear");
	if (drive === "desire") {
		Engine.play("파도 원하는 힘");
	} else if (drive === "unclear") {
		Engine.play("파도 구별하기");
	} else {
		Engine.play("파도 멈춤의 불안");
	}
};
setup.playWaveDepthTransition = function (action, targetDepth, nextPassage, options) {
	options = options || {};
	if (setup.waveMotionPending && setup.waveMotionPending.timer) {
		clearTimeout(setup.waveMotionPending.timer);
	}
	var depth = Math.max(0, Math.min(3, Number(targetDepth || 0)));
	State.variables.waveDepth = depth;
	var profile = setup.syncWaveAbyssState();
	profile.depth = depth;
	State.variables.waveAbyssState = profile;
	if (setup.audio) {
		setup.audio.setReadingActive(false);
		setup.audio.setAbyssState(profile);
		setup.audio.playSfx(
			String(action || "") === "surface" || String(action || "") === "ascend"
				? "surface"
				: "submerge"
		);
		setup.audio.setScene(depth > 0 ? "abyss" : "wave");
	}
	var requestId = "wave-depth-" + (++setup.waveMotionSequence) + "-" + Date.now();
	document.body.classList.add("wave-motion-active");
	var finish = function () {
		var pending = setup.waveMotionPending;
		if (!pending || pending.requestId !== requestId) return;
		clearTimeout(pending.timer);
		setup.waveMotionPending = null;
		document.body.classList.remove("wave-motion-active");
		if (setup.audio) setup.audio.setReadingActive(true);
		if (options.completeRoom) setup.completeRoom("wave");
		Engine.play(nextPassage || (depth > 0 ? "파도 심연" : "파도 이름"));
	};
	setup.waveMotionPending = {
		requestId:requestId,
		finish:finish,
		timer:setTimeout(finish, Number(options.timeout || 6200))
	};
	var sent = setup.lighthousePost({
		type:"wave-depth-transition",
		action:String(action || "descend"),
		depth:depth,
		depthRatio:setup.waveDepthRatio(depth),
		state:profile,
		requestId:requestId
	});
	if (!sent) setTimeout(finish, 120);
};
setup.finishWaveRoom = function (distance) {
	var variables = State.variables;
	var cleanDistance = String(distance || "현재 감당할 수 있는 깊이").trim();
	variables.waveDistance = cleanDistance;
	variables.wavePermission = "내가 정한 깊이까지만 살펴보기";
	variables.roomPermissions.wave = variables.wavePermission;
	variables.roomDistances.wave = cleanDistance;
	variables.roomConditions.wave = "움직임을 없애지 않고 내가 정한 깊이에서 바라보기";
	setup.rememberRoom("wave", variables.roomProtections.wave, cleanDistance);
	setup.completeRoom("wave");
	Engine.play("관측소 허브");
};
setup.fogMotionSequence = 0;
setup.fogMotionPending = null;
setup.playFogBoatMotion = function (motion, nextPassage, options) {
	options = options || {};
	if (setup.fogMotionPending && setup.fogMotionPending.timer) {
		clearTimeout(setup.fogMotionPending.timer);
	}
	var frame = setup.weatherStation && setup.weatherStation.frame;
	var requestId = "fog-motion-" + (++setup.fogMotionSequence) + "-" + Date.now();
	document.body.classList.add("fog-motion-active");
	if (setup.audio) {
		setup.audio.setReadingActive(false);
		if (motion === "toward-light") setup.audio.playSfx("fogReveal");
		if (motion === "return") setup.audio.setScene("hub");
	}
	var finish = function () {
		var pending = setup.fogMotionPending;
		if (!pending || pending.requestId !== requestId) return;
		clearTimeout(pending.timer);
		setup.fogMotionPending = null;
		document.body.classList.remove("fog-motion-active");
		if (setup.audio) setup.audio.setReadingActive(true);
		if (options.completeRoom) setup.completeRoom("fog");
		Engine.play(nextPassage || "안개 이름 역할");
	};
	setup.fogMotionPending = {
		requestId:requestId,
		motion:motion,
		finish:finish,
		timer:setTimeout(finish, Number(options.timeout || 4200))
	};
	if (frame && frame.contentWindow) {
		frame.contentWindow.postMessage({
			type:"fog-boat-motion",
			motion:motion,
			requestId:requestId
		}, "*");
	} else {
		setTimeout(finish, 120);
	}
};
setup.fogDisplayName = function () {
	var inputs = setup.ensureRoomInputs();
	var name = String(
		(inputs.fog && inputs.fog.partName) ||
		(State.variables.partNames || {}).fog ||
		""
	).trim();
	return name && name !== "가려두는 부분"
		? name
		: "아직 이름 붙지 않은 부분";
};
setup.saveFogName = function (name) {
	var clean = String(name || "").trim();
	var inputs = setup.ensureRoomInputs();
	inputs.fog.partName = clean;
	State.variables.partNames.fog = clean;
	setup.persistRelationships();
};
setup.fogNameSuggestions = function () {
	var variables = State.variables;
	var role = String(variables.fogNameRole || "").trim();
	var image = String(variables.fogNameImage || "").trim();
	var escapeMode = String(variables.fogEscapeMode || "");
	var relief = String(variables.fogReliefNeed || "");
	var suggestions = [];
	var add = function (value) {
		value = String(value || "").trim();
		if (value && suggestions.indexOf(value) === -1) suggestions.push(value);
	};
	if (role && role !== "아직 잘 모르겠다" && image && image !== "내 말로 적기") {
		add(role + " " + image);
	}
	if (/연락|혼자|거리/.test(escapeMode) || /아무도 건드리지 않는 거리/.test(relief)) {
		add("거리를 지키는 부분");
		add("잠시 멀어지는 배");
	}
	if (/숨을 돌리고/.test(relief) || /숨 돌릴 시간을/.test(role)) {
		add("숨 돌릴 시간을 만드는 안개");
	}
	if (/느끼지/.test(escapeMode + relief) || /감각을 흐리게/.test(role)) {
		add("감각을 흐리게 하는 안개");
	}
	if (/결정하지/.test(relief) || /아무것도 하지 않아도/.test(role)) {
		add("아무것도 하지 않아도 되는 방");
	}
	if (image === "문이 닫힌 선실") add("나를 숨겨주는 선실");
	if (image === "모래 위의 배") add("안개 속에 머무는 배");
	if (image === "움직이지 않는 닻") add("잠시 멈추게 하는 닻");
	if (image === "멀리 떨어진 섬") add("혼자 머물 수 있는 섬");
	if (image === "비어 있는 방") add("아무도 들어오지 않는 방");
	add("안개 속 대피소");
	add("잠시 멀어지는 배");
	add("숨 돌릴 시간을 만드는 안개");
	add("거리를 지키는 부분");
	return suggestions.slice(0, 6);
};
setup.openFogNameEditor = function (initialValue) {
	var host = document.querySelector(".custom-input-host");
	var stage = document.querySelector(".room-input-stage");
	if (!host || !stage) return;
	stage.hidden = true;
	host.innerHTML = "";
	var panel = document.createElement("div");
	panel.className = "custom-input-panel";
	var label = document.createElement("label");
	label.setAttribute("for", "fogNameEditor");
	label.textContent = "이 부분을 부를 이름을 적어주세요.";
	var textarea = document.createElement("textarea");
	textarea.id = "fogNameEditor";
	textarea.rows = 2;
	textarea.maxLength = 48;
	textarea.value = String(initialValue || "");
	var actions = document.createElement("div");
	actions.className = "custom-input-actions";
	var back = document.createElement("button");
	back.type = "button";
	back.className = "secondary";
	back.textContent = "돌아가기";
	back.addEventListener("click", function () {
		setup.setInputFocus(false);
		host.innerHTML = "";
		stage.hidden = false;
	});
	var save = document.createElement("button");
	save.type = "button";
	save.className = "primary";
	save.textContent = "이 이름을 남긴다";
	save.addEventListener("click", function () {
		var value = textarea.value.trim();
		if (!value) {
			textarea.focus();
			return;
		}
		setup.saveFogName(value);
		setup.setInputFocus(false);
		Engine.play("안개 이름 확인");
	});
	textarea.addEventListener("focus", function () { setup.setInputFocus(true); });
	textarea.addEventListener("blur", function () { setup.setInputFocus(false); });
	actions.appendChild(back);
	actions.appendChild(save);
	panel.appendChild(label);
	panel.appendChild(textarea);
	panel.appendChild(actions);
	host.appendChild(panel);
	setTimeout(function () { textarea.focus(); }, 0);
};
setup.renderFogNameSuggestions = function () {
	var container = document.querySelector(".fog-name-suggestions");
	var actions = document.querySelector(".fog-name-secondary-actions");
	if (!container || !actions) return;
	container.replaceChildren();
	actions.replaceChildren();
	setup.fogNameSuggestions().forEach(function (name) {
		var card = document.createElement("div");
		card.className = "fog-name-suggestion";
		var choose = document.createElement("button");
		choose.type = "button";
		choose.className = "fog-name-suggestion__choose";
		choose.textContent = name;
		choose.addEventListener("click", function () {
			setup.saveFogName(name);
			Engine.play("안개 이름 확인");
		});
		var edit = document.createElement("button");
		edit.type = "button";
		edit.className = "fog-name-suggestion__edit";
		edit.textContent = "조금 고치기";
		edit.addEventListener("click", function () {
			setup.openFogNameEditor(name);
		});
		card.appendChild(choose);
		card.appendChild(edit);
		container.appendChild(card);
	});
	var custom = document.createElement("button");
	custom.type = "button";
	custom.textContent = "내 말로 새로 적는다";
	custom.addEventListener("click", function () { setup.openFogNameEditor(""); });
	var skip = document.createElement("button");
	skip.type = "button";
	skip.textContent = "아직 이름을 붙이지 않는다";
	skip.addEventListener("click", function () {
		setup.saveFogName("");
		Engine.play("안개 이름 확인");
	});
	actions.appendChild(custom);
	actions.appendChild(skip);
};

if (!setup.roomSelectionBound) {
	setup.roomSelectionBound = true;
	window.addEventListener("message", function (event) {
		var data = event.data || {};
		if (data.type === "lighthouse-interior-ready") {
			if (!setup.weatherStation || !setup.weatherStation.frame || event.source !== setup.weatherStation.frame.contentWindow) return;
			if (State.variables.currentRoom !== "lighthouse") return;
			document.body.classList.remove("lighthouse-arriving");
			document.body.classList.add("lighthouse-interior-ready");
			if (setup.audio) {
				setup.audio.setScene("lighthouse");
				setup.audio.setReadingActive(false);
			}
			return;
		}
		if (data.type === "lighthouse-observation-ready") {
			if (!setup.weatherStation || !setup.weatherStation.frame || event.source !== setup.weatherStation.frame.contentWindow) return;
			if (passage() !== "등대 진입") return;
			document.body.classList.add("lighthouse-question-ready");
			if (setup.audio) setup.audio.setReadingActive(true);
			return;
		}
		if (data.type === "lighthouse-exit-complete") {
			if (!setup.weatherStation || !setup.weatherStation.frame || event.source !== setup.weatherStation.frame.contentWindow) return;
			if (setup.lighthouseExitPending) {
				setup.lighthouseExitPending = false;
				if (setup.audio) setup.audio.setScene("hub");
				Engine.play("관측소 허브");
			}
			return;
		}
		if (data.type === "fog-boat-motion-complete") {
			if (
				setup.weatherStation &&
				setup.weatherStation.frame &&
				event.source === setup.weatherStation.frame.contentWindow &&
				setup.fogMotionPending &&
				setup.fogMotionPending.requestId === data.requestId
			) {
				setup.fogMotionPending.finish();
			}
			return;
		}
		if (data.type === "wave-depth-transition-complete") {
			if (
				setup.weatherStation &&
				setup.weatherStation.frame &&
				event.source === setup.weatherStation.frame.contentWindow &&
				setup.waveMotionPending &&
				setup.waveMotionPending.requestId === data.requestId
			) {
				setup.waveMotionPending.finish();
			}
			return;
		}
		if (data.type === "twine-room-return" && data.room === "wave") {
			if (
				setup.weatherStation &&
				setup.weatherStation.frame &&
				event.source === setup.weatherStation.frame.contentWindow &&
				State.variables.currentRoom === "wave"
			) {
				if (setup.audio) {
					setup.audio.setScene("hub");
					setup.audio.playSfx("surface");
				}
				Engine.play("관측소 허브");
			}
			return;
		}
		if (data.type === "twine-room-rename") {
			if (!setup.weatherStation || !setup.weatherStation.frame || event.source !== setup.weatherStation.frame.contentWindow) return;
			if (passage() !== "관측소 허브") return;
			if (["lighthouse","wave","fog"].indexOf(data.room) === -1) return;
			State.variables.renameRoom = data.room;
			State.variables.currentRoom = data.room;
			State.variables.sceneMode = "hub";
			Engine.play(data.room === "fog" ? "안개 이름 역할" : "이름 바꾸기");
			return;
		}
		if (data.type !== "twine-room-select") return;
		if (!setup.weatherStation || !setup.weatherStation.frame || event.source !== setup.weatherStation.frame.contentWindow) return;
		if (passage() !== "관측소 허브") return;
		var routes = {
			lighthouse: "등대 진입",
			wave: "파도 진입",
			fog: "안개 진입"
		};
		if (routes[data.object]) {
			if (setup.audio) {
				setup.audio.setReadingActive(false);
				setup.audio.playSfx("roomEnter");
				if (data.object === "wave") {
					setup.audio.playSfx("drawerOpen");
					setup.audio.playSfx("submerge");
				}
				if (data.object === "fog") setup.audio.playSfx("fogReveal");
				if (data.object === "lighthouse") setup.audio.playSfx("lighthouse");
				setup.audio.setScene(data.object);
			}
			Engine.play(routes[data.object]);
		}
	});
}
if (!setup.storyDragPreventionBound) {
	setup.storyDragPreventionBound = true;
	document.addEventListener("dragstart", function (event) {
		var target = event.target;
		if (!target || !target.closest) return;
		if (target.closest("input, textarea, [contenteditable='true']")) return;
		if (
			target.closest(".story-ui") ||
			target.closest(".room-ui") ||
			target.closest(".hub-ui") ||
			target.closest(".observation-ui #passages") ||
			target.tagName === "CANVAS"
		) {
			event.preventDefault();
		}
	});
}

setup.weatherKeys = ["fog", "wave", "rain", "wind", "cloud", "light"];
setup.clampWeather = function (value) {
	return Math.max(0, Math.min(1, Number(value) || 0));
};
setup.emptyWeatherVector = function () {
	return { fog:0, rain:0, wave:0, wind:0, cloud:0, light:0 };
};
setup.emptyRoomPending = function (room) {
	if (room === "lighthouse") return { wind:0, light:0, cloud:0 };
	if (room === "wave") return { wave:0, rain:0, current:0 };
	if (room === "fog") return { fog:0, light:0, wind:0 };
	return {};
};
setup.ensureWeatherContributions = function () {
	var variables = State.variables;
	var defaults = { fog:.15, rain:0, wave:.2, wind:.15, cloud:.25, light:.55 };
	if (!variables.weatherContributions) {
		variables.weatherContributions = {
			base: Object.assign({}, variables.weatherState || defaults),
			lighthouse: setup.emptyWeatherVector(),
			wave: setup.emptyWeatherVector(),
			fog: setup.emptyWeatherVector()
		};
	}
	["base","lighthouse","wave","fog"].forEach(function (source) {
		variables.weatherContributions[source] = Object.assign(
			setup.emptyWeatherVector(),
			variables.weatherContributions[source] || {}
		);
	});
	if (!variables.roomPending) {
		variables.roomPending = {
			lighthouse: setup.emptyRoomPending("lighthouse"),
			wave: setup.emptyRoomPending("wave"),
			fog: setup.emptyRoomPending("fog")
		};
	}
	["lighthouse","wave","fog"].forEach(function (room) {
		variables.roomPending[room] = Object.assign(
			setup.emptyRoomPending(room),
			variables.roomPending[room] || {}
		);
	});
	return variables.weatherContributions;
};
setup.recomputeWeather = function () {
	var variables = State.variables;
	var contributions = setup.ensureWeatherContributions();
	var next = setup.emptyWeatherVector();
	setup.weatherKeys.forEach(function (key) {
		next[key] = setup.clampWeather(
			Number(contributions.base[key] || 0) +
			Number(contributions.lighthouse[key] || 0) +
			Number(contributions.wave[key] || 0) +
			Number(contributions.fog[key] || 0)
		);
	});
	variables.weatherState = next;
	setup.updateWeatherLabel();
	if (setup.audio) setup.audio.setWeather(next);
	if (setup.weatherStation && setup.weatherStation.sync) {
		setTimeout(setup.weatherStation.sync, 0);
	}
	return next;
};
setup.updateWeatherLabel = function () {
	var state = State.variables.weatherState || {};
	var labels = [];
	if ((state.fog || 0) >= .68 && (state.light || 0) >= .50) labels.push("안개 너머 등대 빛");
	else if ((state.light || 0) >= .72 && (state.cloud || 0) < .48 && (state.fog || 0) < .48) labels.push("선명한 햇빛");
	else if ((state.light || 0) >= .52 && (state.fog || 0) < .62) labels.push("옅은 햇빛");
	if ((state.fog || 0) >= .68) labels.push("짙은 안개");
	else if ((state.fog || 0) >= .36) labels.push("옅은 안개");
	if ((state.wave || 0) >= .68) labels.push("높은 파도");
	else if ((state.wave || 0) >= .36) labels.push("출렁이는 물결");
	if ((state.rain || 0) >= .62) labels.push("이어지는 비");
	else if ((state.rain || 0) >= .24) labels.push("간헐적인 비");
	if ((state.wind || 0) >= .68) labels.push("강한 바람");
	else if ((state.wind || 0) >= .38) labels.push("긴장된 바람");
	if ((state.cloud || 0) >= .68) labels.push("두꺼운 구름");
	else if ((state.cloud || 0) >= .38) labels.push("낮은 구름");
	State.variables.weatherLabel = labels.length ? labels.join(" · ") : "잔잔하고 열린 공기";
	return State.variables.weatherLabel;
};
setup.applyWeatherDelta = function (delta) {
	var variables = State.variables;
	var contributions = setup.ensureWeatherContributions();
	var room = variables.currentRoom;
	var roomKeys = {
		lighthouse:["wind","light","cloud"],
		wave:["wave","rain","current"],
		fog:["fog","light","wind"]
	};
	if (roomKeys[room]) {
		var pending = variables.roomPending[room];
		Object.keys(delta || {}).forEach(function (key) {
			if (roomKeys[room].indexOf(key) === -1) return;
			pending[key] = Math.max(-1, Math.min(1,
				Number(pending[key] || 0) + Number(delta[key] || 0)
			));
		});
		return pending;
	}
	Object.keys(delta || {}).forEach(function (key) {
		if (setup.weatherKeys.indexOf(key) === -1) return;
		contributions.base[key] = setup.clampWeather(
			Number(contributions.base[key] || 0) + Number(delta[key] || 0)
		);
	});
	return setup.recomputeWeather();
};
setup.adjustWeather = setup.applyWeatherDelta;
setup.permissionWeather = function (allowed) {
	var mode = State.variables.weatherMode;
	var delta = allowed ? { light:.16 } : { light:.1 };
	if (allowed) {
		if (mode === "fog") delta.fog = -.3;
		else if (mode === "wave") delta.wave = -.3;
		else if (mode === "rain") delta.rain = -.24;
		else if (mode === "watch") delta.wind = -.3;
		else if (mode === "numb" || mode === "cloud") delta.cloud = -.22;
	}
	setup.adjustWeather(delta);
};
setup.weatherControlMeta = {
	fog:{ label:"안개의 밀도", low:"또렷함", high:"가려짐" },
	wave:{ label:"파도의 높이", low:"낮음", high:"높음" },
	rain:{ label:"비의 양", low:"없음", high:"많음" },
	wind:{ label:"바람의 세기", low:"고요함", high:"강함" },
	cloud:{ label:"구름의 무게", low:"가벼움", high:"무거움" },
	light:{ label:"빛이 닿는 범위", low:"좁음", high:"넓음" }
};
setup.weatherVectorSummary = function (vector) {
	var previous = State.variables.weatherState;
	State.variables.weatherState = Object.assign(setup.emptyWeatherVector(), vector || {});
	var summary = setup.updateWeatherLabel();
	State.variables.weatherState = previous;
	setup.updateWeatherLabel();
	return summary;
};
setup.previewWeather = function (room, pending) {
	var variables = State.variables;
	var contributions = setup.ensureWeatherContributions();
	var next = setup.emptyWeatherVector();
	setup.weatherKeys.forEach(function (key) {
		next[key] = setup.clampWeather(
			Number(contributions.base[key] || 0) +
			Number(room === "lighthouse" ? pending[key] : contributions.lighthouse[key] || 0) +
			Number(room === "wave" ? pending[key] : contributions.wave[key] || 0) +
			Number(room === "fog" ? pending[key] : contributions.fog[key] || 0)
		);
	});
	variables.weatherState = next;
	setup.updateWeatherLabel();
	if (setup.weatherStation && setup.weatherStation.sync) setup.weatherStation.sync();
	return next;
};
setup.openWeatherBuilder = function (mode, room) {
	var host = document.querySelector(".weather-builder-host");
	var stage = document.querySelector(".weather-builder-stage");
	if (!host || !stage) return;
	var variables = State.variables;
	var contributions = setup.ensureWeatherContributions();
	var isRoom = mode === "room";
	var isFinal = mode === "final";
	var keys = isRoom
		? (room === "lighthouse" ? ["wind","light","cloud"]
			: room === "wave" ? ["wave","rain"]
			: ["fog","light","wind"])
		: setup.weatherKeys.slice();
	var source = isRoom
		? Object.assign({}, variables.roomPending[room] || setup.emptyRoomPending(room))
		: Object.assign({}, isFinal ? variables.weatherState : contributions.base);
	var original = Object.assign({}, variables.weatherState);
	stage.hidden = true;
	host.innerHTML = "";

	var panel = document.createElement("div");
	panel.className = "weather-builder-stage";
	var title = document.createElement("h1");
	title.textContent = isRoom
		? "이 부분이 지금 나타나는 모습을 조정해보세요."
		: isFinal
			? "이 날씨와 함께 있을 수 있는 위치에서 다시 바라봅니다."
			: "지금의 상태와 닮은 날씨를 만들어보세요.";
	var description = document.createElement("p");
	description.textContent = isRoom
		? "좋게 바꾸는 조작이 아닙니다. 이 방의 움직임이 지금과 닮아 보이도록 맞춰보세요."
		: isFinal
			? "날씨가 사라질 필요는 없습니다. 오늘 알게 된 내용을 반영해 지금 보이는 정도를 조정하세요."
			: "안개, 파도, 비, 바람, 구름과 빛을 움직여 지금 느껴지는 상태에 가깝게 맞춰보세요.";
	var controls = document.createElement("div");
	controls.className = "weather-controls";

	function applyPreview() {
		if (isRoom) {
			variables.roomPending[room] = Object.assign(
				setup.emptyRoomPending(room),
				source
			);
			setup.previewWeather(room, variables.roomPending[room]);
			return;
		}
		var absolute = Object.assign(setup.emptyWeatherVector(), source);
		variables.weatherState = absolute;
		if (!isFinal) contributions.base = Object.assign({}, absolute);
		setup.updateWeatherLabel();
		if (setup.weatherStation && setup.weatherStation.sync) setup.weatherStation.sync();
	}

	keys.forEach(function (key) {
		var meta = setup.weatherControlMeta[key];
		var card = document.createElement("label");
		card.className = "weather-control";
		var top = document.createElement("span");
		top.className = "weather-control__top";
		var name = document.createElement("strong");
		name.textContent = meta.label;
		var output = document.createElement("output");
		var input = document.createElement("input");
		input.type = "range";
		input.min = isRoom ? "-0.4" : "0";
		input.max = isRoom ? "0.4" : "1";
		input.step = ".01";
		input.value = String(Number(source[key] || 0));
		function updateOutput() {
			var value = Number(input.value);
			source[key] = value;
			if (isRoom) {
				output.textContent = value > .03 ? "더 강하게" : value < -.03 ? "더 약하게" : "그대로";
			} else {
				output.textContent = Math.round(value * 100) + "%";
			}
			applyPreview();
		}
		input.addEventListener("input", updateOutput);
		top.appendChild(name);
		top.appendChild(output);
		card.appendChild(top);
		card.appendChild(input);
		controls.appendChild(card);
		updateOutput();
	});

	var actions = document.createElement("div");
	actions.className = "weather-builder-actions";
	var save = document.createElement("button");
	save.type = "button";
	save.textContent = isRoom ? "이 방의 관측으로 남긴다" : isFinal ? "이 위치에서 기록한다" : "이 날씨로 관측을 시작한다";
	save.addEventListener("click", function () {
		if (isRoom) {
			variables.roomPending[room] = Object.assign(
				setup.emptyRoomPending(room),
				source
			);
			setup.completeRoom(room);
			Engine.play("관측소 허브");
			return;
		}
		var snapshot = Object.assign(setup.emptyWeatherVector(), source);
		variables.weatherState = snapshot;
		if (isFinal) {
			variables.weatherRelated = Object.assign({}, snapshot);
			Engine.play("날씨 기록");
		} else {
			contributions.base = Object.assign({}, snapshot);
			variables.weatherObserved = Object.assign({}, snapshot);
			setup.recomputeWeather();
			Engine.play("몸의 자리");
		}
	});
	actions.appendChild(save);
	panel.appendChild(title);
	panel.appendChild(description);
	panel.appendChild(controls);
	panel.appendChild(actions);
	host.appendChild(panel);
};
setup.openReflectionInput = function (field, question, nextPassage) {
	var host = document.querySelector(".custom-input-host");
	var stage = document.querySelector(".room-input-stage");
	if (!host || !stage) return;
	stage.hidden = true;
	host.innerHTML = "";
	var panel = document.createElement("div");
	panel.className = "custom-input-panel";
	var label = document.createElement("label");
	label.setAttribute("for", "reflectionInput");
	label.textContent = question;
	var textarea = document.createElement("textarea");
	textarea.id = "reflectionInput";
	textarea.rows = 3;
	textarea.maxLength = 280;
	textarea.value = String(State.variables[field] || "");
	var actions = document.createElement("div");
	actions.className = "custom-input-actions";
	var back = document.createElement("button");
	back.type = "button";
	back.className = "secondary";
	back.textContent = "돌아가기";
	back.addEventListener("click", function () {
		setup.setInputFocus(false);
		host.innerHTML = "";
		stage.hidden = false;
	});
	var save = document.createElement("button");
	save.type = "button";
	save.className = "primary";
	save.textContent = "이 문장을 남긴다";
	save.addEventListener("click", function () {
		var text = textarea.value.trim();
		if (!text) { textarea.focus(); return; }
		State.variables[field] = text;
		setup.setInputFocus(false);
		Engine.play(nextPassage);
	});
	textarea.addEventListener("focus", function () { setup.setInputFocus(true); });
	textarea.addEventListener("blur", function () { setup.setInputFocus(false); });
	actions.appendChild(back);
	actions.appendChild(save);
	panel.appendChild(label);
	panel.appendChild(textarea);
	panel.appendChild(actions);
	host.appendChild(panel);
	window.setTimeout(function () { textarea.focus(); }, 0);
};
setup.bindDiscoveryInput = function (kind) {
	var textarea = document.getElementById("discovery-custom-input");
	var error = document.getElementById("input-error");
	var back = document.getElementById("discovery-input-back");
	var save = document.getElementById("discovery-input-save");
	if (!textarea || !error || !back || !save) return;
	var isState = kind === "state";
	var variables = State.variables;
	textarea.value = String(
		isState ? (variables.customState || "") : (variables.customBehavior || "")
	);
	back.addEventListener("click", function () {
		setup.setInputFocus(false);
		Engine.play(isState ? "들어다보기" : "상태에서의 행동");
	});
	save.addEventListener("click", function () {
		var text = textarea.value.trim();
		if (!text) {
			error.textContent = isState
				? "지금의 상태를 적어주세요."
				: "주로 어떻게 하는지 적어주세요.";
			textarea.focus();
			return;
		}
		error.textContent = "";
		if (isState) {
			variables.customState = text;
			variables.stateSelection = { id:"custom", label:text };
			variables.movementSelection = variables.stateSelection;
			variables.movementMode = "custom";
			variables.weatherMode = "custom";
		} else {
			variables.customBehavior = text;
			variables.stateBehaviorSelection = { id:"custom", label:text };
		}
		setup.setInputFocus(false);
		Engine.play(isState ? "상태에서의 행동" : "마음의 시야");
	});
	textarea.addEventListener("input", function () {
		if (textarea.value.trim()) error.textContent = "";
	});
	textarea.addEventListener("focus", function () { setup.setInputFocus(true); });
	textarea.addEventListener("blur", function () { setup.setInputFocus(false); });
	window.setTimeout(function () { textarea.focus(); }, 0);
};
setup.roomLabel = function (room) {
	return room === "lighthouse" ? "등대의 방" : room === "wave" ? "파도의 방" : "안개의 방";
};
setup.roomDefaultPartName = function (room) {
	return room === "lighthouse" ? "계속 살피는 부분" : room === "wave" ? "당장 버티게 하는 부분" : "거리를 만드는 부분";
};
setup.roomFieldValue = function (group, room) {
	var value = (State.variables[group] || {})[room];
	return value || "아직 알 수 없음";
};
setup.markRoomBarelyPresent = function (room) {
	var variables = State.variables;
	variables.roomPresence[room] = "오늘은 거의 느껴지지 않음";
	variables.roomBehaviors[room] = "오늘은 이 움직임이 거의 느껴지지 않음";
	variables.roomAttitudes[room] = "특별히 가까운 반응이 없음";
	variables.roomPermissions[room] = "더 깊이 살펴볼 필요가 없음";
	variables.roomConditions[room] = "지금 상태를 그대로 확인하는 거리";
	variables.roomDistances[room] = "오늘은 거의 느껴지지 않는 거리";
	variables.roomPending[room] = setup.emptyRoomPending(room);
	setup.completeRoom(room);
};
setup.afterAttitude = function () {
	var variables = State.variables;
	var room = variables.currentRoom;
	var attitude = variables.roomAttitudes[room];
	if (["두렵다","답답하거나 짜증이 난다","빨리 없어졌으면 좋겠다"].indexOf(attitude) !== -1) {
		variables.secondPartFound = true;
		Engine.play("함께 있는 다른 부분");
		return;
	}
	Engine.play("멈추면 걱정되는 일");
};
setup.afterPermission = function () {
	var variables = State.variables;
	var room = variables.currentRoom;
	var permission = variables.roomPermissions[room];
	if (permission === "조금 더 가까이 가도 된다") {
		if (room === "wave") Engine.play("파도 깊이");
		else if (room === "fog") Engine.play("안개가 정한 거리");
		else Engine.play("필요한 관측 조건");
		return;
	}
	Engine.play("필요한 관측 조건");
};
setup.weatherSummary = function () {
	setup.updateWeatherLabel();
	return State.variables.weatherLabel;
};
setup.lightSummary = function () {
	var light = (State.variables.weatherState || {}).light || 0;
	if (light >= .72) return "등대의 빛이 안정적으로 유지되고 있습니다.";
	if (light >= .42) return "등대의 빛이 천천히 자리를 잡고 있습니다.";
	return "등대의 빛이 희미하지만 계속 머물러 있습니다.";
};
setup.memoryKey = "inner-weather-station-relationships-v1";
setup.roomIds = ["lighthouse", "wave", "fog"];
setup.emptyRoomState = function () {
	return {
		lighthouse: { visited:false, completed:false, visits:0, weatherCommitted:false },
		wave: { visited:false, completed:false, visits:0, weatherCommitted:false },
		fog: { visited:false, completed:false, visits:0, weatherCommitted:false }
	};
};
setup.ensureRoomState = function () {
	var variables = State.variables;
	if (!variables.roomState) variables.roomState = setup.emptyRoomState();
	setup.roomIds.forEach(function (room) {
		var fallbackVisits = Number((variables.visited || {})[room] || 0);
		var current = variables.roomState[room] || {};
		current.visits = Math.max(Number(current.visits || 0), fallbackVisits);
		current.visited = !!current.visited || current.visits > 0;
		current.completed = !!current.completed;
		current.weatherCommitted = !!current.weatherCommitted;
		variables.roomState[room] = current;
	});
	return variables.roomState;
};
setup.OBSERVATION_SCHEMA_VERSION = 3;
setup.emptyRoomObservation = function () {
	return {
		name:"",
		trigger:"",
		action:"",
		fearedOutcome:"",
		protectiveIntent:"",
		preferredDistance:"",
		ownWords:""
	};
};
setup.emptyRoomObservations = function () {
	return {
		lighthouse:setup.emptyRoomObservation(),
		wave:setup.emptyRoomObservation(),
		fog:setup.emptyRoomObservation()
	};
};
setup.defaultMemory = function () {
	return {
		schemaVersion:setup.OBSERVATION_SCHEMA_VERSION,
		visited: { lighthouse:0, wave:0, fog:0 },
		trust: { lighthouse:0, wave:0, fog:0 },
		names: {
			lighthouse:"계속 살피는 부분",
			wave:"당장 버티게 하는 부분",
			fog:""
		},
		intents: { lighthouse:"", wave:"", fog:"" },
		distances: { lighthouse:"", wave:"", fog:"" },
		inputs: {
			lighthouse:{ partName:"", ownWords:"", usedDefaultName:false },
			wave:{ partName:"", ownWords:"", usedDefaultName:false },
			fog:{ partName:"", ownWords:"", usedDefaultName:false }
		},
		observations:setup.emptyRoomObservations(),
		report:{
			resonance:"",
			correction:"",
			nextQuestion:"",
			nextQuestionSaved:false
		}
	};
};
setup.loadMemory = function () {
	var fallback = setup.defaultMemory();
	try {
		var saved = JSON.parse(localStorage.getItem(setup.memoryKey) || "null");
		if (!saved) return fallback;
		["visited","trust","names","intents","distances"].forEach(function (group) {
			saved[group] = Object.assign({}, fallback[group], saved[group] || {});
		});
		saved.inputs = saved.inputs || {};
		setup.roomIds.forEach(function (room) {
			saved.inputs[room] = Object.assign(
				{},
				fallback.inputs[room],
				saved.inputs[room] || {}
			);
		});
		var savedSchemaVersion = Number(saved.schemaVersion || 1);
		saved.observations = saved.observations || {};
		setup.roomIds.forEach(function (room) {
			saved.observations[room] = Object.assign(
				{},
				fallback.observations[room],
				saved.observations[room] || {}
			);
		});
		saved.report = Object.assign({}, fallback.report, saved.report || {});
		saved.schemaVersion = setup.OBSERVATION_SCHEMA_VERSION;
		saved.requiresWaveRevisit = savedSchemaVersion < setup.OBSERVATION_SCHEMA_VERSION;
		if (saved.requiresWaveRevisit) {
			saved.observations.wave = setup.emptyRoomObservation();
		}
		if (
			saved.names.fog === "가려두는 부분" &&
			!String(saved.inputs.fog.partName || "").trim()
		) {
			saved.names.fog = "";
		}
		if (
			!String(saved.inputs.wave.partName || "").trim() &&
			(saved.names.wave === "급히 다른 곳으로 데려가는 부분" ||
			 saved.names.wave === "당장 버티게 하는 부분")
		) {
			saved.inputs.wave.usedDefaultName = true;
			saved.names.wave = "당장 버티게 하는 부분";
		}
		return saved;
	} catch (error) {
		return fallback;
	}
};
setup.ensureRoomInputs = function () {
	var variables = State.variables;
	if (!variables.roomInputs) variables.roomInputs = {};
	setup.roomIds.forEach(function (room) {
		variables.roomInputs[room] = Object.assign(
			{ partName:"", ownWords:"", usedDefaultName:false },
			variables.roomInputs[room] || {}
		);
	});
	return variables.roomInputs;
};
setup.initSession = function () {
	var variables = State.variables;
	var memory = setup.loadMemory();
	delete variables.reportReady;
	delete variables.finalReady;
	delete variables.observationComplete;
	variables.memory = memory;
	variables.visited = Object.assign({}, memory.visited);
	variables.trust = Object.assign({}, memory.trust);
	variables.partNames = Object.assign({}, memory.names);
	variables.roomIntents = Object.assign({}, memory.intents);
	variables.roomDistances = Object.assign({}, memory.distances);
	variables.observationSchemaVersion = setup.OBSERVATION_SCHEMA_VERSION;
	variables.roomObservations = setup.emptyRoomObservations();
	setup.roomIds.forEach(function (room) {
		variables.roomObservations[room] = Object.assign(
			{},
			setup.emptyRoomObservation(),
			(memory.observations || {})[room] || {}
		);
	});
	variables.reportResonance = (memory.report || {}).resonance || "";
	variables.reportCorrection = (memory.report || {}).correction || "";
	variables.nextObservationQuestion = (memory.report || {}).nextQuestion || "";
	variables.nextQuestionSaved = !!((memory.report || {}).nextQuestionSaved);
	if (memory.requiresWaveRevisit) {
		variables.waveConcern = "";
		if (variables.roomWorries) variables.roomWorries.wave = "";
		if (variables.roomState && variables.roomState.wave) {
			variables.roomState.wave.completed = false;
		}
	}
	variables.roomInputs = {};
	var defaultNames = {
		lighthouse:"계속 살피는 부분",
		wave:"당장 버티게 하는 부분",
		fog:""
	};
	setup.roomIds.forEach(function (room) {
		variables.roomInputs[room] = Object.assign({}, memory.inputs[room]);
		if (variables.roomInputs[room].partName) {
			variables.partNames[room] = variables.roomInputs[room].partName;
		} else {
			variables.partNames[room] = defaultNames[room];
		}
	});
	setup.ensureRoomState();
	variables.hasPreviousObservation =
		(memory.visited.lighthouse + memory.visited.wave + memory.visited.fog) > 0;
};
setup.persistRelationships = function () {
	var variables = State.variables;
	var inputs = setup.ensureRoomInputs();
	var memory = {
		schemaVersion:setup.OBSERVATION_SCHEMA_VERSION,
		visited: Object.assign({}, variables.visited || {}),
		trust: Object.assign({}, variables.trust || {}),
		names: Object.assign({}, variables.partNames || {}),
		intents: Object.assign({}, variables.roomIntents || {}),
		distances: Object.assign({}, variables.roomDistances || {}),
		inputs: {
			lighthouse:Object.assign({}, inputs.lighthouse),
			wave:Object.assign({}, inputs.wave),
			fog:Object.assign({}, inputs.fog)
		},
		observations:{
			lighthouse:Object.assign({}, (variables.roomObservations || {}).lighthouse || setup.emptyRoomObservation()),
			wave:Object.assign({}, (variables.roomObservations || {}).wave || setup.emptyRoomObservation()),
			fog:Object.assign({}, (variables.roomObservations || {}).fog || setup.emptyRoomObservation())
		},
		report:{
			resonance:variables.reportResonance || "",
			correction:variables.reportCorrection || "",
			nextQuestion:variables.nextObservationQuestion || "",
			nextQuestionSaved:!!variables.nextQuestionSaved
		}
	};
	variables.memory = memory;
	try { localStorage.setItem(setup.memoryKey, JSON.stringify(memory)); } catch (error) {}
};
setup.enterRoom = function (room) {
	var variables = State.variables;
	var roomState = setup.ensureRoomState();
	setup.ensureWeatherContributions();
	var enteringFromHub = variables.currentRoom !== room;
	variables.currentRoom = room;
	variables.sceneMode = room;
	if (enteringFromHub) {
		variables.roomPending[room] = setup.emptyRoomPending(room);
		variables.weatherAtRoomStart = Object.assign({}, variables.weatherState || {});
	}
	roomState[room].visited = true;
	roomState[room].visits += 1;
	variables.visited[room] = Number(variables.visited[room] || 0) + 1;
	setup.persistRelationships();
};
setup.returnToObservatory = function () {
	State.variables.currentRoom = "hub";
	State.variables.sceneMode = "hub";
	if (setup.audio) setup.audio.setScene("hub");
};
setup.completeRoom = function (room) {
	var variables = State.variables;
	var roomState = setup.ensureRoomState();
	var contributions = setup.ensureWeatherContributions();
	if (typeof setup.captureRoomObservation === "function") {
		setup.captureRoomObservation(room);
	}
	if (roomState[room]) {
		contributions[room] = Object.assign(
			setup.emptyWeatherVector(),
			variables.roomPending[room] || {}
		);
		roomState[room].completed = true;
		roomState[room].weatherCommitted = true;
	}
	variables.hubUIRevealDelay = 2600;
	setup.recomputeWeather();
	if (setup.audio) {
		setup.audio.setWeather(variables.weatherState || {});
		setup.audio.setScene("hub");
		setup.audio.playSfx("roomComplete");
	}
	setup.returnToObservatory();
	setup.persistRelationships();
};
setup.completedCount = function () {
	var roomState = setup.ensureRoomState();
	return setup.roomIds.filter(function (room) {
		return roomState[room].completed === true;
	}).length;
};
setup.areAllRoomsCompleted = function () {
	var roomState = setup.ensureRoomState();
	return (
		roomState.lighthouse.completed === true &&
		roomState.wave.completed === true &&
		roomState.fog.completed === true
	);
};
setup.allRoomsCompleted = setup.areAllRoomsCompleted;
setup.roomCompleted = function (room) {
	var roomState = setup.ensureRoomState();
	return !!(roomState[room] && roomState[room].completed);
};
setup.openWeatherRecord = function () {
	if (!setup.areAllRoomsCompleted()) {
		setup.returnToObservatory();
		if (passage() !== "관측소 허브") {
			Engine.play("관측소 허브");
		} else {
			setup.renderHubUI();
		}
		return;
	}
	Engine.play("가까웠던 부분");
};
setup.renderHubUI = function () {
	var container = document.querySelector("#hubAction");
	if (!container) return;
	container.replaceChildren();

	var completedCount = setup.completedCount();
	var message = document.createElement("p");
	message.className = "hub-ui__message";

	if (completedCount === 0) {
		message.textContent = "지금 가장 눈에 들어오는 공간을 선택해보세요.";
		container.appendChild(message);
		return;
	}
	if (completedCount === 1) {
		message.textContent = "다른 움직임도 천천히 살펴볼 수 있습니다.";
		container.appendChild(message);
		return;
	}
	if (completedCount === 2) {
		message.textContent = "아직 만나지 않은 날씨가 하나 있습니다.";
		container.appendChild(message);
		return;
	}
	if (!setup.areAllRoomsCompleted()) return;

	message.textContent = "오늘의 날씨가 한자리에 모였습니다.";
	container.appendChild(message);

	var button = document.createElement("button");
	button.type = "button";
	button.className = "weather-record-button";
	button.textContent = "오늘의 날씨를 바라본다";
	button.addEventListener("click", setup.openWeatherRecord);
	container.appendChild(button);
};
setup.scheduleHubUI = function () {
	if (setup.hubUIRevealTimer) clearTimeout(setup.hubUIRevealTimer);
	var delay = Math.max(0, Number(State.variables.hubUIRevealDelay || 0));
	State.variables.hubUIRevealDelay = 0;
	setup.hubUIRevealTimer = setTimeout(setup.renderHubUI, delay);
};
setup.captureRoomWeatherStart = function () {
	var variables = State.variables;
	if (!variables.weatherAtRoomStart) {
		variables.weatherAtRoomStart = Object.assign({}, variables.weatherState || {});
	}
};
setup.weatherChangeSummary = function () {
	var variables = State.variables;
	var before = (setup.ensureWeatherContributions().base) || {};
	var after = variables.weatherState || {};
	var labels = {
		fog:["안개가 옅어짐","안개가 짙어짐"],
		rain:["비가 잦아듦","비가 늘어남"],
		wave:["파도가 낮아짐","파도가 높아짐"],
		wind:["바람이 약해짐","바람이 강해짐"],
		cloud:["구름이 줄어듦","구름이 늘어남"],
		light:["빛이 희미해짐","빛이 선명해짐"]
	};
	var changes = [];
	setup.weatherKeys.forEach(function (key) {
		var delta = Number(after[key] || 0) - Number(before[key] || 0);
		if (Math.abs(delta) < .05) return;
		changes.push(delta > 0 ? labels[key][1] : labels[key][0]);
	});
	return changes.length ? changes.join(" · ") : "큰 변화 없이 유지됨";
};
setup.roomPartName = function (room) {
	var defaults = {
		lighthouse:"계속 살피는 부분",
		wave:"당장 버티게 하는 부분",
		fog:"아직 이름 붙지 않은 부분"
	};
	var inputs = setup.ensureRoomInputs();
	if (
		room === "wave" &&
		inputs.wave.usedDefaultName === true &&
		!String(inputs.wave.partName || "").trim()
	) {
		return "아직 이름을 붙이지 않은 반응";
	}
	var name = inputs[room].partName || (State.variables.partNames || {})[room] || defaults[room];
	if (room === "fog" && name === "가려두는 부분") return "아직 이름 붙지 않은 부분";
	return name;
};
setup.waveNameSuggestions = function () {
	var action = String(State.variables.waveAction || "");
	var suggestions = [];
	var add = function (name) {
		name = String(name || "").trim();
		if (name && suggestions.indexOf(name) === -1) suggestions.push(name);
	};
	if (
		action.indexOf("계속 움직") !== -1 ||
		action.indexOf("할 일을") !== -1 ||
		action.indexOf("멈추기 어렵") !== -1 ||
		action.indexOf("해야만") !== -1 ||
		action.indexOf("쫓기듯") !== -1
	) {
		["계속 움직이는 부분","멈추지 못하게 하는 부분","해야만 하는 부분"].forEach(add);
	} else if (action.indexOf("원하는 방향") !== -1) {
		["앞으로 데려가는 부분","원하는 방향을 찾는 부분","속도를 조절해보는 부분"].forEach(add);
	} else if (
		action.indexOf("시선을") !== -1 ||
		action.indexOf("보거나") !== -1 ||
		action.indexOf("먹거나") !== -1 ||
		action.indexOf("몰두") !== -1
	) {
		["다른 곳으로 데려가는 부분","급히 시선을 돌리는 부분","잠깐 잊게 하는 부분"].forEach(add);
	} else if (action.indexOf("잠들") !== -1 || action.indexOf("느끼지 않") !== -1) {
		["감각을 낮추는 부분","잠시 꺼두는 부분","조용하게 만드는 부분"].forEach(add);
	} else if (action.indexOf("터지") !== -1 || action.indexOf("날카로") !== -1) {
		["먼저 터뜨리는 부분","가까이 오지 못하게 하는 부분","크게 밀어내는 부분"].forEach(add);
	} else if (action.indexOf("멀어진") !== -1) {
		["급히 멀어지는 부분","안전한 곳으로 데려가는 부분","거리를 만드는 부분"].forEach(add);
	}
	[
		"당장 괜찮아지려는 부분",
		"잠깐 덮어두는 부분",
		"불을 끄는 부분",
		"당장 버티게 하는 부분"
	].forEach(add);
	return suggestions.slice(0, 6);
};
setup.saveWaveName = function (name, usedDefaultName) {
	var inputs = setup.ensureRoomInputs();
	var clean = String(name || "").trim();
	inputs.wave.partName = usedDefaultName ? "" : clean;
	inputs.wave.usedDefaultName = !!usedDefaultName;
	State.variables.partNames.wave = usedDefaultName
		? "당장 버티게 하는 부분"
		: (clean || "당장 버티게 하는 부분");
	setup.persistRelationships();
};
setup.waveRecordName = function () {
	var inputs = setup.ensureRoomInputs();
	if (inputs.wave.usedDefaultName === true || !String(inputs.wave.partName || "").trim()) {
		return "아직 이름을 붙이지 않은 반응";
	}
	return "내가 붙인 이름: " + String(inputs.wave.partName).trim();
};
setup.renderWaveNameSuggestions = function () {
	var host = document.querySelector(".wave-name-suggestions");
	if (!host) return;
	host.replaceChildren();
	setup.waveNameSuggestions().forEach(function (name) {
		var button = document.createElement("button");
		button.type = "button";
		button.className = "choice-button";
		button.textContent = name;
		button.addEventListener("click", function () {
			setup.saveWaveName(name, false);
			setup.completeRoom("wave");
			Engine.play("관측소 허브");
		});
		host.appendChild(button);
	});
	var unnamed = document.createElement("button");
	unnamed.type = "button";
	unnamed.className = "choice-button";
	unnamed.textContent = "아직 이름 없이 둔다";
	unnamed.addEventListener("click", function () {
		setup.saveWaveName("", true);
		setup.completeRoom("wave");
		Engine.play("관측소 허브");
	});
	host.appendChild(unnamed);
};
setup.roomOwnWords = function (room) {
	var inputs = setup.ensureRoomInputs();
	return String((inputs[room] && inputs[room].ownWords) || "").trim();
};
setup.escapeText = function (value) {
	return String(value == null ? "" : value)
		.replace(/&/g, "&amp;")
		.replace(/</g, "&lt;")
		.replace(/>/g, "&gt;")
		.replace(/"/g, "&quot;")
		.replace(/'/g, "&#39;");
};
setup.koreanParticle = function (value, withBatchim, withoutBatchim) {
	var text = String(value == null ? "" : value).trim();
	if (!text) return withoutBatchim;
	var code = text.charCodeAt(text.length - 1);
	if (code >= 0xAC00 && code <= 0xD7A3) {
		return ((code - 0xAC00) % 28) === 0 ? withoutBatchim : withBatchim;
	}
	return withoutBatchim;
};
setup.postRoomInputFeedback = function (room, text) {
	if (!text || !setup.weatherStation || !setup.weatherStation.frame) return;
	setup.weatherStation.frame.contentWindow.postMessage({
		type:"room-input-feedback",
		room:room,
		text:String(text)
	}, "*");
};
setup.setInputFocus = function (focused) {
	if (!setup.weatherStation || !setup.weatherStation.frame) return;
	setup.weatherStation.frame.contentWindow.postMessage({
		type:"input-focus",
		focused:!!focused
	}, "*");
};
setup.openRoomInput = function (room, field, question, options) {
	options = options || {};
	var host = document.querySelector(".custom-input-host");
	var stage = document.querySelector(".room-input-stage");
	if (!host || !stage) return;
	var inputs = setup.ensureRoomInputs();
	var defaults = {
		lighthouse:"계속 살피는 부분",
		wave:"당장 버티게 하는 부분",
		fog:"아직 이름 붙지 않은 부분"
	};
	var isName = field === "partName";
	var defaultName = options.defaultName || defaults[room];
	stage.hidden = true;
	host.innerHTML = "";

	var panel = document.createElement("div");
	panel.className = "custom-input-panel";
	var label = document.createElement("label");
	label.setAttribute("for", "customResponse");
	label.textContent = question;
	var textarea = document.createElement(isName ? "input" : "textarea");
	textarea.id = "customResponse";
	if (isName) {
		textarea.type = "text";
		textarea.placeholder = options.placeholder || "예: 계속 움직이는 부분";
	} else {
		textarea.rows = 3;
	}
	textarea.maxLength = isName ? 48 : 240;
	textarea.value = String(inputs[room][field] || "");
	var actions = document.createElement("div");
	actions.className = "custom-input-actions";

	var back = document.createElement("button");
	back.type = "button";
	back.className = "secondary";
	back.textContent = "돌아가기";
	back.addEventListener("click", function () {
		setup.setInputFocus(false);
		host.innerHTML = "";
		stage.hidden = false;
	});

	var save = document.createElement("button");
	save.type = "button";
	save.className = "primary";
	save.textContent = isName ? "이 이름을 남긴다" : "이 문장을 남긴다";
	save.addEventListener("click", function () {
		var text = textarea.value.trim();
		if (!text && !isName) {
			textarea.focus();
			return;
		}
		if (isName) {
			if (!text) {
				textarea.focus();
				return;
			}
			inputs[room].partName = text;
			inputs[room].usedDefaultName = false;
			State.variables.partNames[room] = text;
			setup.persistRelationships();
			setup.setInputFocus(false);
			if (options.completeRoom) setup.completeRoom(room);
			Engine.play(options.nextPassage || "관측소 허브");
			return;
		}
		inputs[room][field] = text;
		if (options.storeAsOwnWords !== false) {
			if (options.appendOwnWords) {
				var previousWords = String(inputs[room].ownWords || "").trim();
				inputs[room].ownWords = previousWords && previousWords.indexOf(text) === -1
					? previousWords + " / " + text
					: (previousWords || text);
			} else {
				inputs[room].ownWords = text;
			}
		}
		if (options.stateVariable) {
			State.variables[options.stateVariable] = text;
		}
		if (options.groupVariable) {
			State.variables[options.groupVariable] = State.variables[options.groupVariable] || {};
			State.variables[options.groupVariable][room] = text;
		}
		if (options.rememberIntent) {
			setup.rememberRoom(room, text, options.distance || "");
		}
		if (options.trustDelta) {
			setup.addTrust(room, Number(options.trustDelta));
		}
		if (options.weatherDelta) {
			setup.adjustWeather(options.weatherDelta);
		}
		setup.persistRelationships();
		setup.postRoomInputFeedback(room, text);
		setup.setInputFocus(false);
		if (options.nextPassage) {
			Engine.play(options.nextPassage);
			return;
		}
		panel.innerHTML = "";
		var response = document.createElement("p");
		response.className = "custom-input-response";
		response.textContent = "적어둔 문장이 이 방에 잠시 머뭅니다.";
		var quote = document.createElement("p");
		quote.className = "custom-input-quote";
		quote.textContent = text;
		var continueButton = document.createElement("button");
		continueButton.type = "button";
		continueButton.className = "primary";
		continueButton.textContent = "계속 살펴본다";
		continueButton.addEventListener("click", function () {
			host.innerHTML = "";
			stage.hidden = false;
		});
		var continueActions = document.createElement("div");
		continueActions.className = "custom-input-actions";
		continueActions.appendChild(continueButton);
		panel.appendChild(response);
		panel.appendChild(quote);
		panel.appendChild(continueActions);
	});

	textarea.addEventListener("focus", function () { setup.setInputFocus(true); });
	textarea.addEventListener("blur", function () { setup.setInputFocus(false); });
	actions.appendChild(back);
	if (isName) {
		var skip = document.createElement("button");
		skip.type = "button";
		skip.className = "secondary";
		skip.textContent = options.skipLabel || "아직 이름을 붙이지 않는다";
		skip.addEventListener("click", function () {
			inputs[room].partName = "";
			inputs[room].usedDefaultName = true;
			State.variables.partNames[room] = defaultName;
			setup.persistRelationships();
			setup.setInputFocus(false);
			if (options.completeRoom) setup.completeRoom(room);
			Engine.play(options.nextPassage || "관측소 허브");
		});
		actions.appendChild(skip);
	}
	actions.appendChild(save);
	panel.appendChild(label);
	if (options.description) {
		var description = document.createElement("p");
		description.className = "custom-input-help";
		description.textContent = String(options.description);
		panel.appendChild(description);
	}
	panel.appendChild(textarea);
	panel.appendChild(actions);
	host.appendChild(panel);
	window.setTimeout(function () { textarea.focus(); }, 0);
};
setup.openPressureInput = function () {
	var host = document.querySelector(".custom-input-host");
	var stage = document.querySelector(".room-input-stage");
	if (!host || !stage) return;
	stage.hidden = true;
	host.innerHTML = "";

	var panel = document.createElement("div");
	panel.className = "custom-input-panel";
	var label = document.createElement("label");
	label.setAttribute("for", "pressureCustomResponse");
	label.textContent = "잠시 멈춘다고 생각하면, 어떤 느낌이 먼저 드나요?";
	var textarea = document.createElement("textarea");
	textarea.id = "pressureCustomResponse";
	textarea.rows = 3;
	textarea.maxLength = 240;
	textarea.value = String(State.variables.movementPressureCustom || "");
	var actions = document.createElement("div");
	actions.className = "custom-input-actions";

	var back = document.createElement("button");
	back.type = "button";
	back.className = "secondary";
	back.textContent = "돌아가기";
	back.addEventListener("click", function () {
		setup.setInputFocus(false);
		host.innerHTML = "";
		stage.hidden = false;
	});

	var save = document.createElement("button");
	save.type = "button";
	save.className = "primary";
	save.textContent = "이 문장을 남긴다";
	save.addEventListener("click", function () {
		var text = textarea.value.trim();
		if (!text) {
			textarea.focus();
			return;
		}
		State.variables.movementPressureCustom = text;
		State.variables.movementPressureReason = text;
		setup.setInputFocus(false);
		Engine.play("마음의 시야");
	});

	textarea.addEventListener("focus", function () { setup.setInputFocus(true); });
	textarea.addEventListener("blur", function () { setup.setInputFocus(false); });
	actions.appendChild(back);
	actions.appendChild(save);
	panel.appendChild(label);
	panel.appendChild(textarea);
	panel.appendChild(actions);
	host.appendChild(panel);
	window.setTimeout(function () { textarea.focus(); }, 0);
};
setup.roomIntent = function (room) {
	var intent = (State.variables.roomIntents || {})[room] || "";
	if (!intent || /아직 (정확히 )?알 수 없음/.test(intent)) return "아직 알 수 없음";
	return intent;
};
setup.roomDistance = function (room) {
	return (State.variables.roomDistances || {})[room] || "아직 알 수 없음";
};
setup.addTrust = function (room, amount) {
	var variables = State.variables;
	variables.trust[room] = Math.max(0, Number(variables.trust[room] || 0) + Number(amount || 0));
	setup.persistRelationships();
};
setup.rememberRoom = function (room, intent, distance) {
	var variables = State.variables;
	if (intent) variables.roomIntents[room] = intent;
	if (distance) {
		variables.roomDistances[room] = distance;
		variables.distancePhrase = distance;
	}
	setup.persistRelationships();
};
setup.clearRelationships = function () {
	try { localStorage.removeItem(setup.memoryKey); } catch (error) {}
	setup.initSession();
};
setup.primaryRoom = function () {
	var variables = State.variables;
	return ["lighthouse","wave","fog"].indexOf(variables.primaryRoomChoice) !== -1
		? variables.primaryRoomChoice
		: "";
};
setup.primaryPartName = function () {
	var room = setup.primaryRoom();
	return room ? setup.roomPartName(room) : "아직 이름 붙지 않은 부분";
};
setup.primaryIntent = function () {
	var room = setup.primaryRoom();
	return room && State.variables.roomIntents[room]
		? State.variables.roomIntents[room]
		: "아직 정확히 알 수 없음";
};
setup.primaryRole = function () {
	var room = setup.primaryRoom();
	if (room === "lighthouse") return "예상하지 못한 일을 놓치지 않도록 계속 살피기";
	if (room === "wave") return "올라오는 감정을 빠르게 덮거나 밀어내기";
	if (room === "fog") return "너무 빨리 마주하지 않도록 거리를 만들기";
	return "아직 정확히 알 수 없음";
};
setup.primaryDistance = function () {
	var room = setup.primaryRoom();
	return room && State.variables.roomDistances[room]
		? State.variables.roomDistances[room]
		: "아직 정하지 않음";
};
setup.isUnknownObservation = function (value) {
	var text = String(value == null ? "" : value).trim();
	return !text || /아직.*(알 수|모르|정하지)|잘 모르|알 수 없음/.test(text);
};
setup.withObjectParticle = function (value) {
	var text = String(value == null ? "" : value).trim();
	return text + setup.koreanParticle(text, "을", "를");
};
setup.ensureObservationSchema = function () {
	var variables = State.variables;
	var currentVersion = Number(variables.observationSchemaVersion || 1);
	if (currentVersion < setup.OBSERVATION_SCHEMA_VERSION) {
		variables.roomObservations = setup.emptyRoomObservations();
		variables.waveConcern = "";
		if (variables.roomWorries) variables.roomWorries.wave = "";
		var roomState = setup.ensureRoomState();
		roomState.wave.completed = false;
		roomState.wave.weatherCommitted = false;
	}
	variables.observationSchemaVersion = setup.OBSERVATION_SCHEMA_VERSION;
	if (!variables.roomObservations) {
		variables.roomObservations = setup.emptyRoomObservations();
	}
	setup.roomIds.forEach(function (room) {
		variables.roomObservations[room] = Object.assign(
			{},
			setup.emptyRoomObservation(),
			variables.roomObservations[room] || {}
		);
	});
	return variables.roomObservations;
};
setup.captureRoomObservation = function (room) {
	var variables = State.variables;
	var observations = setup.ensureObservationSchema();
	var observation = Object.assign({}, observations[room] || setup.emptyRoomObservation());
	var invalidOldWaveAnswers = [
		"말로 하지 못한 슬픔",
		"누군가에게 닿지 못한 마음",
		"안개처럼 흐린 장면"
	];

	observation.name = setup.roomPartName(room);
	observation.ownWords = setup.roomOwnWords(room);

	if (room === "lighthouse") {
		observation.trigger = variables.lighthouseHorizonConcern || "";
		observation.action = (variables.roomBehaviors || {}).lighthouse || "";
		observation.fearedOutcome = (variables.roomWorries || {}).lighthouse || "";
		observation.protectiveIntent = (variables.roomProtections || {}).lighthouse || "";
		observation.preferredDistance =
			(variables.roomDistances || {}).lighthouse ||
			(variables.roomConditions || {}).lighthouse ||
			"";
	} else if (room === "wave") {
		observation.trigger =
			(variables.movementSelection && variables.movementSelection.label) ||
			"멈추지 못하게 하는 물살이 느껴질 때";
		observation.action = variables.waveAction || (variables.roomBehaviors || {}).wave || "";
		observation.fearedOutcome = variables.waveConcern || (variables.roomWorries || {}).wave || "";
		if (invalidOldWaveAnswers.indexOf(observation.fearedOutcome) !== -1) {
			observation.fearedOutcome = "";
		}
		observation.protectiveIntent =
			variables.waveProtection ||
			(variables.roomProtections || {}).wave ||
			"아직 무엇을 막아주려는지 알 수 없음";
		observation.preferredDistance =
			variables.waveDistance ||
			(variables.roomDistances || {}).wave ||
			"";
	} else if (room === "fog") {
		observation.trigger = "마음이 버거워질 때";
		observation.action = variables.fogEscapeMode || (variables.roomBehaviors || {}).fog || "";
		observation.fearedOutcome = "";
		observation.protectiveIntent =
			variables.fogReliefNeed ||
			(variables.roomProtections || {}).fog ||
			"";
		observation.preferredDistance =
			variables.fogDistance ||
			(variables.roomDistances || {}).fog ||
			"";
	}

	observations[room] = observation;
	return observation;
};
setup.captureAllRoomObservations = function () {
	setup.roomIds.forEach(function (room) {
		if (setup.roomCompleted(room)) setup.captureRoomObservation(room);
	});
	return setup.ensureObservationSchema();
};
setup.buildObservationSummary = function () {
	var observations = setup.captureAllRoomObservations();
	var lighthouse = observations.lighthouse;
	var wave = observations.wave;
	var fog = observations.fog;
	var sentences = [];

	if (!setup.isUnknownObservation(lighthouse.action)) {
		if (!setup.isUnknownObservation(lighthouse.trigger)) {
			sentences.push(
				"이번 선택에서는 “" + lighthouse.trigger + "”" +
				setup.koreanParticle(lighthouse.trigger, "을", "를") +
				" 중요하게 여기며 주변을 계속 살피는 움직임이 선명했습니다."
			);
		} else {
			sentences.push(
				"이번 선택에서는 “" + lighthouse.action +
				"”의 방식으로 계속 살피는 움직임이 선명했습니다."
			);
		}
	} else {
		sentences.push(
			"계속 살피는 움직임이 무엇을 놓치지 않으려 하는지는 아직 분명하지 않았습니다."
		);
	}
	if (!setup.isUnknownObservation(wave.action)) {
		sentences.push(
			"마음이 벅차오를 때에는 “" + wave.action +
			"”의 방식으로 지금을 버티려는 반응이 나타났습니다."
		);
	} else {
		sentences.push(
			"마음이 벅차오를 때 가장 먼저 나타나는 반응은 아직 분명하지 않았습니다."
		);
	}
	if (!setup.isUnknownObservation(fog.action)) {
		var fogSentence =
			"마음이 버거울 때에는 “" + fog.action +
			"”의 방식으로 거리를 만드는 움직임도 함께 보였습니다.";
		if (!setup.isUnknownObservation(fog.protectiveIntent)) {
			fogSentence += " 이 움직임은 “" + fog.protectiveIntent + "”" +
				setup.koreanParticle(fog.protectiveIntent, "을", "를") +
				" 마련하려 했습니다.";
		}
		sentences.push(fogSentence);
	} else {
		sentences.push(
			"거리가 필요해지는 순간에 어떤 움직임이 나타나는지는 아직 분명하지 않았습니다."
		);
	}
	sentences.push(
		"세 반응을 없애거나 하나의 의미로 정하기보다, 오늘 허용할 수 있는 거리 안에서 바라보았습니다."
	);
	return sentences.slice(0, 5);
};
setup.roomNarrativeTitle = function (room) {
	if (room === "lighthouse") return "놓치지 않으려 살피는 반응";
	if (room === "wave") return "벅차오를 때 급히 움직이는 반응";
	return "거리를 마련하는 반응";
};
setup.buildRoomNarrative = function (roomId) {
	var observation = setup.captureRoomObservation(roomId);
	var name = observation.name || "아직 이름을 붙이지 않은 반응";
	var paragraphs = [];
	var hasAction = !setup.isUnknownObservation(observation.action);
	var hasFear = !setup.isUnknownObservation(observation.fearedOutcome);
	var hasIntent = !setup.isUnknownObservation(observation.protectiveIntent);
	var hasDistance = !setup.isUnknownObservation(observation.preferredDistance);

	if (roomId === "lighthouse") {
		if (!setup.isUnknownObservation(observation.trigger) && hasAction) {
			paragraphs.push(
				"‘" + name + "’" + setup.koreanParticle(name, "은", "는") +
				" “" + observation.trigger + "”" +
				setup.koreanParticle(observation.trigger, "을", "를") +
				" 놓치지 않으려 “" + observation.action + "”의 방식으로 움직였습니다."
			);
		} else if (hasAction) {
			paragraphs.push(
				"‘" + name + "’" + setup.koreanParticle(name, "은", "는") +
				" 이번 관측에서 “" +
				observation.action + "”의 방식으로 움직였습니다."
			);
		} else {
			paragraphs.push(
				"‘" + name + "’이 언제 어떻게 움직이는지는 아직 분명하지 않았습니다."
			);
		}
	} else if (roomId === "wave") {
		paragraphs.push(
			hasAction
				? "‘" + name + "’" + setup.koreanParticle(name, "은", "는") +
					" 마음이 갑자기 벅차오를 때 “" +
					observation.action + "”의 방식으로 먼저 움직였습니다."
				: "마음이 벅차오를 때 나타나는 반응의 움직임은 아직 분명하지 않았습니다."
		);
	} else {
		paragraphs.push(
			hasAction
				? "‘" + name + "’" + setup.koreanParticle(name, "은", "는") +
					" 마음이 버거워질 때 “" +
					observation.action + "”의 방식으로 거리를 만들었습니다."
				: "거리가 필요할 때 어떤 움직임이 나타나는지는 아직 분명하지 않았습니다."
		);
	}

	if (hasFear && hasIntent) {
		paragraphs.push(
			"그렇게 하지 못할 때 “" + observation.fearedOutcome +
			"”는 걱정을 선택했습니다. 이 반응이 지키거나 마련하려던 것으로는 “" +
			observation.protectiveIntent + "”" +
			setup.koreanParticle(observation.protectiveIntent, "이", "가") +
			" 남았습니다."
		);
	} else if (hasFear) {
		paragraphs.push(
			"그렇게 하지 못할 때 “" + observation.fearedOutcome +
			"”는 걱정을 선택했습니다. 무엇을 지키려 하는지는 아직 분명하지 않았습니다."
		);
	} else if (hasIntent) {
		paragraphs.push(
			"이 반응이 지키거나 마련하려던 것으로는 “" +
			observation.protectiveIntent + "”" +
			setup.koreanParticle(observation.protectiveIntent, "이", "가") +
			" 남았습니다. 오늘은 걱정의 이유를 모두 알아내려 하지 않았습니다."
		);
	} else {
		paragraphs.push(
			"이 반응이 무엇을 걱정하고 무엇을 지키려 하는지는 아직 분명하지 않았습니다. 오늘은 이유를 알아내기보다 필요한 거리를 확인하는 데 머물렀습니다."
		);
	}

	paragraphs.push(
		hasDistance
			? "오늘은 이 반응을 없애기보다 “" +
				observation.preferredDistance + "”에서 살펴보았습니다."
			: "오늘은 알맞은 거리를 정하지 않은 상태도 그대로 기록했습니다."
	);

	return {
		roomId:roomId,
		title:setup.roomNarrativeTitle(roomId),
		name:name,
		nameIsUserDefined:!!String(
			(setup.ensureRoomInputs()[roomId] || {}).partName || ""
		).trim(),
		paragraphs:paragraphs,
		ownWords:observation.ownWords || ""
	};
};
setup.buildRelationshipSummary = function () {
	var observations = setup.captureAllRoomObservations();
	var lighthouse = observations.lighthouse;
	var wave = observations.wave;
	var fog = observations.fog;
	var enough =
		!setup.isUnknownObservation(lighthouse.action) &&
		!setup.isUnknownObservation(wave.action) &&
		!setup.isUnknownObservation(fog.action);

	if (!enough) {
		return {
			hasFlow:false,
			intro:"오늘은 세 반응을 각각 발견했습니다.",
			steps:[],
			closing:"이들이 어떤 순서로 이어지는지는 아직 정하지 않았습니다."
		};
	}
	return {
		hasFlow:true,
		intro:"이번 선택에서는 다음과 같은 흐름으로 이어질 가능성이 보였습니다.",
		steps:[
			"먼저 “" + lighthouse.action + "”의 방식으로 주변을 살핍니다.",
			"마음이 벅차오르면 “" + wave.action + "”의 방식으로 지금을 버팁니다.",
			"거리가 필요해지면 “" + fog.action + "”의 방식으로 잠시 멀어집니다."
		],
		closing:"이 흐름이 실제 경험과 다르다면, 사용자가 느끼는 순서가 더 중요합니다."
	};
};
setup.buildAllowedChanges = function () {
	var observations = setup.captureAllRoomObservations();
	var changes = [];
	var lighthouse = observations.lighthouse;
	var wave = observations.wave;
	var fog = observations.fog;

	if (setup.roomCompleted("lighthouse")) {
		changes.push(
			!setup.isUnknownObservation(lighthouse.preferredDistance)
				? "계속 살피는 반응을 완전히 멈추지 않고 “" +
					lighthouse.preferredDistance + "”에서 바라보았습니다."
				: "계속 살피는 반응이 걱정하는 일을 한 번 확인했습니다."
		);
	}
	if (setup.roomCompleted("wave")) {
		if (
			!setup.isUnknownObservation(wave.fearedOutcome) &&
			!setup.isUnknownObservation(wave.preferredDistance)
		) {
			changes.push(
				"급히 움직이는 반응이 걱정하는 결과를 한 번 확인하고 “" +
				wave.preferredDistance + "”를 선택했습니다."
			);
		} else if (!setup.isUnknownObservation(wave.preferredDistance)) {
			changes.push(
				"급히 움직이는 반응을 없애지 않고 “" +
				wave.preferredDistance + "”에서 바라보았습니다."
			);
		} else {
			changes.push("급히 움직이는 반응을 없애지 않고 움직임을 바라보았습니다.");
		}
	}
	if (setup.roomCompleted("fog")) {
		changes.push(
			!setup.isUnknownObservation(fog.preferredDistance)
				? "아직 분명하지 않은 내용에는 “" +
					fog.preferredDistance + "”만큼의 거리를 직접 정했습니다."
				: "모르는 상태를 그대로 남겨두었습니다."
		);
	}
	return changes;
};
setup.buildNextQuestion = function () {
	var variables = State.variables;
	var observations = setup.captureAllRoomObservations();
	var primary = setup.primaryRoom();

	if (variables.reportCorrection) {
		return "내가 고쳐 적은 문장은 다음 관측에서 어떻게 달라져 있을까요?";
	}
	if (
		variables.stateBehaviorSelection &&
		variables.stateBehaviorSelection.id === "keep_moving"
	) {
		return "쉬려고 할 때 나를 다시 움직이게 하는 것은 무엇일까요?";
	}
	if (primary === "lighthouse" || !setup.isUnknownObservation(observations.lighthouse.fearedOutcome)) {
		return "계속 살피지 않아도 괜찮다고 느끼는 순간이 있었나요?";
	}
	if (primary === "wave" || !setup.isUnknownObservation(observations.wave.action)) {
		return "마음이 벅차오를 때 가장 먼저 하게 되는 행동은 무엇인가요?";
	}
	return "아직 보지 않고 싶은 것을 그대로 두려면 어떤 거리가 필요할까요?";
};
setup.appendTextElement = function (parent, tagName, className, text) {
	var element = document.createElement(tagName);
	if (className) element.className = className;
	element.textContent = String(text == null ? "" : text);
	parent.appendChild(element);
	return element;
};
setup.renderReportReflection = function (host) {
	var variables = State.variables;
	host.replaceChildren();
	setup.appendTextElement(host, "h2", "", "이 기록은 지금의 나와 얼마나 닮아 있나요?");
	var choices = document.createElement("div");
	choices.className = "report-resonance-choices";
	[
		"많이 닮아 있다",
		"일부는 닮아 있다",
		"아직 잘 모르겠다",
		"나와 다르게 느껴진다"
	].forEach(function (label) {
		var button = document.createElement("button");
		button.type = "button";
		button.textContent = label;
		button.className = variables.reportResonance === label ? "is-selected" : "";
		button.addEventListener("click", function () {
			variables.reportResonance = label;
			if (label !== "일부는 닮아 있다" && label !== "나와 다르게 느껴진다") {
				variables.reportCorrection = "";
			}
			setup.persistRelationships();
			setup.renderReportReflection(host);
		});
		choices.appendChild(button);
	});
	host.appendChild(choices);

	if (
		variables.reportResonance === "일부는 닮아 있다" ||
		variables.reportResonance === "나와 다르게 느껴진다"
	) {
		var correction = document.createElement("div");
		correction.className = "report-correction";
		setup.appendTextElement(
			correction,
			"label",
			"",
			"다르게 느껴지는 부분을 내 말로 고쳐 적어주세요."
		);
		var textarea = document.createElement("textarea");
		textarea.rows = 4;
		textarea.maxLength = 500;
		textarea.value = variables.reportCorrection || "";
		textarea.placeholder = "이 기록에서 다르게 느껴지는 부분을 적어주세요.";
		correction.appendChild(textarea);
		var save = document.createElement("button");
		save.type = "button";
		save.textContent = "고쳐 쓴 문장을 남긴다";
		save.addEventListener("click", function () {
			var text = textarea.value.trim();
			if (!text) {
				textarea.focus();
				return;
			}
			variables.reportCorrection = text;
			setup.persistRelationships();
			setup.renderObservationReport();
		});
		correction.appendChild(save);
		host.appendChild(correction);
	}
};
setup.renderObservationReport = function () {
	var host = document.getElementById("observationReportHost");
	if (!host) return;
	var variables = State.variables;
	setup.captureAllRoomObservations();
	host.replaceChildren();

	if (variables.reportCorrection) {
		var correctionSection = document.createElement("section");
		correctionSection.className = "observation-section report-user-correction";
		setup.appendTextElement(correctionSection, "h2", "", "내가 고쳐 쓴 기록");
		setup.appendTextElement(correctionSection, "p", "", variables.reportCorrection);
		host.appendChild(correctionSection);
	}

	var initialStateSection = document.createElement("section");
	initialStateSection.className = "observation-section initial-state-record";
	setup.appendTextElement(initialStateSection, "h2", "", "관측을 시작할 때의 상태");
	var selectedState = String(
		(variables.stateSelection && variables.stateSelection.label) ||
		(variables.movementSelection && variables.movementSelection.label) ||
		"아직 적지 않음"
	).trim();
	setup.appendTextElement(initialStateSection, "p", "record-state-quote", "“" + selectedState + "”");
	var selectedBehavior = String(
		(variables.stateBehaviorSelection && variables.stateBehaviorSelection.label) ||
		""
	).trim();
	if (selectedBehavior) {
		setup.appendTextElement(
			initialStateSection,
			"p",
			"",
			"그럴 때 주로 하는 일로는 “" + selectedBehavior + "”를 남겼습니다."
		);
	}
	setup.appendTextElement(
		initialStateSection,
		"p",
		"section-note",
		"직접 적은 문장은 별도의 감정이나 심리 범주로 바꾸지 않고 그대로 기록했습니다."
	);
	host.appendChild(initialStateSection);

	var summarySection = document.createElement("section");
	summarySection.className = "observation-section observation-summary";
	setup.appendTextElement(summarySection, "h2", "", "오늘 가장 선명했던 반응");
	setup.buildObservationSummary().forEach(function (sentence) {
		setup.appendTextElement(summarySection, "p", "", sentence);
	});
	host.appendChild(summarySection);

	var roomsSection = document.createElement("section");
	roomsSection.className = "observation-section";
	setup.appendTextElement(roomsSection, "h2", "", "세 부분에서 발견한 내용");
	var roomGrid = document.createElement("div");
	roomGrid.className = "room-report-grid";
	setup.roomIds.forEach(function (room) {
		var narrative = setup.buildRoomNarrative(room);
		var card = document.createElement("article");
		card.className = "room-report-card room-report-card--" + room;
		setup.appendTextElement(card, "p", "room-report-eyebrow", setup.roomLabel(room));
		setup.appendTextElement(card, "h3", "", narrative.title);
		setup.appendTextElement(
			card,
			"p",
			"room-report-name",
			(narrative.nameIsUserDefined ? "내가 붙인 이름 · " : "기록해 둔 이름 · ") +
				narrative.name
		);
		narrative.paragraphs.forEach(function (paragraph) {
			setup.appendTextElement(card, "p", "", paragraph);
		});
		roomGrid.appendChild(card);
	});
	roomsSection.appendChild(roomGrid);
	host.appendChild(roomsSection);

	var relationship = setup.buildRelationshipSummary();
	var relationshipSection = document.createElement("section");
	relationshipSection.className = "observation-section relationship-summary";
	setup.appendTextElement(relationshipSection, "h2", "", "함께 나타나는 흐름");
	setup.appendTextElement(relationshipSection, "p", "", relationship.intro);
	if (relationship.hasFlow) {
		var flow = document.createElement("ol");
		flow.className = "relationship-flow";
		relationship.steps.forEach(function (step) {
			setup.appendTextElement(flow, "li", "", step);
		});
		relationshipSection.appendChild(flow);
	}
	setup.appendTextElement(relationshipSection, "p", "section-note", relationship.closing);
	host.appendChild(relationshipSection);

	var changeSection = document.createElement("section");
	changeSection.className = "observation-section";
	setup.appendTextElement(changeSection, "h2", "", "오늘 허용한 변화");
	var changeList = document.createElement("ul");
	changeList.className = "allowed-change-list";
	setup.buildAllowedChanges().forEach(function (change) {
		setup.appendTextElement(changeList, "li", "", change);
	});
	changeSection.appendChild(changeList);
	host.appendChild(changeSection);

	var weatherSection = document.createElement("section");
	weatherSection.className = "observation-section weather-record-section";
	setup.appendTextElement(weatherSection, "h2", "", "관측소에 나타난 오늘의 날씨");
	setup.appendTextElement(
		weatherSection,
		"p",
		"",
		"오늘의 선택은 관측소에서 다음과 같은 날씨로 표현되었습니다."
	);
	var weatherTags = document.createElement("div");
	weatherTags.className = "weather-record-tags";
	String(setup.weatherSummary() || "잔잔하고 열린 공기")
		.split(" · ")
		.forEach(function (label) {
			setup.appendTextElement(weatherTags, "span", "", label);
		});
	weatherSection.appendChild(weatherTags);
	var beforeWeather = setup.weatherVectorSummary(
		variables.weatherObserved || (variables.weatherContributions || {}).base
	);
	var afterWeather = setup.weatherSummary();
	setup.appendTextElement(
		weatherSection,
		"p",
		"weather-comparison-text",
		"처음 만든 날씨는 “" + beforeWeather + "”였고, 세 공간을 지난 뒤에는 “" +
			afterWeather + "”의 모습으로 남았습니다."
	);
	setup.appendTextElement(
		weatherSection,
		"p",
		"section-note",
		"이 날씨는 심리 상태에 대한 진단이 아니라, 오늘 선택한 반응을 시각적으로 기록한 결과입니다."
	);
	host.appendChild(weatherSection);

	var words = [];
	setup.roomIds.forEach(function (room) {
		var text = setup.roomOwnWords(room);
		if (text) words.push({ room:room, text:text });
	});
	if (words.length) {
		var wordsSection = document.createElement("section");
		wordsSection.className = "observation-section own-words-section";
		setup.appendTextElement(wordsSection, "h2", "", "내가 직접 남긴 말");
		words.forEach(function (item) {
			var quote = document.createElement("blockquote");
			setup.appendTextElement(quote, "span", "", setup.roomLabel(item.room));
			setup.appendTextElement(quote, "p", "", item.text);
			wordsSection.appendChild(quote);
		});
		host.appendChild(wordsSection);
	}

	var reflectionSection = document.createElement("section");
	reflectionSection.className = "observation-section report-reflection";
	reflectionSection.id = "reportReflectionHost";
	host.appendChild(reflectionSection);
	setup.renderReportReflection(reflectionSection);

	var nextSection = document.createElement("section");
	nextSection.className = "observation-section next-observation";
	setup.appendTextElement(nextSection, "h2", "", "다음에 살펴볼 질문");
	var nextQuestion = setup.buildNextQuestion();
	setup.appendTextElement(nextSection, "p", "next-question-text", nextQuestion);
	setup.appendTextElement(
		nextSection,
		"p",
		"section-note",
		"지금 답하지 않아도 됩니다. 다음 관측을 위한 질문으로만 남겨둘 수 있습니다."
	);
	var actions = document.createElement("div");
	actions.className = "record-actions";
	var saveQuestion = document.createElement("button");
	saveQuestion.type = "button";
	saveQuestion.textContent = variables.nextQuestionSaved &&
		variables.nextObservationQuestion === nextQuestion
		? "다음 관측에 남겨두었습니다"
		: "이 질문을 다음 관측에 남긴다";
	saveQuestion.disabled =
		variables.nextQuestionSaved &&
		variables.nextObservationQuestion === nextQuestion;
	saveQuestion.addEventListener("click", function () {
		variables.nextObservationQuestion = nextQuestion;
		variables.nextQuestionSaved = true;
		setup.persistRelationships();
		saveQuestion.textContent = "다음 관측에 남겨두었습니다";
		saveQuestion.disabled = true;
	});
	var finish = document.createElement("button");
	finish.type = "button";
	finish.textContent = "지금은 여기까지 기록한다";
	finish.addEventListener("click", function () { Engine.play("관측 종료"); });
	var returnButton = document.createElement("button");
	returnButton.type = "button";
	returnButton.textContent = "관측소로 돌아간다";
	returnButton.addEventListener("click", function () { Engine.play("관측소 허브"); });
	actions.appendChild(saveQuestion);
	actions.appendChild(finish);
	actions.appendChild(returnButton);
	nextSection.appendChild(actions);
	host.appendChild(nextSection);

	setup.persistRelationships();
};
setup.showRoomArrival = function (duration) {
	if (setup.roomArrivalTimer) clearTimeout(setup.roomArrivalTimer);
	document.body.classList.add("room-arriving");
	setup.roomArrivalTimer = setTimeout(function () {
		document.body.classList.remove("room-arriving");
	}, Number(duration || 2300));
};
setup.guideMarkup = function () {
	return `
	<button class="guide-close" type="button" aria-label="안내서 닫기">×</button>
	<nav class="guide-tabs" aria-label="관측소 안내서 목차">
		<button class="guide-tab is-active" data-guide-tab="station">관측소</button>
		<button class="guide-tab" data-guide-tab="principle">관측 원리</button>
		<button class="guide-tab" data-guide-tab="method">관측 방법</button>
		<button class="guide-tab" data-guide-tab="safety">IFS와 안전</button>
		<button class="guide-tab" data-guide-tab="credits">제작·데이터</button>
	</nav>
	<div class="guide-content">
		<section class="guide-panel is-active" data-guide-panel="station">
			<h1>내면 기상 관측소 안내서</h1>
			<p><strong>지금 내 안에서 움직이는 날씨와, 그 날씨가 무엇을 지키려 하는지 관측하는 인터랙티브 스토리입니다.</strong></p>
			<p>마음은 언제나 하나의 목소리로 움직이지 않습니다. 어떤 부분은 앞서 걱정하고, 어떤 부분은 감정을 덮어두며, 또 어떤 부분은 아무것도 느끼지 않게 함으로써 우리를 보호합니다.</p>
			<p>이 작품에서는 이러한 내면의 반응이 안개와 파도, 바람과 빛으로 나타납니다. 먼저 날씨의 요소를 직접 움직여 지금의 상태와 닮은 모습을 만들고, 몸의 감각과 세 공간에서 만나는 여러 움직임을 살펴봅니다.</p>
		</section>
		<section class="guide-panel" data-guide-panel="principle">
			<h1>관측 원리</h1>
			<p>관측은 감정을 분류하거나 더 좋은 상태로 바꾸는 과정이 아닙니다. 날씨를 정확하게 표현하고, 지금 일어나고 있는 반응과 어떤 거리에서 함께 있을지 살펴보는 과정입니다.</p>
			<ul>
				<li>지금 내 안에서 가장 크게 느껴지는 것은 무엇인가?</li>
				<li>이 부분은 나에게 무엇을 하게 하는가?</li>
				<li>그렇게 함으로써 무엇을 막거나 지키려 하는가?</li>
				<li>나는 이 부분을 어떤 마음으로 바라보고 있는가?</li>
				<li>지금 이 부분에게는 어느 정도의 거리가 필요한가?</li>
			</ul>
			<h2>날씨가 남아 있어도</h2>
			<p>이 관측소는 안개를 걷거나 파도를 잠재우기 위해 만들어진 곳이 아닙니다. 시야를 가리는 안개와 갑자기 높아지는 파도에도 나를 지키기 위해 생겨난 이유가 있을 수 있습니다.</p>
			<p>관측이 끝난 뒤에도 날씨는 남아 있을 수 있습니다. 다만 그 날씨가 언제 나타나고 무엇을 지키려 하는지 조금 더 알게 됩니다.</p>
		</section>
		<section class="guide-panel" data-guide-panel="method">
			<h1>관측 방법</h1>
			<ol>
				<li>안개·파도·비·바람·구름·빛을 움직여 지금의 날씨를 직접 만듭니다.</li>
				<li>그 날씨가 몸의 어디에서 어떤 질감으로 느껴지는지 확인합니다.</li>
				<li>관측소에서 등대·파도·안개의 공간을 원하는 순서로 살펴봅니다.</li>
				<li>각 공간에서 움직임이 하는 일, 걱정, 지키려는 것과 허락된 거리를 확인합니다.</li>
				<li>마지막에 가장 가까웠던 부분과 함께 있을 위치를 직접 정합니다.</li>
			</ol>
			<p>답에는 정답이나 오답이 없습니다. 어떤 공간의 움직임이 오늘 거의 느껴지지 않는다면, 그렇게 관측한 채 다음 공간으로 이동할 수 있습니다.</p>
		</section>
		<section class="guide-panel" data-guide-panel="safety">
			<h1>IFS와 안전</h1>
			<p>〈내면 기상 관측소〉는 리처드 슈워츠가 발전시킨 내면가족체계 모델(Internal Family Systems, IFS)에서 영감을 받았습니다.</p>
			<p>IFS는 마음을 하나의 목소리가 아니라 서로 다른 감정과 역할을 가진 여러 ‘부분’으로 바라봅니다. 과도해 보이는 반응에도 나를 지키려는 의도가 있을 수 있다는 관점을 제공합니다.</p>
			<p>이 작품은 IFS를 치료 절차로 재현하지 않습니다. 몸에서 느껴지는 감각을 먼저 살피고, 경험과 적절한 거리를 만들며, 날씨와 관측 장치를 통해 자신의 반응을 탐색하는 관점으로 옮긴 것입니다.</p>
			<p class="guide-note">이 작품은 심리치료나 의료적 진단을 제공하지 않습니다. 불편함이 커지면 언제든 관측을 멈출 수 있습니다.</p>
		</section>
		<section class="guide-panel" data-guide-panel="credits">
			<h1>제작·데이터</h1>
			<h2>제작 노트</h2>
			<p>말로 설명하기 어려운 내면의 반응을 공간과 날씨로 관측할 수 있다면 어떤 경험이 될지 묻는 데서 시작되었습니다. 자신의 반응을 제거하거나 평가하기보다, 그 반응이 맡아온 역할과 현재 필요한 거리를 발견하도록 설계했습니다.</p>
			<h2>크레딧</h2>
			<p>기획·경험 설계·글: 윤보라<br>3D 관측소 모델·인터랙션: 윤보라<br>프로토타입 개발: Twine · SugarCube · Babylon.js</p>
			<h2>개인정보 및 입력 데이터</h2>
			<p>선택과 입력 내용은 외부 서버로 전송되지 않으며 제작자가 수집하지 않습니다. 현재 날씨는 새 관측 때 다시 확인합니다. 방의 방문 횟수·발견한 보호 의도·필요한 거리는 다음 방문을 위해 이 브라우저에만 저장됩니다.</p>
			<div class="guide-actions"><button type="button" data-clear-memory>누적된 관계 기록 지우기</button></div>
			<p>3D 라이브러리를 불러오는 일반적인 네트워크 요청에는 사용자의 선택이나 입력 문장이 포함되지 않습니다.</p>
		</section>
	</div>`;
};
setup.openGuide = function () {
	var dialog = document.getElementById("station-guide");
	if (!dialog) {
		dialog = document.createElement("dialog");
		dialog.id = "station-guide";
		dialog.className = "guide-dialog";
		dialog.innerHTML = setup.guideMarkup();
		document.body.appendChild(dialog);
		dialog.querySelector(".guide-close").addEventListener("click", function () { dialog.close(); });
		dialog.addEventListener("click", function (event) {
			if (event.target === dialog) dialog.close();
		});
		dialog.querySelectorAll(".guide-tab").forEach(function (button) {
			button.addEventListener("click", function () {
				var tab = button.getAttribute("data-guide-tab");
				dialog.querySelectorAll(".guide-tab").forEach(function (item) {
					item.classList.toggle("is-active", item === button);
				});
				dialog.querySelectorAll(".guide-panel").forEach(function (panel) {
					panel.classList.toggle("is-active", panel.getAttribute("data-guide-panel") === tab);
				});
				if (setup.weatherStation && setup.weatherStation.frame) {
					setup.weatherStation.frame.contentWindow.postMessage({ type:"guide-tab", tab:tab }, "*");
				}
			});
		});
		dialog.querySelector("[data-clear-memory]").addEventListener("click", function () {
			setup.clearRelationships();
			this.textContent = "누적된 관계 기록을 지웠습니다";
			this.disabled = true;
		});
		dialog.addEventListener("close", function () {
			if (setup.weatherStation && setup.weatherStation.frame) {
				setup.weatherStation.frame.contentWindow.postMessage({ type:"guide-close" }, "*");
			}
		});
	}
	dialog.showModal();
	if (setup.weatherStation && setup.weatherStation.frame) {
		setup.weatherStation.frame.contentWindow.postMessage({ type:"guide-open" }, "*");
	}
};
/* BEGIN INNER WEATHER AUDIO ENGINE (Native Web Audio, offline) */
setup.audio = (function () {
	var AudioContextClass = window.AudioContext || window.webkitAudioContext;
	var storageKey = "inner-weather-observatory-audio-muted";
	var sceneIds = ["hub", "lighthouse", "wave", "abyss", "fog", "record"];
	var context = null;
	var master = null;
	var limiter = null;
	var buses = {};
	var layers = {};
	var runningSources = [];
	var sparseTimer = null;
	var variationTimer = null;
	var suspendedTimer = null;
	var visibilityHandler = null;
	var startedByUser = false;
	var readingActive = true;
	var masterVolume = 0.42;
	var lighthouseRotation = 0.34;
	var lastSfxAt = {};
	var weather = { fog:0.15, rain:0, wave:0.2, wind:0.15, cloud:0.25, light:0.55 };
	var abyss = {
		drive:"unclear", fear:"unknown", depth:0, turbulence:0.3,
		visibility:0.3, currentSpeed:0.26, lightPulse:0.24, soundPressure:0.28
	};

	function readMutedPreference() {
		try { return localStorage.getItem(storageKey) === "true"; }
		catch (error) { return false; }
	}

	var api = {
		initialized:false,
		muted:readMutedPreference(),
		currentScene:null,
		init:init,
		start:start,
		setScene:setScene,
		setWeather:setWeather,
		setAbyssState:setAbyssState,
		playSfx:playSfx,
		setMuted:setMuted,
		setMasterVolume:setMasterVolume,
		stopAll:stopAll,
		dispose:dispose,
		setReadingActive:setReadingActive,
		setLighthouseRotation:setLighthouseRotation,
		debugState:function () {
			return {
				initialized:api.initialized,
				muted:api.muted,
				currentScene:api.currentScene,
				contextState:context ? context.state : "not-created",
				sourceCount:runningSources.length
			};
		}
	};

	function clamp(value, min, max) {
		return Math.max(min, Math.min(max, Number(value) || 0));
	}

	function safeNow() {
		return context ? context.currentTime : 0;
	}

	function ramp(param, value, seconds) {
		if (!context || !param) return;
		var now = safeNow();
		var target = Number(value) || 0;
		try {
			param.cancelScheduledValues(now);
			param.setValueAtTime(param.value, now);
			param.linearRampToValueAtTime(target, now + Math.max(0.02, seconds || 0.02));
		} catch (error) {
			param.value = target;
		}
	}

	function targetMasterGain(seconds) {
		if (!master) return;
		var visibleScale = document.hidden ? 0.16 : 1;
		ramp(master.gain, api.muted ? 0 : masterVolume * visibleScale, seconds || 0.45);
	}

	function createNoiseBuffer(kind, seconds) {
		var length = Math.max(1, Math.floor(context.sampleRate * (seconds || 8)));
		var buffer = context.createBuffer(1, length, context.sampleRate);
		var data = buffer.getChannelData(0);
		var brown = 0;
		for (var index = 0; index < length; index += 1) {
			var white = Math.random() * 2 - 1;
			if (kind === "brown") {
				brown = brown * 0.985 + white * 0.015;
				data[index] = brown * 3.2;
			} else if (kind === "soft") {
				brown = brown * 0.94 + white * 0.06;
				data[index] = brown * 1.8;
			} else {
				data[index] = white * 0.72;
			}
		}
		return buffer;
	}

	function addNoise(scene, name, options) {
		var source = context.createBufferSource();
		var filter = context.createBiquadFilter();
		var gain = context.createGain();
		source.buffer = createNoiseBuffer(options.kind || "brown", options.seconds || 9);
		source.loop = true;
		filter.type = options.filterType || "lowpass";
		filter.frequency.value = options.frequency || 600;
		filter.Q.value = options.q || 0.5;
		gain.gain.value = options.gain || 0;
		source.connect(filter).connect(gain).connect(buses[scene].input);
		source.start();
		runningSources.push(source);
		layers[scene][name] = { source:source, filter:filter, gain:gain };
		return layers[scene][name];
	}

	function addTone(scene, name, options) {
		var oscillator = context.createOscillator();
		var filter = context.createBiquadFilter();
		var gain = context.createGain();
		oscillator.type = options.type || "sine";
		oscillator.frequency.value = options.frequency || 55;
		filter.type = "lowpass";
		filter.frequency.value = options.cutoff || 440;
		gain.gain.value = options.gain || 0;
		oscillator.connect(filter).connect(gain).connect(buses[scene].input);
		oscillator.start();
		runningSources.push(oscillator);
		layers[scene][name] = { source:oscillator, filter:filter, gain:gain };
		return layers[scene][name];
	}

	function createBus(scene) {
		var input = context.createGain();
		var filter = context.createBiquadFilter();
		var panner = context.createStereoPanner ? context.createStereoPanner() : context.createGain();
		var gain = context.createGain();
		var delay = context.createDelay(2.2);
		var feedback = context.createGain();
		var wet = context.createGain();
		filter.type = "lowpass";
		filter.frequency.value = 12000;
		gain.gain.value = 0;
		delay.delayTime.value = scene === "abyss" ? 0.72 : (scene === "fog" ? 0.34 : 0.48);
		feedback.gain.value = scene === "abyss" ? 0.22 : 0.12;
		wet.gain.value = scene === "abyss" ? 0.16 : 0.07;
		input.connect(filter).connect(panner).connect(gain).connect(master);
		filter.connect(delay).connect(feedback).connect(delay);
		delay.connect(wet).connect(gain);
		buses[scene] = {
			input:input, filter:filter, panner:panner, gain:gain,
			delay:delay, feedback:feedback, wet:wet
		};
		layers[scene] = {};
	}

	function createLayerGraph() {
		sceneIds.forEach(createBus);

		addNoise("hub", "air", { kind:"brown", frequency:760, gain:0.006 });
		addNoise("hub", "wind", { kind:"soft", filterType:"bandpass", frequency:430, q:0.42, gain:0.004 });
		addNoise("hub", "rain", { kind:"white", filterType:"highpass", frequency:2700, gain:0 });
		addTone("hub", "machine", { type:"triangle", frequency:51, cutoff:170, gain:0.0015 });
		addTone("hub", "brass", { type:"sine", frequency:112, cutoff:680, gain:0.0005 });

		addNoise("lighthouse", "wind", { kind:"brown", filterType:"bandpass", frequency:520, q:0.38, gain:0.005 });
		addNoise("lighthouse", "sweep", { kind:"soft", filterType:"bandpass", frequency:720, q:0.58, gain:0.002 });
		addTone("lighthouse", "machine", { type:"triangle", frequency:54, cutoff:210, gain:0.002 });
		addTone("lighthouse", "lens", { type:"sine", frequency:168, cutoff:880, gain:0.0007 });
		if (buses.lighthouse.panner.pan) {
			var panLfo = context.createOscillator();
			var panDepth = context.createGain();
			panLfo.type = "sine";
			panLfo.frequency.value = 0.055;
			panDepth.gain.value = 0.72;
			panLfo.connect(panDepth).connect(buses.lighthouse.panner.pan);
			panLfo.start();
			runningSources.push(panLfo);
			layers.lighthouse.panLfo = { source:panLfo, gain:panDepth };
		}

		addNoise("wave", "water", { kind:"brown", frequency:310, q:0.72, gain:0.009 });
		addNoise("wave", "current", { kind:"soft", filterType:"bandpass", frequency:145, q:0.62, gain:0.006 });
		addNoise("wave", "surfaceRain", { kind:"white", filterType:"highpass", frequency:1850, gain:0 });
		addTone("wave", "resonance", { type:"sine", frequency:47, cutoff:125, gain:0.0026 });

		addNoise("abyss", "pressure", { kind:"brown", frequency:175, q:0.76, gain:0.008 });
		addNoise("abyss", "distance", { kind:"soft", filterType:"bandpass", frequency:105, q:0.72, gain:0.004 });
		addTone("abyss", "drone", { type:"sine", frequency:39, cutoff:105, gain:0.003 });
		addTone("abyss", "overtone", { type:"sine", frequency:71, cutoff:150, gain:0.0007 });

		addNoise("fog", "dryWind", { kind:"soft", filterType:"bandpass", frequency:690, q:0.48, gain:0.005 });
		addNoise("fog", "rope", { kind:"brown", filterType:"highpass", frequency:920, q:0.32, gain:0.0007 });
		addTone("fog", "wood", { type:"triangle", frequency:82, cutoff:245, gain:0.0008 });
		addTone("fog", "farLight", { type:"sine", frequency:126, cutoff:520, gain:0.0002 });

		addNoise("record", "air", { kind:"brown", frequency:520, gain:0.004 });
		addTone("record", "resonance", { type:"sine", frequency:109, cutoff:520, gain:0.0008 });
	}

	function init() {
		if (api.initialized) return true;
		if (!startedByUser || !AudioContextClass) return false;
		context = new AudioContextClass({ latencyHint:"playback" });
		master = context.createGain();
		limiter = context.createDynamicsCompressor();
		limiter.threshold.value = -20;
		limiter.knee.value = 12;
		limiter.ratio.value = 14;
		limiter.attack.value = 0.004;
		limiter.release.value = 0.32;
		master.gain.value = 0;
		master.connect(limiter).connect(context.destination);
		createLayerGraph();
		api.initialized = true;
		visibilityHandler = function () {
			targetMasterGain(document.hidden ? 1.2 : 0.8);
		};
		document.addEventListener("visibilitychange", visibilityHandler);
		setWeather(weather);
		setAbyssState(abyss);
		scheduleSparse();
		scheduleVariation();
		return true;
	}

	function start() {
		startedByUser = true;
		if (!init()) return false;
		if (suspendedTimer) {
			clearTimeout(suspendedTimer);
			suspendedTimer = null;
		}
		var resumeResult = context.state === "suspended" ? context.resume() : Promise.resolve();
		Promise.resolve(resumeResult).then(function () {
			targetMasterGain(1.2);
		}).catch(function () {});
		setScene(api.currentScene || "hub");
		if (typeof setup.renderSoundControl === "function") setup.renderSoundControl();
		return true;
	}

	function setScene(sceneId) {
		if (sceneIds.indexOf(sceneId) === -1) sceneId = "hub";
		api.currentScene = sceneId;
		if (typeof setup.renderSoundControl === "function") setup.renderSoundControl();
		if (!api.initialized) return;
		sceneIds.forEach(function (id) {
			ramp(buses[id].gain.gain, id === sceneId ? 1 : 0, 3.0);
		});
		setWeather(weather);
		if (sceneId === "abyss") setAbyssState(abyss);
	}

	function setWeather(nextWeather) {
		weather = Object.assign({}, weather, nextWeather || {});
		Object.keys(weather).forEach(function (key) { weather[key] = clamp(weather[key], 0, 1); });
		if (!api.initialized) return;
		var fogDamping = weather.fog * 0.62 + weather.cloud * 0.30;
		var worldCutoff = 1250 + (1 - fogDamping) * 10800;
		sceneIds.forEach(function (id) {
			var sceneCutoff = id === "wave" ? Math.min(worldCutoff, 880) :
				(id === "abyss" ? Math.min(worldCutoff, 340) :
				(id === "fog" ? Math.min(worldCutoff, 1950) : worldCutoff));
			ramp(buses[id].filter.frequency, sceneCutoff, 2.8);
		});

		ramp(layers.hub.air.gain.gain, 0.0045 + (1 - weather.wind) * 0.0025, 2.6);
		ramp(layers.hub.wind.gain.gain, 0.002 + weather.wind * 0.009, 2.6);
		ramp(layers.hub.wind.filter.frequency, 300 + weather.wind * 610, 2.8);
		ramp(layers.hub.rain.gain.gain, weather.rain * 0.0055, 2.8);
		ramp(layers.hub.machine.gain.gain, 0.0012 + weather.wind * 0.0011, 2.8);
		ramp(layers.hub.brass.gain.gain, 0.00025 + weather.light * 0.00115, 3.2);
		ramp(layers.hub.brass.filter.frequency, 280 + weather.light * 920, 3.2);

		ramp(layers.lighthouse.wind.gain.gain, 0.0028 + weather.wind * 0.008, 2.8);
		ramp(layers.lighthouse.wind.filter.frequency, 330 + weather.wind * 640, 2.8);
		ramp(layers.lighthouse.lens.gain.gain, 0.0003 + weather.light * 0.0016, 3);
		ramp(layers.lighthouse.lens.filter.frequency, 360 + weather.light * 1050, 3);
		updateLighthouseSound();

		ramp(layers.wave.water.gain.gain, 0.006 + weather.wave * 0.011, 2.8);
		ramp(layers.wave.current.gain.gain, 0.003 + weather.wave * 0.007, 2.8);
		ramp(layers.wave.surfaceRain.gain.gain, weather.rain * 0.0042, 2.8);
		ramp(layers.wave.resonance.gain.gain, 0.0016 + weather.wave * 0.0021, 2.8);

		ramp(layers.fog.dryWind.gain.gain, 0.0024 + weather.wind * 0.009, 2.8);
		ramp(layers.fog.dryWind.filter.frequency, 370 + weather.wind * 720 - weather.fog * 250, 2.8);
		ramp(layers.fog.rope.gain.gain, 0.0002 + weather.wind * 0.0014, 2.8);
		ramp(layers.fog.wood.gain.gain, 0.00035 + weather.wind * 0.001, 2.8);
		ramp(layers.fog.farLight.gain.gain, weather.light * (1 - weather.fog * 0.72) * 0.0017, 3.2);

		ramp(layers.record.resonance.gain.gain, 0.00035 + weather.light * 0.001, 3.2);
	}

	function setAbyssState(nextAbyss) {
		abyss = Object.assign({}, abyss, nextAbyss || {});
		abyss.depth = clamp(abyss.depth, 0, 3);
		abyss.turbulence = clamp(abyss.turbulence, 0, 1);
		abyss.visibility = clamp(abyss.visibility, 0, 1);
		abyss.currentSpeed = clamp(abyss.currentSpeed, 0, 1);
		abyss.lightPulse = clamp(abyss.lightPulse, 0, 1);
		abyss.soundPressure = clamp(abyss.soundPressure, 0, 1);
		if (!api.initialized) return;
		var depthRatio = abyss.depth / 3;
		var cutoff = 370 - depthRatio * 235;
		var drive = String(abyss.drive || "unclear");
		var fear = String(abyss.fear || "unknown");
		var density = 0.35 + abyss.turbulence * 0.42;
		if (drive === "chased") density += 0.18;
		if (drive === "desire") density -= 0.14;
		if (fear === "overwhelm") density += 0.16;
		if (fear === "stillness") density -= 0.18;
		ramp(buses.abyss.filter.frequency, cutoff, 2.4);
		ramp(buses.abyss.feedback.gain, 0.15 + depthRatio * 0.15, 2.8);
		ramp(layers.abyss.pressure.gain.gain, 0.004 + density * 0.008, 2.6);
		ramp(layers.abyss.distance.gain.gain, 0.0018 + abyss.currentSpeed * 0.005, 2.6);
		ramp(layers.abyss.drone.gain.gain, 0.0018 + abyss.soundPressure * 0.0032, 2.6);
		ramp(layers.abyss.overtone.gain.gain, 0.00025 + abyss.lightPulse * 0.001, 3);
		ramp(layers.abyss.pressure.filter.frequency, cutoff, 2.4);
		ramp(layers.abyss.drone.source.frequency,
			fear === "stillness" ? 43 : (drive === "chased" ? 52 : 39), 2.2);
		if (buses.abyss.panner.pan) {
			ramp(
				buses.abyss.panner.pan,
				drive === "chased" ? 0.42 : (drive === "desire" ? 0.08 : -0.08),
				3.2
			);
		}
	}

	function setLighthouseRotation(modeOrValue) {
		var speeds = { fast:1.08, hold:0.055, pause:0, current:0.34 };
		lighthouseRotation = Object.prototype.hasOwnProperty.call(speeds, modeOrValue)
			? speeds[modeOrValue]
			: clamp(modeOrValue, 0, 1.2);
		if (api.initialized) updateLighthouseSound();
	}

	function updateLighthouseSound() {
		if (!api.initialized) return;
		ramp(layers.lighthouse.machine.source.frequency, 50 + lighthouseRotation * 26, 0.8);
		ramp(layers.lighthouse.machine.gain.gain, 0.0016 + lighthouseRotation * 0.0035, 0.8);
		ramp(layers.lighthouse.sweep.gain.gain, 0.001 + lighthouseRotation * 0.004, 0.8);
		if (layers.lighthouse.panLfo) {
			ramp(layers.lighthouse.panLfo.source.frequency, 0.018 + lighthouseRotation * 0.16, 0.8);
		}
	}

	function oneShotTone(frequencies, options) {
		if (!api.initialized || api.muted || document.hidden) return;
		options = options || {};
		var destination = options.destination || master;
		var now = safeNow();
		var duration = options.duration || 0.75;
		frequencies.forEach(function (frequency, index) {
			var oscillator = context.createOscillator();
			var filter = context.createBiquadFilter();
			var gain = context.createGain();
			oscillator.type = options.type || "sine";
			oscillator.frequency.setValueAtTime(frequency, now);
			if (options.endFrequency) {
				oscillator.frequency.exponentialRampToValueAtTime(
					Math.max(20, options.endFrequency * (1 + index * 0.015)),
					now + duration
				);
			}
			filter.type = "lowpass";
			filter.frequency.value = options.cutoff || 1100;
			gain.gain.setValueAtTime(0, now);
			gain.gain.linearRampToValueAtTime((options.gain || 0.008) / (index + 1), now + 0.04);
			gain.gain.exponentialRampToValueAtTime(0.00001, now + duration);
			oscillator.connect(filter).connect(gain).connect(destination);
			oscillator.start(now);
			oscillator.stop(now + duration + 0.08);
		});
	}

	function noiseBurst(options) {
		if (!api.initialized || api.muted || document.hidden) return;
		options = options || {};
		var source = context.createBufferSource();
		var filter = context.createBiquadFilter();
		var gain = context.createGain();
		var now = safeNow();
		var duration = options.duration || 0.8;
		source.buffer = createNoiseBuffer(options.kind || "soft", Math.max(0.25, duration + 0.1));
		filter.type = options.filterType || "lowpass";
		filter.frequency.value = options.frequency || 420;
		filter.Q.value = options.q || 0.5;
		gain.gain.setValueAtTime(0, now);
		gain.gain.linearRampToValueAtTime(options.gain || 0.007, now + Math.min(0.12, duration * 0.25));
		gain.gain.exponentialRampToValueAtTime(0.00001, now + duration);
		source.connect(filter).connect(gain).connect(options.destination || master);
		source.start(now);
		source.stop(now + duration + 0.08);
	}

	function playSfx(sfxId) {
		if (!api.initialized || api.muted) return;
		var active = document.activeElement;
		if (active && active.matches && active.matches("input, textarea, [contenteditable='true']")) return;
		var nowMs = Date.now();
		var cooldowns = {
			choice:240, roomEnter:900, roomComplete:1200, drawerOpen:900,
			submerge:1200, surface:1200, fogReveal:900, lighthouse:650
		};
		if (nowMs - (lastSfxAt[sfxId] || 0) < (cooldowns[sfxId] || 450)) return;
		lastSfxAt[sfxId] = nowMs;
		if (sfxId === "choice") {
			oneShotTone([176, 264], { type:"sine", gain:0.006, duration:0.42, cutoff:760 });
		} else if (sfxId === "roomEnter") {
			noiseBurst({ kind:"brown", frequency:360, gain:0.009, duration:1.4 });
		} else if (sfxId === "roomComplete") {
			oneShotTone([132, 176], { type:"sine", gain:0.006, duration:1.2, cutoff:620 });
		} else if (sfxId === "drawerOpen") {
			noiseBurst({ kind:"soft", filterType:"bandpass", frequency:190, q:0.9, gain:0.009, duration:0.78 });
		} else if (sfxId === "submerge") {
			noiseBurst({ kind:"brown", frequency:250, gain:0.012, duration:1.8 });
		} else if (sfxId === "surface") {
			noiseBurst({ kind:"soft", filterType:"bandpass", frequency:540, q:0.45, gain:0.008, duration:1.5 });
		} else if (sfxId === "fogReveal") {
			noiseBurst({ kind:"soft", filterType:"bandpass", frequency:760, q:0.35, gain:0.006, duration:1.35 });
		} else if (sfxId === "lighthouse") {
			oneShotTone([126, 189], { type:"sine", gain:0.0045, duration:0.85, cutoff:920 });
		}
	}

	function scheduleSparse() {
		if (sparseTimer) clearTimeout(sparseTimer);
		var wait = 4200 + Math.random() * 5200;
		sparseTimer = setTimeout(function tick() {
			if (api.initialized && !api.muted && !document.hidden && api.currentScene) {
				var densityScale = readingActive ? 0.42 : 1;
				var chance = densityScale * 0.38;
				if (api.currentScene === "hub" && Math.random() < chance) {
					if (Math.random() < 0.66) {
						oneShotTone([96 + weather.light * 26], {
							type:"sine", gain:0.0026 + weather.light * 0.0018,
							duration:2.8, cutoff:460 + weather.light * 520,
							destination:buses.hub.input
						});
					} else {
						oneShotTone([740], { type:"sine", gain:0.0012, duration:0.16, cutoff:1100, destination:buses.hub.input });
					}
				} else if (api.currentScene === "lighthouse" && Math.random() < chance * 0.9) {
					oneShotTone([154 + weather.light * 34], {
						type:"sine", gain:0.0025, duration:2.1,
						cutoff:640 + weather.light * 480, destination:buses.lighthouse.input
					});
				} else if (api.currentScene === "wave" && Math.random() < chance * 0.8) {
					noiseBurst({ kind:"soft", filterType:"bandpass", frequency:270, q:0.8, gain:0.0034, duration:0.65, destination:buses.wave.input });
				} else if (api.currentScene === "abyss" && Math.random() < chance * (0.48 + abyss.turbulence * 0.28)) {
					oneShotTone([62 + abyss.depth * 4], {
						type:"sine", gain:0.0025 + abyss.soundPressure * 0.0015,
						duration:3.8 + abyss.depth * 0.7, cutoff:180, destination:buses.abyss.input
					});
				} else if (api.currentScene === "fog" && Math.random() < chance * (0.62 + weather.wind * 0.18)) {
					oneShotTone([76 + weather.wind * 14], {
						type:"triangle", gain:0.002, duration:1.7,
						cutoff:230, destination:buses.fog.input
					});
				} else if (api.currentScene === "record" && Math.random() < chance * 0.5) {
					oneShotTone([109, 163.5], {
						type:"sine", gain:0.0024, duration:3.2,
						cutoff:600, destination:buses.record.input
					});
				}
			}
			scheduleSparse();
		}, wait);
	}

	function scheduleVariation() {
		if (variationTimer) clearTimeout(variationTimer);
		var wait = 40000 + Math.random() * 50000;
		variationTimer = setTimeout(function vary() {
			if (api.initialized && !document.hidden) {
				var drift = 0.88 + Math.random() * 0.24;
				sceneIds.forEach(function (id) {
					ramp(buses[id].wet.gain, (id === "abyss" ? 0.16 : 0.07) * drift, 12);
				});
				ramp(layers.hub.machine.source.frequency, 48 + Math.random() * 8, 16);
				ramp(layers.record.resonance.source.frequency, 104 + Math.random() * 10, 18);
			}
			scheduleVariation();
		}, wait);
	}

	function setReadingActive(value) {
		readingActive = value !== false;
	}

	function setMuted(value) {
		api.muted = !!value;
		try { localStorage.setItem(storageKey, String(api.muted)); } catch (error) {}
		if (api.initialized) targetMasterGain(0.45);
		if (typeof setup.renderSoundControl === "function") setup.renderSoundControl();
	}

	function setMasterVolume(value) {
		masterVolume = clamp(value, 0, 1);
		if (api.initialized) targetMasterGain(0.5);
	}

	function stopAll() {
		if (!api.initialized) return;
		sceneIds.forEach(function (id) { ramp(buses[id].gain.gain, 0, 1.4); });
		ramp(master.gain, 0, 1.4);
		if (suspendedTimer) clearTimeout(suspendedTimer);
		suspendedTimer = setTimeout(function () {
			if (context && context.state === "running") context.suspend().catch(function () {});
		}, 1700);
	}

	function dispose() {
		if (sparseTimer) clearTimeout(sparseTimer);
		if (variationTimer) clearTimeout(variationTimer);
		if (suspendedTimer) clearTimeout(suspendedTimer);
		sparseTimer = variationTimer = suspendedTimer = null;
		if (visibilityHandler) document.removeEventListener("visibilitychange", visibilityHandler);
		visibilityHandler = null;
		runningSources.forEach(function (source) {
			try { source.stop(); } catch (error) {}
			try { source.disconnect(); } catch (error) {}
		});
		runningSources = [];
		if (context) {
			try { context.close(); } catch (error) {}
		}
		context = master = limiter = null;
		buses = {};
		layers = {};
		api.initialized = false;
		api.currentScene = null;
		startedByUser = false;
	}

	return api;
}());

setup.renderSoundControl = function () {
	var button = document.getElementById("global-sound");
	if (!button) return;
	var action = setup.audio.muted ? "소리 켜기" : "소리 끄기";
	button.textContent = action;
	button.setAttribute("aria-label", action);
	button.setAttribute("aria-pressed", String(!setup.audio.muted));
	var debug = setup.audio.debugState();
	button.dataset.audioInitialized = String(debug.initialized);
	button.dataset.audioContext = debug.contextState;
	button.dataset.audioScene = debug.currentScene || "";
	button.dataset.audioSources = String(debug.sourceCount);
};

setup.startAmbience = function () {
	setup.audio.start();
	setup.audio.setScene("hub");
	setup.audio.setWeather(State.variables.weatherState || {});
	setup.ambience = setup.audio;
	if (setup.weatherStation && setup.weatherStation.frame) {
		setup.weatherStation.frame.contentWindow.postMessage({ type:"observation-start" }, "*");
	}
};
/* END INNER WEATHER AUDIO ENGINE */

setup.ensureWeatherStation = function () {
	var mount = document.getElementById("station-backdrop");
	if (!mount) {
		mount = document.createElement("div");
		mount.id = "station-backdrop";
		document.body.insertBefore(mount, document.body.firstChild);
	}
	if (!setup.weatherStation || !setup.weatherStation.frame || !setup.weatherStation.frame.isConnected) {
		mount.innerHTML = "";
		var frame = document.createElement("iframe");
		frame.id = "weather-station-original";
		frame.title = "휴대용 내면 기상 관측소 Babylon 3D";
		frame.setAttribute("allow", "fullscreen");
		var binary = atob(window.WEATHER_STATION_IFRAME_B64);
		var bytes = new Uint8Array(binary.length);
		for (var byteIndex = 0; byteIndex < binary.length; byteIndex++) {
			bytes[byteIndex] = binary.charCodeAt(byteIndex);
		}
		frame.srcdoc = new TextDecoder("utf-8").decode(bytes);
		mount.appendChild(frame);
		function sync() {
			var variables = State.variables;
			var displayPartNames = Object.assign({}, variables.partNames || {});
			var waveInput = variables.roomInputs && variables.roomInputs.wave;
			if (
				waveInput &&
				waveInput.usedDefaultName === true &&
				!String(waveInput.partName || "").trim()
			) {
				displayPartNames.wave = "아직 이름을 붙이지 않은 반응";
			}
			var state = variables.weatherState || { fog:.15, rain:0, wave:.2, wind:.15, cloud:.25, light:.55 };
			var weather = {
				precip: state.rain > .08 ? "rain" : "clear",
				sea: state.wave > .66 ? "storm" : (state.wave > .3 ? "swell" : "calm"),
				sky: setup.clampWeather(.3 + state.light * .55 - state.cloud * .22 - state.fog * .12)
			};
			frame.style.filter = "";
			if (frame.contentWindow) {
				frame.contentWindow.postMessage({
					type: "inner-weather-sync", weather: weather,
					roomMode: passage() === "관측소 허브",
					target: passage() === "관측소 허브" ? "hub" : "",
					storyState: {
						sceneMode: variables.sceneMode || "hub",
						weatherMode: variables.weatherMode || "",
						selfLight: .18,
						secondHeard: !!variables.secondHeard,
						permissionMode: variables.permissionMode || "",
						visited: variables.visited || {},
						trust: variables.trust || {},
						roomState: variables.roomState || {},
						partNames: displayPartNames,
						uiRaised: document.body.classList.contains("observation-ui"),
						weatherState: {
							fog: state.fog, wave: state.wave, rain: state.rain,
							wind: state.wind, cloud: state.cloud, light: state.light
						}
					}
				}, "*");
			}
		}
		frame.addEventListener("load", function () {
			setTimeout(sync, 700);
			setTimeout(sync, 1800);
		});
		setup.weatherStation = { frame: frame, sync: sync };
	} else {
		setup.weatherStation.sync();
	}
};

$(document).on(":passagedisplay", function () {
	setup.ensureObservationSchema();
	if (setup.roomIds.indexOf(State.variables.currentRoom) !== -1) {
		setup.captureRoomObservation(State.variables.currentRoom);
		setup.persistRelationships();
	}
	var stageMap = {
		"ABOUT":"About",
		"첫 진입":"관측 전","들어다보기":"현재 상태","상태 직접 적기":"현재 상태",
		"상태에서의 행동":"현재 반응","행동 직접 적기":"현재 반응",
		"멈추기 어려운 감각":"현재 반응","마음의 시야":"현재 상태",
		"날씨 만들기":"날씨 만들기","몸의 자리":"몸의 감각","감각의 질감":"몸의 감각","떠오르는 장면":"몸의 감각",
		"관측소 허브":"관측소","현재 날씨 재관측":"현재 날씨",
		"등대 진입":"등대의 방","등대 빛의 속도":"등대의 방","등대의 걱정":"등대의 방","등대의 반응":"등대의 방","등대 이름":"등대의 방",
		"파도 진입":"파도의 방","파도 원하는 힘":"파도의 방","파도 멈춤의 불안":"파도의 방",
		"파도 구별하기":"파도의 방","파도 보호 의도":"파도의 방","파도 머무는 위치":"파도의 방",
		"파도 심연":"파도의 방","파도 심연 조절":"파도의 방",
		"파도가 막고 있는 것":"파도의 방","파도의 허락":"파도의 방",
		"파도 깊이":"파도의 방","파도 실루엣":"파도의 방","파도 거리":"파도의 방","파도 수면":"파도의 방",
		"파도 반응":"파도의 방","파도의 의도":"파도의 방","파도 이름":"파도의 방",
		"안개 진입":"안개의 방","안개가 마련한 것":"안개의 방","안개가 정한 거리":"안개의 방",
		"안개 이름 역할":"안개의 방","안개 이름 이미지":"안개의 방","안개 이름 제안":"안개의 방","안개 이름 확인":"안개의 방",
		"안개 반응":"안개의 방","안개의 이유":"안개의 방","안개 속 기다림":"안개의 방","안개 이름":"안개의 방",
		"이름 바꾸기":"부분 이름","이름 변경 확인":"부분 이름",
		"부분의 몸 감각":"몸의 감각","부분을 바라보는 마음":"바라보는 마음","함께 있는 다른 부분":"함께 있는 마음",
		"멈추면 걱정되는 일":"부분의 걱정","지키려는 것":"보호 의도","더 살펴볼 허락":"허락",
		"필요한 관측 조건":"관측 조건","부분 이름":"부분 이름","방의 날씨 조정":"방의 날씨",
		"가까웠던 부분":"관측 정리","관찰 위치":"관측 정리","작은 행동":"관측 정리","마지막 날씨 조정":"관측 정리",
		"날씨 기록":"날씨 기록",
		"비상 복귀":"현재 복귀","관측 종료":"종료"
	};
	setup.updateWeatherLabel();
	$("#stage").text(stageMap[passage()] || "관측 중");
	$("#weather-data").text(State.variables.weatherLabel || "—");
	$("#distance-data").text(State.variables.distancePhrase || "—");
	var discoveryPassages = [
		"첫 진입","들어다보기","상태 직접 적기","상태에서의 행동","행동 직접 적기",
		"멈추기 어려운 감각","마음의 시야","날씨 만들기","몸의 자리","감각의 질감","떠오르는 장면"
	];
	var isDiscovery = discoveryPassages.indexOf(passage()) !== -1;
	var isFirstEntry = passage() === "첫 진입";
	var isSecondQuestion = passage() === "마음의 시야";
	var isHub = passage() === "관측소 허브";
	var fogRoomPassages = [
		"안개 진입","안개가 마련한 것","안개가 정한 거리",
		"안개 이름 역할","안개 이름 이미지","안개 이름 제안","안개 이름 확인",
		"안개 반응","안개의 이유","안개 속 기다림","안개 이름"
	];
	var isFogRoom = fogRoomPassages.indexOf(passage()) !== -1;
	var waveRoomPassages = [
		"파도 진입","파도 원하는 힘","파도 멈춤의 불안","파도 구별하기",
		"파도 보호 의도","파도 머무는 위치","파도 심연","파도 심연 조절",
		"파도가 막고 있는 것","파도의 허락","파도 깊이","파도 실루엣",
		"파도 거리","파도 수면","파도 반응","파도의 의도","파도 이름"
	];
	var isWaveRoom = waveRoomPassages.indexOf(passage()) !== -1;
	var namePassages = ["등대 이름","파도 이름","안개 이름","부분 이름"];
	var isRoomName = namePassages.indexOf(passage()) !== -1;
	var isAbout = false;
	var readingPassages = ["날씨 기록", "비상 복귀", "관측 종료"];
	var isReading = readingPassages.indexOf(passage()) !== -1;
	var isWeatherRecord = passage() === "날씨 기록";
	var isLighthouseRoom =
		State.variables.currentRoom === "lighthouse" &&
		State.variables.sceneMode === "lighthouse" &&
		!isHub &&
		!isReading;
	var abyssPassages = ["파도 심연", "파도 심연 조절"];
	var audioScene = isWeatherRecord ? "record" :
		(isFogRoom ? "fog" :
			(isWaveRoom
				? (abyssPassages.indexOf(passage()) !== -1 ? "abyss" : "wave")
				: (isLighthouseRoom ? "lighthouse" : "hub")));
	if (setup.audio) {
		setup.audio.setScene(audioScene);
		setup.audio.setWeather(State.variables.weatherState || {});
		if (audioScene === "abyss") {
			setup.audio.setAbyssState(
				State.variables.waveAbyssState ||
				(typeof setup.waveAbyssProfile === "function" ? setup.waveAbyssProfile() : {})
			);
		}
		setup.audio.setReadingActive(
			["등대 진입", "파도 진입", "안개 진입"].indexOf(passage()) === -1
		);
		if (passage() === "관측 종료") setup.audio.stopAll();
	}
	var isObservation = !isDiscovery && !isHub && !isReading;
	document.body.classList.toggle("discovery-entry", isDiscovery);
	document.body.classList.toggle("first-entry-screen", isFirstEntry);
	document.body.classList.toggle("second-question-screen", isSecondQuestion);
	document.body.classList.toggle("station-hub", isHub);
	document.body.classList.toggle("fog-room-screen", isFogRoom);
	document.body.classList.toggle("wave-room-screen", isWaveRoom);
	document.body.classList.toggle("lighthouse-room-screen", isLighthouseRoom);
	if (!isLighthouseRoom) {
		document.body.classList.remove(
			"lighthouse-arriving",
			"lighthouse-interior-ready",
			"lighthouse-question-ready"
		);
	}
	document.body.classList.toggle("room-name-screen", isRoomName);
	document.body.classList.toggle("about-page", isAbout);
	document.body.classList.toggle("reading-page", isReading);
	document.body.classList.toggle("weather-record-page", isWeatherRecord);
	document.body.classList.toggle("observation-ui", isObservation);
	var activePassage = document.querySelector("#passages .passage");
	var usesStoryPanel = !isFirstEntry && !isHub && !isReading && !isWaveRoom && !isFogRoom && !isLighthouseRoom;
	document.body.classList.toggle("story-panel-screen", usesStoryPanel);
	if (activePassage) {
		activePassage.classList.toggle("story-panel", usesStoryPanel);
		var questionHeadings = activePassage.querySelectorAll("h2");
		var questionHeading = questionHeadings.length
			? questionHeadings[questionHeadings.length - 1]
			: activePassage.querySelector("h1");
		if (questionHeading) questionHeading.classList.add("story-question");
		var hasFourChoices = false;
		Array.prototype.forEach.call(
			activePassage.querySelectorAll(".choices"),
			function (list) {
				list.classList.add("choice-list");
				Array.prototype.slice.call(list.classList).forEach(function (className) {
					if (/^choice-count-\d+$/.test(className)) {
						list.classList.remove(className);
					}
				});
				var choiceButtons = Array.prototype.filter.call(
					list.children,
					function (element) {
						return element.matches("a, button");
					}
				);
				list.classList.add("choice-count-" + choiceButtons.length);
				if (choiceButtons.length === 4) hasFourChoices = true;
				choiceButtons.forEach(function (element) {
					element.classList.add("choice-button");
				});
			}
		);
		activePassage.classList.toggle("has-four-choices", hasFourChoices);
	}
	var storyGradient = document.getElementById("story-gradient");
	if (usesStoryPanel && !storyGradient) {
		storyGradient = document.createElement("div");
		storyGradient.id = "story-gradient";
		storyGradient.className = "story-gradient";
		document.body.appendChild(storyGradient);
	} else if (!usesStoryPanel && storyGradient) {
		storyGradient.remove();
	}
	if (!isWaveRoom && typeof setup.waveScrollCleanup === "function") {
		setup.waveScrollCleanup();
		setup.waveScrollCleanup = null;
	}
	var aboutLink = document.getElementById("global-about");
	if (!aboutLink) {
		aboutLink = document.createElement("a");
		aboutLink.id = "global-about";
		aboutLink.href = "#";
		aboutLink.textContent = "관측소 안내서";
		aboutLink.addEventListener("click", function (event) {
			event.preventDefault();
			setup.openGuide();
		});
		document.body.appendChild(aboutLink);
	}
	var soundButton = document.getElementById("global-sound");
	if (!soundButton) {
		soundButton = document.createElement("button");
		soundButton.id = "global-sound";
		soundButton.type = "button";
		soundButton.addEventListener("click", function () {
			setup.audio.setMuted(!setup.audio.muted);
		});
		document.body.appendChild(soundButton);
	}
	setup.renderSoundControl();
	var exitLink = document.getElementById("global-exit");
	if (!isReading && !isLighthouseRoom && !exitLink) {
		exitLink = document.createElement("a");
		exitLink.id = "global-exit";
		exitLink.href = "#";
		exitLink.textContent = "나가기";
		exitLink.addEventListener("click", function (event) {
			event.preventDefault();
			if (setup.audio) setup.audio.stopAll();
			Engine.play("관측 종료");
		});
		document.body.appendChild(exitLink);
	} else if ((isReading || isLighthouseRoom) && exitLink) {
		exitLink.remove();
	}
	var lighthouseReturn = document.getElementById("lighthouse-room-return");
	if (isLighthouseRoom && !lighthouseReturn) {
		lighthouseReturn = document.createElement("a");
		lighthouseReturn.id = "lighthouse-room-return";
		lighthouseReturn.href = "#";
		lighthouseReturn.textContent = "관측소로 돌아가기";
		lighthouseReturn.addEventListener("click", function (event) {
			event.preventDefault();
			setup.exitLighthouseRoom();
		});
		document.body.appendChild(lighthouseReturn);
	} else if (!isLighthouseRoom && lighthouseReturn) {
		lighthouseReturn.remove();
	}
	if (["파도 진입","안개 진입","관측소 허브"].indexOf(passage()) !== -1) {
		setup.showRoomArrival(passage() === "파도 진입" ? 3600 : 2300);
		if (passage() !== "관측소 허브" && setup.audio) {
			setTimeout(function () {
				if (setup.audio) setup.audio.setReadingActive(true);
			}, passage() === "파도 진입" ? 3600 : 2300);
		}
	}
	if (passage() === "관측소 허브") {
		setTimeout(setup.renderHubUI, 0);
	}
	setTimeout(setup.ensureWeatherStation, 0);
});

if (!setup.audioInteractionBound) {
	setup.audioInteractionBound = true;
	document.addEventListener("click", function (event) {
		var target = event.target && event.target.closest
			? event.target.closest("#passages a, #passages button")
			: null;
		if (!target || target.id === "global-sound") return;
		if (target.closest("input, textarea, [contenteditable='true']")) return;
		if (setup.audio) setup.audio.playSfx("choice");
	});
	window.addEventListener("pagehide", function () {
		if (setup.audio) setup.audio.dispose();
	});
}



:: StoryCaption {"position":"300,100","size":"100,100"}
<div class="station-name">INNER WEATHER STATION</div>
<div class="station-ko">내면 기상 관측소</div>
<div class="station-status">
	<span>관측 단계</span>
	<strong id="stage">대기 중</strong>
</div>
<div class="station-data">
	<div><span>현재 기상</span><b id="weather-data">—</b></div>
	<div><span>관측 거리</span><b id="distance-data">—</b></div>
</div>
<div class="station-actions">
	<<link "관측 중단">><<goto "비상 복귀">><</link>>
	<<link "새 관측">><<run setup.audio.dispose(); Engine.restart()>><</link>>
</div>


:: ABOUT {"position":"500,100","size":"100,100"}
<<run setup.openGuide()>>
<p class="prompt">〈내면 기상 관측소 안내서〉가 관측소 위에 펼쳐졌습니다.</p>
<div class="choices"><<link "관측으로 돌아가기">><<goto $returnPassage>><</link>></div>

:: 첫 진입 {"position":"100,350","size":"120,100"}
<<set $sceneMode = "hub">><<set $currentRoom = "hub">>
<div class="intro-overlay">
<div class="intro-content">
<h1>내면 기상 관측소</h1>
<p>지금 내 마음의 날씨를 천천히 살펴봅니다.</p>
<<button "나의 날씨 관측하기">><<run setup.startAmbience()>><<goto "들어다보기">><</button>>
</div>
</div>


:: 들어다보기 {"position":"320,350","size":"140,100"}
<<set $stateBehaviorSelection = {id:"",label:""}>>
<<set $customBehavior = "">>
<<set $movementPressureReason = "">><<set $movementPressureCustom = "">>
<div class="intro-ui">
<h1>지금의 나와 가장 가까운 상태는 무엇인가요?</h1>
<p>여러 상태가 겹친다면, 지금 가장 크게 느껴지는 것을 골라주세요.</p>
<div class="choices story-choices">
[[생각과 감정이 한꺼번에 밀려와 벅차다->상태에서의 행동][$movementMode = "overwhelmed"; $stateSelection = {id:"overwhelmed",label:"생각과 감정이 한꺼번에 밀려와 벅차다"}; $movementSelection = $stateSelection; $weatherMode = "wave"]]
[[불안하고 긴장되어 마음을 놓기 어렵다->상태에서의 행동][$movementMode = "anxious"; $stateSelection = {id:"anxious",label:"불안하고 긴장되어 마음을 놓기 어렵다"}; $movementSelection = $stateSelection; $weatherMode = "watch"]]
[[기운이 없고 무겁게 가라앉아 있다->상태에서의 행동][$movementMode = "heavy"; $stateSelection = {id:"heavy",label:"기운이 없고 무겁게 가라앉아 있다"}; $movementSelection = $stateSelection; $weatherMode = "cloud"]]
[[기대되거나 들떠 에너지가 높다->상태에서의 행동][$movementMode = "energized"; $stateSelection = {id:"energized",label:"기대되거나 들떠 에너지가 높다"}; $movementSelection = $stateSelection; $weatherMode = "bright"]]
[[무엇을 느끼는지 잘 모르겠다->상태에서의 행동][$movementMode = "unclear"; $stateSelection = {id:"unclear",label:"무엇을 느끼는지 잘 모르겠다"}; $movementSelection = $stateSelection; $weatherMode = "fog"]]
[[지금은 비교적 편안하고 안정되어 있다->상태에서의 행동][$movementMode = "calm"; $stateSelection = {id:"calm",label:"지금은 비교적 편안하고 안정되어 있다"}; $movementSelection = $stateSelection; $weatherMode = "calm"]]
</div>
<div class="custom-choice-link">[[내 상태를 직접 적기->상태 직접 적기]]</div>
</div>


:: 상태 직접 적기 {"position":"320,520","size":"170,110"}
<div class="custom-input-panel">
<h2>지금의 상태를 내 말로 적어주세요.</h2>
<textarea id="discovery-custom-input" rows="4" maxlength="500" autofocus></textarea>
<div id="input-error"></div>
<div class="custom-input-actions">
<button id="discovery-input-back" type="button">돌아가기</button>
<button id="discovery-input-save" type="button" class="primary">이 문장을 남긴다</button>
</div>
</div>
<<run setTimeout(function(){ setup.bindDiscoveryInput("state"); },0)>>


:: 상태에서의 행동 {"position":"500,350","size":"170,110"}
<div class="room-input-stage">
<h1>그럴 때 나는 주로 어떻게 하나요?</h1>
<div class="choices">
[[그 느낌을 따라 바로 움직인다->마음의 시야][$stateBehaviorSelection = {id:"follow_energy",label:"그 느낌을 따라 바로 움직인다"}]]
[[주변 상황을 계속 살피고 대비한다->마음의 시야][$stateBehaviorSelection = {id:"keep_watch",label:"주변 상황을 계속 살피고 대비한다"}]]
[[다른 일에 몰두하거나 계속 움직인다->멈추기 어려운 감각][$stateBehaviorSelection = {id:"keep_moving",label:"다른 일에 몰두하거나 계속 움직인다"}]]
[[사람이나 상황에서 잠시 거리를 둔다->마음의 시야][$stateBehaviorSelection = {id:"make_distance",label:"사람이나 상황에서 잠시 거리를 둔다"}]]
[[멍해지거나 아무것도 하지 못한다->마음의 시야][$stateBehaviorSelection = {id:"shut_down",label:"멍해지거나 아무것도 하지 못한다"}]]
[[누군가에게 말하거나 함께 있으려 한다->마음의 시야][$stateBehaviorSelection = {id:"seek_company",label:"누군가에게 말하거나 함께 있으려 한다"}]]
[[아직 어떻게 하는지 잘 모르겠다->마음의 시야][$stateBehaviorSelection = {id:"unclear",label:"아직 어떻게 하는지 잘 모르겠다"}]]
</div>
<div class="custom-choice-link">[[내 행동을 직접 적기->행동 직접 적기]]</div>
</div>



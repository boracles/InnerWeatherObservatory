<<link "뜨겁거나 차가워진다">><<set $roomBody[$currentRoom] = "뜨겁거나 차가워짐">><<goto "부분을 바라보는 마음">><</link>>
<<link "비어 있거나 멀게 느껴진다">><<set $roomBody[$currentRoom] = "비어 있거나 멀게 느껴짐">><<goto "부분을 바라보는 마음">><</link>>
<<link "아직 잘 모르겠다">><<set $roomBody[$currentRoom] = "아직 알 수 없음">><<goto "부분을 바라보는 마음">><</link>>

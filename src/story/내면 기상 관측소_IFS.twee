<<link "이 상태가 끝나지 않을까 봐 걱정된다">><<set $roomSecondParts[$currentRoom] = "이 상태가 끝나지 않을까 봐 걱정하는 부분">><<goto "멈추면 걱정되는 일">><</link>>
<<link "해야 할 일을 못 하게 될까 봐 걱정된다">><<set $roomSecondParts[$currentRoom] = "해야 할 일을 못 하게 될까 봐 걱정하는 부분">><<goto "멈추면 걱정되는 일">><</link>>
<<link "감정이 더 커질까 봐 걱정된다">><<set $roomSecondParts[$currentRoom] = "감정이 더 커질까 봐 걱정하는 부분">><<goto "멈추면 걱정되는 일">><</link>>
<<link "다른 사람에게 드러날까 봐 걱정된다">><<set $roomSecondParts[$currentRoom] = "다른 사람에게 드러날까 봐 걱정하는 부분">><<goto "멈추면 걱정되는 일">><</link>>
<<link "무엇이 걱정되는지 아직 모르겠다">><<set $roomSecondParts[$currentRoom] = "아직 알 수 없음">><<goto "멈추면 걱정되는 일">><</link>>
</div>
<div class="room-input-aux">
<<button "내 말로 직접 적기">><<run setup.openRoomInput($currentRoom,"secondWords","이 움직임을 힘들어하는 마음이 걱정하는 것을 적어주세요.",{groupVariable:"roomSecondParts",nextPassage:"멈추면 걱정되는 일"})>><</button>>
</div>
</div>
<div class="custom-input-host"></div>


:: 멈추면 걱정되는 일 {"position":"2600,320","size":"180,120"}

<<link "예상하지 못한 일이 생길 것 같다">><<set $roomWorries[$currentRoom] = "예상하지 못한 일이 생길 것 같음">><<goto "지키려는 것">><</link>>
<<link "감당하기 어려운 감정이 한꺼번에 올라올 것 같다">><<set $roomWorries[$currentRoom] = "감당하기 어려운 감정이 한꺼번에 올라올 것 같음">><<goto "지키려는 것">><</link>>
<<link "누군가 실망하거나 나를 탓할 것 같다">><<set $roomWorries[$currentRoom] = "누군가 실망하거나 나를 탓할 것 같음">><<goto "지키려는 것">><</link>>
<<link "상황을 통제할 수 없을 것 같다">><<set $roomWorries[$currentRoom] = "상황을 통제할 수 없을 것 같음">><<goto "지키려는 것">><</link>>
<<link "아직 무엇이 걱정되는지 모르겠다">><<set $roomWorries[$currentRoom] = "아직 알 수 없음">><<goto "지키려는 것">><</link>>
</div>
<div class="room-input-aux">
<<button "내 말로 직접 적기">><<run setup.openRoomInput($currentRoom,"worryWords","이 부분이 하던 일을 늦추면 어떤 일이 생길 것 같나요?",{groupVariable:"roomWorries",nextPassage:"지키려는 것"})>><</button>>
</div>
</div>
